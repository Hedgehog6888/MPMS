<UserControl x:Class="MPMS.Views.Pages.FilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MPMS.Controls"
             xmlns:components="clr-namespace:MPMS.Views.Components"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Transparent" Padding="24,16,24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Файлы" FontSize="24" FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding FilesControlVM.ImagesCount, StringFormat='Изображений: {0}'}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilesControlVM.CurrentTab}" Value="Documents">
                                        <Setter Property="Text" Value="{Binding FilesControlVM.DocumentsCount, StringFormat='Документов: {0}'}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Выбрать"
                            Command="{Binding FilesControlVM.EnterSelectionModeCommand}"
                            Height="38" Padding="18,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlineBtn}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilesControlVM.IsSelectionMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="CreateReportBtn" Click="CreateReport_Click"
                            Height="38" Padding="18,0" Margin="8,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlineBtn}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilesControlVM.IsSelectionMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{svgc:SvgImage Source=/icons/file_black.svg, AppName=MPMS}"
                                   Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Создать отчёт" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Popup x:Name="ReportPopup"
                           PlacementTarget="{Binding ElementName=CreateReportBtn}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           StaysOpen="False"
                           Width="200">
                        <Border Background="White" CornerRadius="8"
                                BorderBrush="#DFE1E6" BorderThickness="1"
                                Margin="0,4,0,0">
                            <StackPanel Margin="4">
                                <Border Background="Transparent" CornerRadius="6"
                                        Padding="12,10" Cursor="Hand"
                                        MouseLeftButtonDown="MaterialStockReport_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F4F5F7"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="По складу" FontSize="13" Foreground="#111111" Background="Transparent"/>
                                </Border>
                                <Border Background="Transparent" CornerRadius="6"
                                        Padding="12,10" Cursor="Hand"
                                        MouseLeftButtonDown="WorkTypeReport_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F4F5F7"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="По видам работы" FontSize="13" Foreground="#111111" Background="Transparent"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Button Click="UploadFile_Click" Height="38" Padding="18,0" Margin="8,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BlackBtn}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilesControlVM.IsSelectionMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{svgc:SvgImage Source=/icons/upload_white.svg, AppName=MPMS}" 
                                   Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Загрузить изображение"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FilesControlVM.CurrentTab}" Value="Documents">
                                                <Setter Property="Text" Value="Загрузить документ"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Content="Отменить"
                            Command="{Binding FilesControlVM.CancelSelectionModeCommand}"
                            Height="38" Padding="18,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlineBtn}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilesControlVM.IsSelectionMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Удалить"
                            Command="{Binding FilesControlVM.SelectionDeleteCommand}"
                            Height="38" Padding="18,0" Margin="8,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlineBtn}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilesControlVM.IsSelectionMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Скачать"
                            Command="{Binding FilesControlVM.SelectionDownloadCommand}"
                            Height="38" Padding="18,0" Margin="8,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlineBtn}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilesControlVM.IsSelectionMode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="Transparent" Padding="24,12,24,0">
            <components:FilesControl DataContext="{Binding FilesControlVM}"
                                       LayoutMode="TabsOnly"/>
        </Border>

        <Grid Grid.Row="2" Margin="24,12,0,24" ClipToBounds="True">
            <components:FilesControl DataContext="{Binding FilesControlVM}"
                                       LayoutMode="ScrollOnly"/>
        </Grid>

        <controls:DragDropOverlay Grid.RowSpan="3"
                                  UploadCommand="{Binding FilesControlVM.ProcessFilesCommand}"
                                  Panel.ZIndex="100">
            <controls:DragDropOverlay.Style>
                <Style TargetType="controls:DragDropOverlay">
                    <Setter Property="IsDragDropEnabled" Value="True"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding FilesControlVM.IsSelectionMode}" Value="True">
                            <Setter Property="IsDragDropEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:DragDropOverlay.Style>
        </controls:DragDropOverlay>

        <Border x:Name="ToastLayer" Panel.ZIndex="200" Grid.RowSpan="3"
                Background="Transparent" IsHitTestVisible="False"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border x:Name="Toast" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,61,24,0" Background="#000000" CornerRadius="8"
                    Padding="12,8" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="ToastText" Text="" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
            </Border>
        </Border>
    </Grid>
</UserControl>
