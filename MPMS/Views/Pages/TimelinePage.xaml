<UserControl x:Class="MPMS.Views.Pages.TimelinePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MPMS.Controls"
             xmlns:infra="clr-namespace:MPMS.Infrastructure"
             xmlns:vm="clr-namespace:MPMS.ViewModels"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/">

    <UserControl.Resources>
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Width"           Value="30"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="TimelineSkeletonRowTemplate">
            <Border Padding="20,10,20,10" Background="White" Opacity="0.72">
                <Grid Height="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,20,0" VerticalAlignment="Center">
                        <Border Height="10" Width="128" CornerRadius="5" Background="#E2E8F0" HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border Height="16" Width="74" CornerRadius="6" Background="#EEF2F7"/>
                            <Border Height="14" Width="54" CornerRadius="5" Background="#F1F5F9" Margin="8,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Column="1">
                        <ItemsControl ItemsSource="{Binding DataContext.DayHeaders,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      IsHitTestVisible="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F8FAFC" BorderThickness="0,0,1,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.06*"/>
                                <ColumnDefinition Width="0.82*"/>
                                <ColumnDefinition Width="0.12*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="1" Height="24" CornerRadius="6" Margin="2,0"
                                    Background="#EEF2F7"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── PAGE HEADER (title left, nav+today right — same pattern as Calendar) ── -->
        <Border Grid.Row="0" Background="Transparent" Padding="24,16,24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Таймлайн" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Временная шкала задач и этапов проекта"
                               FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- "Сегодня" + month nav + help — same layout as Calendar header -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Height="30" Padding="14,0" Margin="0,0,10,0"
                            Command="{Binding GoToTodayCommand}" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="White" CornerRadius="6"
                                        BorderBrush="#E2E8F0" BorderThickness="1"
                                        Padding="{TemplateBinding Padding}">
                                    <TextBlock Text="Сегодня" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#0F172A" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#F1F5F9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Border Background="White" CornerRadius="8"
                            BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource NavBtn}"
                                    Command="{Binding PreviousMonthCommand}">
                                <Path Data="M7,2 L2,8 L7,14" Stroke="#475569" StrokeThickness="2"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Stretch="None"/>
                            </Button>
                            <TextBlock Text="{Binding MonthTitle}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="#0F172A" VerticalAlignment="Center"
                                       MinWidth="165" TextAlignment="Center"/>
                            <Button Style="{StaticResource NavBtn}"
                                    Command="{Binding NextMonthCommand}">
                                <Path Data="M2,2 L7,8 L2,14" Stroke="#475569" StrokeThickness="2"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Stretch="None"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Button Width="32" Height="32" Margin="10,0,0,0" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" ToolTip="Справка по цветам таймлайна"
                            Click="Help_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                        CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#F4F5F7"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#E8E9EC"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Image Source="{svgc:SvgImage Source=/icons/activity_help.svg, AppName=MPMS}" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── TABS ROW ─────────────────────────────────────────────── -->
        <Border Grid.Row="1" Background="Transparent" Padding="16,0">
            <controls:TabBarControl x:Name="TimelineTabBar"
                                    GroupName="TimelineTabs"
                                    SelectedTabChanged="TimelineTab_SelectedTabChanged">
                <controls:TabItemModel Text="Задачи" Tag="Tasks"/>
                <controls:TabItemModel Text="Этапы"  Tag="Stages"/>
            </controls:TabBarControl>
        </Border>

        <!-- ── TIMELINE BODY ────────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="White" Margin="16,8,16,16"
                CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1"
                ClipToBounds="True">
            <Grid>

                <!-- ── TASKS SECTION ──────────────────────────────── -->
                <Grid x:Name="TasksSection">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Modern header with subtle background -->
                    <Border Grid.Row="0" Background="#F8FAFC"
                            Padding="20,16,20,12"
                            CornerRadius="12,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Padding="16,4">
                                <TextBlock Text="Задача" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#64748B"/>
                            </Border>
                            <ItemsControl x:Name="TasksDayHeaderItems" Grid.Column="1" ItemsSource="{Binding DayHeaders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TimelineDayHeader}">
                                        <Border Padding="0,6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter Property="Background" Value="#FEF2F2"/>
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding DayNumber}"
                                                       TextAlignment="Center" FontSize="11"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- Task rows with modern card design -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="TimelineScrollViewer_ScrollChanged">
                        <StackPanel>
                            <ItemsControl x:Name="TaskRowsItemsControl" ItemsSource="{Binding TaskRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TimelineTaskRow}">
                                        <Border x:Name="RowBorder"
                                            Padding="20,10,20,10"
                                            Cursor="Hand" Tag="{Binding}"
                                            MouseLeftButtonDown="TaskRow_Click">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F8FAFC"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid MinHeight="40">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="280"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Task info (left) -->
                                            <Border Grid.Column="0" Padding="0,0,20,0"
                                                    ToolTip="{Binding Task.Name}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Task.Name}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="#0F172A"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <Border CornerRadius="6" Padding="6,3"
                                                                Background="{Binding StatusColor, Converter={StaticResource HexToBrush}}">
                                                            <TextBlock Text="{Binding StatusLabel}"
                                                                       FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="White"/>
                                                        </Border>
                                                        <Border CornerRadius="4" Padding="5,2" Margin="6,0,0,0"
                                                                Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1"
                                                                Visibility="{Binding IsOverdue, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Просрочен" FontSize="9" FontWeight="Bold"
                                                                       Foreground="#DC2626" HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- Timeline area (right) -->
                                            <Grid Grid.Column="1">
                                                <!-- Subtle day separators -->
                                                <ItemsControl ItemsSource="{Binding DataContext.DayHeaders,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              IsHitTestVisible="False">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Rows="1"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="#F1F5F9" BorderThickness="0,0,1,0"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Modern proportional bar -->
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding BarLeft,     Converter={StaticResource FracToGL}}"/>
                                                        <ColumnDefinition Width="{Binding BarWidth,    Converter={StaticResource FracToGL}}"/>
                                                        <ColumnDefinition Width="{Binding BarRemainder,Converter={StaticResource FracToGL}}"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="TaskBar"
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Height="32"
                                                            CornerRadius="6" Margin="2,0"
                                                            Opacity="0.85"
                                                            Visibility="{Binding HasBar, Converter={StaticResource BoolToVis}}"
                                                            Background="{Binding BarColorHex, Converter={StaticResource HexToBrush}}"
                                                            ToolTipService.Placement="Center"
                                                            ToolTipService.InitialShowDelay="0"
                                                            ToolTipService.ShowDuration="120000"
                                                            ToolTipService.BetweenShowDelay="0">
                                                        <Border.ToolTip>
                                                            <ToolTip Background="Transparent"
                                                                     BorderThickness="0"
                                                                     Padding="0">
                                                                <Border CornerRadius="6" Padding="10,6"
                                                                        Background="#E6000000"
                                                                        SnapsToDevicePixels="True">
                                                                    <TextBlock Text="{Binding BarRangeLabel}"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="White"/>
                                                                </Border>
                                                            </ToolTip>
                                                        </Border.ToolTip>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="RowBorder" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TaskBar" Property="Opacity" Value="1.0"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl x:Name="TaskFillerRows"
                                          ItemTemplate="{StaticResource TimelineSkeletonRowTemplate}"
                                          Visibility="Collapsed"
                                          ClipToBounds="True"
                                          IsHitTestVisible="False"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Empty state -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding TaskRows.Count, Converter={StaticResource NullToVisInv}}">
                        <TextBlock Text="Нет задач для отображения"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="#64748B" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- ── STAGES SECTION ─────────────────────────────── -->
                <Grid x:Name="StagesSection" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Modern header with subtle background -->
                    <Border Grid.Row="0" Background="#F8FAFC"
                            Padding="20,16,20,12"
                            CornerRadius="12,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="280"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Padding="16,4">
                                <TextBlock Text="Этап" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#64748B"/>
                            </Border>
                            <ItemsControl x:Name="StagesDayHeaderItems" Grid.Column="1" ItemsSource="{Binding DayHeaders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TimelineDayHeader}">
                                        <Border Padding="0,6">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter Property="Background" Value="#FEF2F2"/>
                                                            <Setter Property="CornerRadius" Value="4"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding DayNumber}"
                                                       TextAlignment="Center" FontSize="11"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- Stage rows with modern card design -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="TimelineScrollViewer_ScrollChanged">
                        <StackPanel>
                            <ItemsControl x:Name="StageRowsItemsControl" ItemsSource="{Binding StageRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TimelineStageRow}">
                                        <Border x:Name="StageRowBorder"
                                            Padding="20,10,20,10"
                                            Cursor="Hand" Tag="{Binding}"
                                            MouseLeftButtonDown="StageRow_Click">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F8FAFC"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid MinHeight="40">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="280"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Stage info (left) -->
                                            <Border Grid.Column="0" Padding="0,0,20,0"
                                                    ToolTip="{Binding Stage.Stage.Name}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Stage.Stage.Name}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="#0F172A"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <Border CornerRadius="6" Padding="6,3"
                                                                Background="{Binding StatusColor, Converter={StaticResource HexToBrush}}">
                                                            <TextBlock Text="{Binding StatusLabel}"
                                                                       FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="White"/>
                                                        </Border>
                                                        <Border CornerRadius="4" Padding="5,2" Margin="6,0,0,0"
                                                                Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1"
                                                                Visibility="{Binding IsOverdue, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Просрочен" FontSize="9" FontWeight="Bold"
                                                                       Foreground="#DC2626" HorizontalAlignment="Center"/>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- Timeline area (right) -->
                                            <Grid Grid.Column="1">
                                                <!-- Subtle day separators -->
                                                <ItemsControl ItemsSource="{Binding DataContext.DayHeaders,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              IsHitTestVisible="False">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Rows="1"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="#F1F5F9" BorderThickness="0,0,1,0"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Modern proportional bar -->
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding BarLeft,     Converter={StaticResource FracToGL}}"/>
                                                        <ColumnDefinition Width="{Binding BarWidth,    Converter={StaticResource FracToGL}}"/>
                                                        <ColumnDefinition Width="{Binding BarRemainder,Converter={StaticResource FracToGL}}"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="StageBar"
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Height="32"
                                                            CornerRadius="6" Margin="2,0"
                                                            Opacity="0.85"
                                                            Visibility="{Binding HasBar, Converter={StaticResource BoolToVis}}"
                                                            Background="{Binding BarColorHex, Converter={StaticResource HexToBrush}}"
                                                            ToolTipService.Placement="Center"
                                                            ToolTipService.InitialShowDelay="0"
                                                            ToolTipService.ShowDuration="120000"
                                                            ToolTipService.BetweenShowDelay="0">
                                                        <Border.ToolTip>
                                                            <ToolTip Background="Transparent"
                                                                     BorderThickness="0"
                                                                     Padding="0">
                                                                <Border CornerRadius="6" Padding="10,6"
                                                                        Background="#E6000000"
                                                                        SnapsToDevicePixels="True">
                                                                    <TextBlock Text="{Binding BarRangeLabel}"
                                                                               FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="White"/>
                                                                </Border>
                                                            </ToolTip>
                                                        </Border.ToolTip>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="StageRowBorder" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="StageBar" Property="Opacity" Value="1.0"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl x:Name="StageFillerRows"
                                          ItemTemplate="{StaticResource TimelineSkeletonRowTemplate}"
                                          Visibility="Collapsed"
                                          ClipToBounds="True"
                                          IsHitTestVisible="False"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Today line overlay – drawn in code-behind -->
                <Canvas x:Name="TodayLineCanvas"
                        IsHitTestVisible="False"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Panel.ZIndex="5"/>


            </Grid>
        </Border>
    </Grid>
</UserControl>
