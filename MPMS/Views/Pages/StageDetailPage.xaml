<UserControl x:Class="MPMS.Views.Pages.StageDetailPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MPMS.ViewModels"
             xmlns:models="clr-namespace:MPMS.Models"
             xmlns:components="clr-namespace:MPMS.Views.Components"
             xmlns:panels="clr-namespace:MPMS.Views.Components"
             xmlns:controls="clr-namespace:MPMS.Controls"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#DFE1E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="PickerRowBorder" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#F0F0F0"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8F9FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Transparent" Padding="24,16,24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding StageName}" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Border CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{Binding StageStatus, Converter={StaticResource StageStatusToBrush}}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStageMarkedForDeletion}" Value="True">
                                            <Setter Property="Background" Value="#EF4444"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding StageStatus, Converter={StaticResource StageStatusToString}}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStageMarkedForDeletion}" Value="True">
                                                <Setter Property="Text" Value="Пометка удаления"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <Border CornerRadius="4" Padding="6,2" Margin="12,0,0,0"
                                Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsOverdue, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Просрочено" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#DC2626"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="EditCatalogBtn"
                            Command="{Binding ToggleCatalogEditModeCommand}"
                            Content="{Binding CatalogEditButtonText}"
                            Style="{StaticResource OutlineBtn}"
                            Height="38" Padding="18,0" FontSize="13"
                            Visibility="{Binding ShowCatalogEditButton, Converter={StaticResource BoolToVis}}"/>
                    <Button x:Name="CreateReportBtn"
                            Click="CreateReport_Click"
                            Height="38" Padding="18,0" FontSize="13" Margin="8,0,0,0"
                            Visibility="{Binding ShowStageReportButton, Converter={StaticResource BoolToVis}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="White" BorderBrush="#DFE1E6" BorderThickness="1" CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="{svgc:SvgImage Source=/icons/file_black.svg, AppName=MPMS}"
                                               Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Создать отчёт" Foreground="#000000" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#F8F9FA"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Popup x:Name="ReportPopup"
                           PlacementTarget="{Binding ElementName=CreateReportBtn}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           StaysOpen="False"
                           Width="200">
                        <Border Background="White" CornerRadius="8"
                                BorderBrush="#DFE1E6" BorderThickness="1"
                                Margin="0,4,0,0">
                            <StackPanel Margin="4">
                                <Border Background="Transparent" CornerRadius="6"
                                        Padding="12,10" Cursor="Hand"
                                        MouseLeftButtonDown="StageReport_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#F4F5F7"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="По этапу" FontSize="13" Foreground="#111111" Background="Transparent"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Button x:Name="AddFileBtn"
                            Click="AddFile_Click"
                            Height="38" Padding="18,0" FontSize="13" Margin="8,0,0,0"
                            Visibility="{Binding ShowStageUploadButton, Converter={StaticResource BoolToVis}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="Black" CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="{svgc:SvgImage Source=/icons/upload_white.svg, AppName=MPMS}"
                                               Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Opacity="0.9"/>
                                        <TextBlock Text="Загрузить файл" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#333"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="Transparent" Padding="24,4,24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Назад" Style="{StaticResource BackButton}"
                        Command="{Binding GoBackCommand}" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Background="White" BorderBrush="#DFE1E6" BorderThickness="1" CornerRadius="8" Padding="6,4" HorizontalAlignment="Left" Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Общая информация" Tag="Main" GroupName="StageEditTabs"
                                     IsChecked="{Binding ActiveTab, Converter={StaticResource EqualityToBool}, ConverterParameter=Main}"
                                     Style="{StaticResource TabButton}" Click="StageTab_Click"/>
                        <RadioButton Content="Виды работ" Tag="Services" GroupName="StageEditTabs"
                                     IsChecked="{Binding ActiveTab, Converter={StaticResource EqualityToBool}, ConverterParameter=Services}"
                                     Style="{StaticResource TabButton}" Click="StageTab_Click"/>
                        <RadioButton Content="Материалы" Tag="Materials" GroupName="StageEditTabs"
                                     IsChecked="{Binding ActiveTab, Converter={StaticResource EqualityToBool}, ConverterParameter=Materials}"
                                     Style="{StaticResource TabButton}" Click="StageTab_Click"/>
                        <RadioButton Content="Оборудование" Tag="Equipment" GroupName="StageEditTabs"
                                     IsChecked="{Binding ActiveTab, Converter={StaticResource EqualityToBool}, ConverterParameter=Equipment}"
                                     Style="{StaticResource TabButton}" Click="StageTab_Click"/>
                        <RadioButton Content="Файлы" Tag="Files" GroupName="StageEditTabs"
                                     IsChecked="{Binding ActiveTab, Converter={StaticResource EqualityToBool}, ConverterParameter=Files}"
                                     Style="{StaticResource TabButton}" Click="StageTab_Click"/>
                        <RadioButton Content="Обсуждение" Tag="Discussion" GroupName="StageEditTabs"
                                     IsChecked="{Binding ActiveTab, Converter={StaticResource EqualityToBool}, ConverterParameter=Discussion}"
                                     Style="{StaticResource TabButton}" Click="StageTab_Click"/>
                        <RadioButton Content="Сводка" Tag="Summary" GroupName="StageEditTabs"
                                     IsChecked="{Binding ActiveTab, Converter={StaticResource EqualityToBool}, ConverterParameter=Summary}"
                                     Style="{StaticResource TabButton}" Click="StageTab_Click"
                                     Visibility="{Binding ShowSummaryTab, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <ScrollViewer Visibility="{Binding ActiveTab, Converter={StaticResource EqualityToVis}, ConverterParameter=Main}" VerticalScrollBarVisibility="Auto">
                <Grid Margin="24,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="490"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Grid.Row="0" Background="White" CornerRadius="8"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Информация об этапе" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                                        <Image Source="{svgc:SvgImage Source=/icons/project.svg, AppName=MPMS}"
                                               Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Top" Opacity="0.5"/>
                                        <StackPanel>
                                            <TextBlock Text="Проект" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding ProjectNameReadOnly}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                                        <Image Source="{svgc:SvgImage Source=/icons/list.svg, AppName=MPMS}"
                                               Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Top" Opacity="0.5"/>
                                        <StackPanel>
                                            <TextBlock Text="Задача" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding ContextSubtitle}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                                        <Image Source="{svgc:SvgImage Source=/icons/calendar.svg, AppName=MPMS}"
                                               Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Top" Opacity="0.5"/>
                                        <StackPanel>
                                            <TextBlock Text="Срок выполнения" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding DueDate, StringFormat=dd.MM.yyyy}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                                        <Image Source="{svgc:SvgImage Source=/icons/stage_description.svg, AppName=MPMS}"
                                               Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Top" Opacity="0.5"/>
                                        <StackPanel>
                                            <TextBlock Text="Описание" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Width="4" Height="14" CornerRadius="2" Background="#111111" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="РАБОТНИКИ" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding WorkerMembers}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,6">
                                                        <Button Style="{StaticResource PeekRowButton}" Margin="0"
                                                                Click="WorkerPeek_Click">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Style="{StaticResource AvatarCircle32}"
                                                                        Background="{Binding AvatarBrush}"
                                                                        Margin="0,0,10,0">
                                                                    <Grid>
                                                                        <Image Style="{StaticResource AvatarImage}"
                                                                               Source="{Binding AvatarData, Converter={StaticResource AvatarBytesToImage}}"
                                                                               Width="32" Height="32"
                                                                               Visibility="{Binding AvatarData, Converter={StaticResource NullToVis}}"/>
                                                                        <TextBlock Text="{Binding Initials}"
                                                                                   FontSize="10" FontWeight="Bold"
                                                                                   Foreground="White"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   Visibility="{Binding AvatarData, Converter={StaticResource NullToVisInv}}"/>
                                                                    </Grid>
                                                                </Border>
                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontSize="13" FontWeight="SemiBold"
                                                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                    <TextBlock Text="{Binding RoleSubtitle}" FontSize="11"
                                                                               Foreground="{Binding RoleColor, Converter={StaticResource HexToBrush}}"
                                                                               Margin="0,2,0,0">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding RoleSubtitle}" Value="">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Работники не назначены" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic"
                                                   Visibility="{Binding WorkerMembers.Count, Converter={StaticResource IntToVisInv}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                            <Border Grid.Row="1"
                                    Background="#F8FAFC"
                                    BorderBrush="#EBEEF2"
                                    BorderThickness="0,1,0,0"
                                    CornerRadius="0,0,8,8"
                                    Padding="16,14,16,16"
                                    Visibility="{Binding ShowSummaryTab, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <StackPanel Margin="0,0,0,10">
                                                <Grid Margin="0,0,0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="8" Height="8" CornerRadius="4" Background="#3B82F6"
                                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="1" Text="Виды работ" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding AdjustedServicesTotal, StringFormat='{}{0:N2} ₽'}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="#111111" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock Text="{Binding ServiceAdjustmentLabel}" FontSize="11"
                                                           Foreground="{Binding ServiceAdjustmentTone, Converter={StaticResource HexToBrush}}"
                                                           Margin="16,0,0,0"/>
                                            </StackPanel>

                                            <StackPanel Margin="0,0,0,12">
                                                <Grid Margin="0,0,0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="8" Height="8" CornerRadius="4" Background="#10B981"
                                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Grid.Column="1" Text="Материалы" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding AdjustedMaterialsTotal, StringFormat='{}{0:N2} ₽'}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="#111111" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock Text="{Binding MaterialAdjustmentLabel}" FontSize="11"
                                                           Foreground="{Binding MaterialAdjustmentTone, Converter={StaticResource HexToBrush}}"
                                                           Margin="16,0,0,0"/>
                                            </StackPanel>

                                            <Border Background="White" CornerRadius="8" Padding="12,10"
                                                    BorderBrush="#DFE1E6" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Итого по этапу" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding AdjustedGrandTotal, StringFormat='{}{0:N2} ₽'}"
                                                               FontSize="20" FontWeight="Bold"
                                                               Foreground="#111111"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="2" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="20"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Статистика этапа" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#111111" Margin="0,0,0,4"/>
                                <TextBlock Text="Распределение бюджета"
                                           FontSize="12" Foreground="#64748B" Margin="0,0,0,16"/>

                                <StackPanel Margin="0,0,0,16">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Виды работ" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ServicesCount, StringFormat='{}{0} поз.'}"
                                                   FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <ProgressBar Value="{Binding AdjustedServicesTotal, Mode=OneWay}" Maximum="{Binding ProgressMaximum, Mode=OneWay}" Height="8"
                                                     Background="#E9ECEF" Foreground="#3B82F6">
                                            <ProgressBar.Template>
                                                <ControlTemplate TargetType="ProgressBar">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                        <Border x:Name="PART_Track" CornerRadius="4">
                                                            <Border x:Name="PART_Indicator"
                                                                    Background="{TemplateBinding Foreground}"
                                                                    HorizontalAlignment="Left" CornerRadius="4"/>
                                                        </Border>
                                                    </Border>
                                                </ControlTemplate>
                                            </ProgressBar.Template>
                                        </ProgressBar>
                                    </Grid>
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Без наценки и скидки" FontSize="11"
                                                   Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SummaryServicesTotal, StringFormat='{}{0:N0} ₽'}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="#111111"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,4"
                                          Visibility="{Binding HasServiceAdjustment, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ServiceAdjustmentLabel}" FontSize="11"
                                                   Foreground="{Binding ServiceAdjustmentTone, Converter={StaticResource HexToBrush}}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding AdjustedServicesTotal, StringFormat='{}{0:N0} ₽'}"
                                                   FontSize="13" FontWeight="SemiBold" Foreground="#111111"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{Binding AverageServicePrice, StringFormat='Средняя цена: {0:N2} ₽/ед.'}"
                                               FontSize="10" Foreground="#94A3B8"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,16">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Материалы" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding MaterialsCount, StringFormat='{}{0} поз.'}"
                                                   FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <ProgressBar Value="{Binding AdjustedMaterialsTotal, Mode=OneWay}" Maximum="{Binding ProgressMaximum, Mode=OneWay}" Height="8"
                                                     Background="#E9ECEF" Foreground="#10B981">
                                            <ProgressBar.Template>
                                                <ControlTemplate TargetType="ProgressBar">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                        <Border x:Name="PART_Track" CornerRadius="4">
                                                            <Border x:Name="PART_Indicator"
                                                                    Background="{TemplateBinding Foreground}"
                                                                    HorizontalAlignment="Left" CornerRadius="4"/>
                                                        </Border>
                                                    </Border>
                                                </ControlTemplate>
                                            </ProgressBar.Template>
                                        </ProgressBar>
                                    </Grid>
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Без наценки и скидки" FontSize="11"
                                                   Foreground="#64748B" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SummaryMaterialsTotal, StringFormat='{}{0:N0} ₽'}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="#111111"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,4"
                                          Visibility="{Binding HasMaterialAdjustment, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding MaterialAdjustmentLabel}" FontSize="11"
                                                   Foreground="{Binding MaterialAdjustmentTone, Converter={StaticResource HexToBrush}}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding AdjustedMaterialsTotal, StringFormat='{}{0:N0} ₽'}"
                                                   FontSize="13" FontWeight="SemiBold" Foreground="#111111"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{Binding AverageMaterialPrice, StringFormat='Средняя цена: {0:N2} ₽/ед.'}"
                                               FontSize="10" Foreground="#94A3B8"/>
                                </StackPanel>

                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" VerticalAlignment="Top">
                            <panels:StageManagementPanel x:Name="StageManagementPanel" Margin="0"/>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource EqualityToVis}, ConverterParameter=Services}" Margin="24,8,24,16">
                <components:StageWorkTypesControl/>
            </Grid>

            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource EqualityToVis}, ConverterParameter=Materials}" Margin="24,8,24,16">
                <components:StageMaterialsControl/>
            </Grid>

            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource EqualityToVis}, ConverterParameter=Equipment}" Margin="24,8,24,16">
                <components:StageEquipmentControl/>
            </Grid>

            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource EqualityToVis}, ConverterParameter=Files}" Margin="24,8,24,16">
                <components:FilesControl DataContext="{Binding FilesControlVM}"/>
            </Grid>

            <Grid Visibility="{Binding ActiveTab, Converter={StaticResource EqualityToVis}, ConverterParameter=Discussion}" Margin="24,8,24,16">
                <Border Background="White" CornerRadius="8"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <components:DiscussionPanelControl x:Name="StageDiscussionControl"
                                                       ItemsSource="{Binding Messages}"
                                                       IsClosed="{Binding IsProjectClosed}"/>
                </Border>
            </Grid>

            <Grid Margin="24,8,24,16">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ActiveTab}" Value="Summary"/>
                                    <Condition Binding="{Binding ShowSummaryTab}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <components:StageSummaryControl/>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Panel.ZIndex="20" VerticalAlignment="Bottom" HorizontalAlignment="Center" MaxWidth="760" MinWidth="320" Margin="24,0,24,12"
                Background="#FFF0F0" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="12,8"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"/>
        </Border>

        <controls:DragDropOverlay Grid.RowSpan="3"
                                  UploadCommand="{Binding FilesControlVM.ProcessFilesCommand}"
                                  IsDragDropEnabled="{Binding CanUploadStageFiles}"
                                  Panel.ZIndex="9999"/>
    </Grid>
</UserControl>
