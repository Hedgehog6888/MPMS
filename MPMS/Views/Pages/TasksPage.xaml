<UserControl x:Class="MPMS.Views.Pages.TasksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             xmlns:controls="clr-namespace:MPMS.Controls"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="TaskRow" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <ControlTemplate x:Key="SlimPB" TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="2">
                <Border x:Name="PART_Track" CornerRadius="2">
                    <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                            HorizontalAlignment="Left" CornerRadius="2"/>
                </Border>
            </Border>
        </ControlTemplate>

        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> 
            <RowDefinition Height="*"/>   
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Transparent" Padding="24,16,24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Задачи" FontSize="24" FontWeight="Bold" Foreground="#111111"/>
                    <TextBlock Text="{Binding Tasks.Count, StringFormat='Задач: {0}'}"
                               FontSize="13" Foreground="#64748B" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">

                    <Button x:Name="CreateTaskBtn" Click="CreateTask_Click" Height="38" Padding="18,0"
                            FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="#111111" CornerRadius="6"
                                        Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{svgc:SvgImage Source=/icons/plus.svg, AppName=MPMS}"
                                               Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Создать задачу" Foreground="White"
                                                   VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#333333"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,12,0,24" ClipToBounds="True">
            <ScrollViewer x:Name="MainListScroll"
                          VerticalScrollBarVisibility="Visible"
                          Padding="0,62,24,0"
                          Background="Transparent"
                          Panel.ZIndex="0">
                <StackPanel>

                    <ItemsControl ItemsSource="{Binding TaskGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel ClipToBounds="False">

                                    <Button Margin="0,10,0,6" VerticalAlignment="Center"
                                            Click="ProjectHeader_Click"
                                            Cursor="Hand"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            ClipToBounds="False">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Border" Background="{TemplateBinding Background}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    Padding="{TemplateBinding Padding}"
                                                                    ClipToBounds="False"
                                                                    CornerRadius="4">
                                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Trigger.EnterActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <ColorAnimation Storyboard.TargetName="Border"
                                                                                              Storyboard.TargetProperty="Background.Color"
                                                                                              To="#F1F5F9" Duration="0:0:0.25"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </Trigger.EnterActions>
                                                                    <Trigger.ExitActions>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <ColorAnimation Storyboard.TargetName="Border"
                                                                                              Storyboard.TargetProperty="Background.Color"
                                                                                              To="Transparent" Duration="0:0:0.25"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </Trigger.ExitActions>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                        <Grid ClipToBounds="False">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*" MinWidth="0"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="3" CornerRadius="1.5" Background="#111111"
                                                    VerticalAlignment="Center" Margin="0,0,10,0" Height="14"/>
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="10"
                                                       Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,6,0"
                                                       Text="Проект"/>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12"
                                                       FontWeight="SemiBold" Foreground="#111111"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding ProjectName, Mode=OneWay}"/>

                                            <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11"
                                                       Foreground="#64748B" Margin="8,0,8,0">
                                                <Run Text="{Binding TaskCount, Mode=OneWay}"/>
                                                <Run Text="{Binding TaskCount, Converter={StaticResource PluralTaskConverter}, Mode=OneWay}"/>
                                            </TextBlock>

                                            <Grid Grid.Column="4" Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0,8,0">
                                                <Path Data="M 0 0 L 4 4 L 0 8" Stroke="#64748B" StrokeThickness="1.5" StrokeLineJoin="Round"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"/>
                                                <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#64748B" StrokeThickness="1.5" StrokeLineJoin="Round"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisInv}}"/>
                                            </Grid>
                                        </Grid>
                                    </Button>

                                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                        <Border Background="Transparent" Padding="15,8,15,8" Margin="0,0,0,4" Opacity="0.7"
                                                BorderThickness="1.5" BorderBrush="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4*" MinWidth="200"/>
                                                    <ColumnDefinition Width="2*" MinWidth="170"/>
                                                    <ColumnDefinition Width="*" MinWidth="125"/>
                                                    <ColumnDefinition Width="*" MinWidth="87"/>
                                                    <ColumnDefinition Width="*" MinWidth="92"/>
                                                    <ColumnDefinition Width="*" MinWidth="115"/>
                                                    <ColumnDefinition Width="*" MinWidth="67"/>
                                                    <ColumnDefinition Width="*" MinWidth="87"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="НАЗВАНИЕ"     Style="{StaticResource ColHeader}"/>
                                                <TextBlock Grid.Column="1" Text="ИСПОЛНИТЕЛЬ"  Style="{StaticResource ColHeader}"/>
                                                <TextBlock Grid.Column="2" Text="СТАТУС"       Style="{StaticResource ColHeader}" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="ПРИОРИТЕТ"    Style="{StaticResource ColHeader}"/>
                                                <TextBlock Grid.Column="4" Text="СРОК"         Style="{StaticResource ColHeader}"/>
                                                <TextBlock Grid.Column="5" Text="ПРОГРЕСС"     Style="{StaticResource ColHeader}"/>
                                                <TextBlock Grid.Column="6" Text="ЭТАПЫ"        Style="{StaticResource ColHeader}" Margin="12,0,0,0"/>
                                                <TextBlock Grid.Column="7" Text="ДЕЙСТВИЯ"     Style="{StaticResource ColHeader}"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding Tasks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                        <Border x:Name="TaskCardBorder" CornerRadius="8" Margin="0,0,0,6"
                                                Padding="15,10" BorderThickness="1.5"
                                                Cursor="Hand" MouseLeftButtonDown="Task_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="#DFE1E6"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EffectiveTaskMarkedForDeletion}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#EF4444"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="#111111"/>
                                                        </Trigger>
                                                        <EventTrigger RoutedEvent="Loaded">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     From="0" To="1" Duration="0:0:0.2"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4*" MinWidth="200"/>
                                                    <ColumnDefinition Width="2*" MinWidth="170"/>
                                                    <ColumnDefinition Width="*" MinWidth="125"/>
                                                    <ColumnDefinition Width="*" MinWidth="87"/>
                                                    <ColumnDefinition Width="*" MinWidth="92"/>
                                                    <ColumnDefinition Width="*" MinWidth="115"/>
                                                    <ColumnDefinition Width="*" MinWidth="67"/>
                                                    <ColumnDefinition Width="*" MinWidth="87"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                                            Margin="0,0,12,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="#111111"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>

                                                        <Border CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                                                Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1"
                                                                Visibility="{Binding IsOverdue, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Просрочено" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="#DC2626"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding TaskInheritedDeletionHint}"
                                                               FontSize="10" Foreground="#B71C1C" Margin="0,4,0,0"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding TaskInheritedDeletionHint, Converter={StaticResource StringToVis}}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                            VerticalAlignment="Center" Margin="0,0,8,0"
                                                            ToolTip="{Binding AssignedUserName}">
                                                    <Border Style="{StaticResource AvatarCircle26}"
                                                            Background="{StaticResource AvatarPlaceholderBrush}" Margin="0,0,6,0">
                                                        <Grid>
                                                            <Image Style="{StaticResource AvatarImage}"
                                                                   Source="{Binding AssignedUserAvatarData, Converter={StaticResource AvatarBytesToImage}}"
                                                                   Width="26" Height="26"
                                                                   Visibility="{Binding AssignedUserAvatarData, Converter={StaticResource NullToVis}}"/>
                                                            <TextBlock Text="{Binding AssignedUserInitials}" FontSize="9" FontWeight="Bold"
                                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding AssignedUserAvatarData, Converter={StaticResource NullToVisInv}}"/>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="{Binding AssignedUserName}"
                                                               FontSize="12" Foreground="#111111"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <Border Grid.Column="2"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="4" Padding="8,4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{Binding Status, Converter={StaticResource TaskStatusToBrush}}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EffectiveTaskMarkedForDeletion}" Value="True">
                                                                    <Setter Property="Background" Value="#EF4444"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Foreground="White"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding Status, Converter={StaticResource TaskStatusToString}}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EffectiveTaskMarkedForDeletion}" Value="True">
                                                                        <Setter Property="Text" Value="Пометка удаления"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <Border Grid.Column="3"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="4" Padding="8,3"
                                                        BorderThickness="1"
                                                        BorderBrush="{Binding Priority, Converter={StaticResource PriorityToBrush}}">
                                                    <TextBlock Text="{Binding Priority, Converter={StaticResource PriorityToString}}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding Priority, Converter={StaticResource PriorityToBrush}}"/>
                                                </Border>

                                                <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Image Source="{svgc:SvgImage Source=/icons/calendar.svg, AppName=MPMS}"
                                                           Width="14" Height="14" Margin="0,0,4,0"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.5"/>
                                                    <TextBlock Text="{Binding DueDate, Converter={StaticResource DateOnlyToString}}"
                                                               FontSize="12" Foreground="#111111"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                                                                 Maximum="100" Height="6"
                                                                 Background="#E9ECEF"
                                                                 Foreground="{Binding ProgressPercent, Converter={StaticResource ProgressPercentToBrush}}"
                                                                 Margin="0,0,0,4"
                                                                 Template="{StaticResource SlimPB}"/>
                                                    <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0}%'}"
                                                               FontSize="11" Foreground="#64748B"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="6"
                                                           Text="{Binding TotalStages, Converter={StaticResource StageCountToString}}"
                                                           FontSize="12" Foreground="#64748B"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0,0,0"/>

                                                <StackPanel Grid.Column="7" Orientation="Horizontal"
                                                            VerticalAlignment="Center" HorizontalAlignment="Right">

                                                    <Button ToolTip="Редактировать"
                                                            Tag="{Binding}" Click="EditTask_Click"
                                                            Margin="0,0,4,0">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                                <Setter Property="Visibility" Value="{Binding Converter={StaticResource RoleToVis}, ConverterParameter='Foreman,Project Manager,Administrator'}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EffectiveTaskMarkedForDeletion}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Image Source="{svgc:SvgImage Source=/icons/editing.svg, AppName=MPMS}"
                                                               Width="14" Height="14" VerticalAlignment="Center"/>
                                                    </Button>

                                                    <Button Tag="{Binding}" Click="MarkTask_Click"
                                                            Margin="0,0,4,0">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                                <Setter Property="Visibility" Value="{Binding Converter={StaticResource RoleToVis}, ConverterParameter='Project Manager,Administrator'}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanToggleTaskDeletionMark}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Button.ToolTip>
                                                            <ToolTip>
                                                                <TextBlock>
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="Пометить к удалению"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsMarkedForDeletion}" Value="True">
                                                                                    <Setter Property="Text" Value="Снять пометку удаления"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                        <Grid>
                                                            <Image Source="{svgc:SvgImage Source=/icons/markDelete.svg, AppName=MPMS}"
                                                                   Width="14" Height="14" VerticalAlignment="Center">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMarkedForDeletion}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                            <Image Width="14" Height="14" VerticalAlignment="Center">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Setter Property="Source" Value="{svgc:SvgImage Source=/icons/removeMarkDelete.svg, AppName=MPMS}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMarkedForDeletion}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding ElementName=TaskCardBorder, Path=IsMouseOver}" Value="True">
                                                                                <Setter Property="Source" Value="{svgc:SvgImage Source=/icons/removeMarkDelete_black.svg, AppName=MPMS}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                        </Grid>
                                                    </Button>

                                                    <Button Tag="{Binding}" Click="DeleteTask_Click"
                                                            Margin="0,0,4,0">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                                <Setter Property="Visibility" Value="{Binding Converter={StaticResource RoleToVis}, ConverterParameter='Project Manager,Administrator'}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMarkedForDeletion}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Image Width="14" Height="14" VerticalAlignment="Center">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="Source" Value="{svgc:SvgImage Source=/icons/trash.svg, AppName=MPMS}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding EffectiveTaskMarkedForDeletion}" Value="True">
                                                                            <Setter Property="Source" Value="{svgc:SvgImage Source=/icons/trash_red.svg, AppName=MPMS}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ElementName=TaskCardBorder, Path=IsMouseOver}" Value="True">
                                                                            <Setter Property="Source" Value="{svgc:SvgImage Source=/icons/trash.svg, AppName=MPMS}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                                    </StackPanel>
                        </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel HorizontalAlignment="Center" Margin="0,40,0,40"
                                Visibility="{Binding Tasks.Count, Converter={StaticResource IntToVisInv}}">
                        <Image Source="{svgc:SvgImage Source=/icons/tasks.svg, AppName=MPMS}"
                               Width="48" Height="48" Opacity="0.1" Margin="0,0,0,16"/>
                        <TextBlock Text="Задачи не найдены"
                                   FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Создайте первую задачу"
                                   FontSize="12" Foreground="#64748B" TextAlignment="Center"
                                   Margin="0,8,0,0" LineHeight="18"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <controls:SearchFilterBarControl
                VerticalAlignment="Top" Panel.ZIndex="1"
                HorizontalAlignment="Left"
                Width="{Binding ElementName=MainListScroll, Path=ViewportWidth}"
                IsFloating="True"
                ScrollTarget="{Binding ElementName=MainListScroll}"
                SearchText="{Binding SearchText, Mode=TwoWay}"
                Placeholder="Поиск по названию задачи или описанию...">
                <controls:SearchFilterBarControl.Filters>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding StatusOptions}"
                                  SelectedItem="{Binding StatusFilter}"
                                  Style="{StaticResource FormCombo}"
                                  Width="160" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding PriorityOptions}"
                                  SelectedItem="{Binding PriorityFilter}"
                                  Style="{StaticResource FormCombo}"
                                  Width="160" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding ProjectFilterOptions}"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectedValue="{Binding ProjectFilter}"
                                  Style="{StaticResource FormCombo}"
                                  Width="180"/>
                    </StackPanel>
                </controls:SearchFilterBarControl.Filters>
            </controls:SearchFilterBarControl>
        </Grid>
    </Grid>
</UserControl>
