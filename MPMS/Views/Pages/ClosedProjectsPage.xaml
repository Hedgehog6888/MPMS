<UserControl x:Class="MPMS.Views.Pages.ClosedProjectsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             xmlns:controls="clr-namespace:MPMS.Controls"
             xmlns:infra="clr-namespace:MPMS.Infrastructure"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <infra:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True"/>
        <infra:DateOnlyToDateTimeConverter x:Key="DateOnlyToDateTime"/>

        <ControlTemplate x:Key="SlimPB" TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="2">
                <Border x:Name="PART_Track" CornerRadius="2">
                    <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                            HorizontalAlignment="Left" CornerRadius="2"/>
                </Border>
            </Border>
        </ControlTemplate>

        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Transparent" Padding="24,16,24,8">
            <StackPanel>
                <TextBlock Text="Закрытые проекты" FontSize="24" FontWeight="Bold" Foreground="#111111"/>
                <TextBlock FontSize="13" Foreground="#64748B" Margin="0,3,0,0">
                    <Run Text="Проектов: "/>
                    <Run Text="{Binding Projects.Count, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24,12,0,24" ClipToBounds="True">
            <ScrollViewer x:Name="MainListScroll"
                          VerticalScrollBarVisibility="Visible"
                          Padding="0,62,24,0"
                          Background="Transparent"
                          Panel.ZIndex="0">
                <StackPanel>
                    <Border Background="Transparent" Padding="15,8,15,8" Margin="0,0,0,4" Opacity="0.7"
                            BorderThickness="1.5" BorderBrush="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4*" MinWidth="200"/>
                                <ColumnDefinition Width="2*" MinWidth="170"/>
                                <ColumnDefinition Width="*" MinWidth="125"/>
                                <ColumnDefinition Width="*" MinWidth="92"/>
                                <ColumnDefinition Width="*" MinWidth="115"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="НАЗВАНИЕ"     Style="{StaticResource ColHeader}"/>
                            <TextBlock Grid.Column="1" Text="ЗАКАЗЧИК"     Style="{StaticResource ColHeader}"/>
                            <TextBlock Grid.Column="2" Text="СТАТУС"       Style="{StaticResource ColHeader}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="ДАТА ЗАКРЫТИЯ" Style="{StaticResource ColHeader}"/>
                            <TextBlock Grid.Column="4" Text="ПРОГРЕСС"     Style="{StaticResource ColHeader}"/>
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Projects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Margin="0,0,0,6"
                                        Padding="15,10" BorderThickness="1.5"
                                        Cursor="Hand" MouseLeftButtonDown="ProjectRow_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#DFE1E6"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="#111111"/>
                                                </Trigger>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                             From="0" To="1" Duration="0:0:0.2"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4*" MinWidth="200"/>
                                            <ColumnDefinition Width="2*" MinWidth="170"/>
                                            <ColumnDefinition Width="*" MinWidth="125"/>
                                            <ColumnDefinition Width="*" MinWidth="92"/>
                                            <ColumnDefinition Width="*" MinWidth="115"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#111111"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Client, TargetNullValue='Без заказчика'}"
                                                   FontSize="12" Foreground="#111111"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <Border Grid.Column="2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                CornerRadius="4" Padding="8,4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{Binding Status, Converter={StaticResource ProjectStatusToBrush}}"/>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status, Converter={StaticResource ProjectStatusToString}}"
                                                       Foreground="White"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Image Source="{svgc:SvgImage Source=/icons/calendar.svg, AppName=MPMS}"
                                                   Width="14" Height="14" Margin="0,0,4,0"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.5"/>
                                            <TextBlock Text="{Binding ClosedAt, Converter={StaticResource DateTimeToString}}"
                                                       FontSize="12" Foreground="#111111"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                            <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                                                         Maximum="100" Height="6"
                                                         Background="#E9ECEF"
                                                         Foreground="{Binding ProgressPercent, Converter={StaticResource ProgressPercentToBrush}}"
                                                         Margin="0,0,0,4"
                                                         Template="{StaticResource SlimPB}"/>
                                            <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0}%'}"
                                                       FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel HorizontalAlignment="Center" Margin="0,40,0,40"
                                Visibility="{Binding Projects.Count, Converter={StaticResource BoolToVisInv}}">
                        <Image Source="{svgc:SvgImage Source=/icons/project.svg, AppName=MPMS}"
                               Width="48" Height="48" Opacity="0.1" Margin="0,0,0,16"/>
                        <TextBlock Text="Закрытые проекты не найдены"
                                   FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Здесь будут отображаться завершенные проекты"
                                   FontSize="12" Foreground="#64748B" TextAlignment="Center"
                                   Margin="0,8,0,0" LineHeight="18"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <controls:SearchFilterBarControl
                VerticalAlignment="Top" Panel.ZIndex="1"
                HorizontalAlignment="Stretch" Margin="0,0,24,0"
                IsFloating="True"
                ScrollTarget="{Binding ElementName=MainListScroll}"
                SearchText="{Binding SearchText, Mode=TwoWay}"
                Placeholder="Поиск по названию или заказчику...">
                <controls:SearchFilterBarControl.Filters>
                    <StackPanel Orientation="Horizontal">
                        <DatePicker SelectedDate="{Binding StartDateFilter, Mode=TwoWay, Converter={StaticResource DateOnlyToDateTime}}"
                                   Height="36" FontSize="12" Margin="0,0,8,0" Width="140"
                                   HorizontalContentAlignment="Center">
                            <DatePicker.Resources>
                                <Style TargetType="DatePickerTextBox">
                                    <Setter Property="Control.Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <TextBox Text="{Binding Text, RelativeSource={RelativeSource AncestorType=DatePicker}}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         BorderThickness="0" Background="Transparent"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DatePicker.Resources>
                        </DatePicker>
                        <TextBlock Text="—" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748B"/>
                        <DatePicker SelectedDate="{Binding EndDateFilter, Mode=TwoWay, Converter={StaticResource DateOnlyToDateTime}}"
                                   Height="36" FontSize="12" Width="140"
                                   HorizontalContentAlignment="Center">
                            <DatePicker.Resources>
                                <Style TargetType="DatePickerTextBox">
                                    <Setter Property="Control.Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <TextBox Text="{Binding Text, RelativeSource={RelativeSource AncestorType=DatePicker}}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         BorderThickness="0" Background="Transparent"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DatePicker.Resources>
                        </DatePicker>
                    </StackPanel>
                </controls:SearchFilterBarControl.Filters>
            </controls:SearchFilterBarControl>
        </Grid>
    </Grid>
</UserControl>
