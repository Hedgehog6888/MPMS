                                                 SelectionTextBrush="#000000"
                                                 GotFocus="LocalSearch_GotFocus"
                                                 LostFocus="LocalSearch_LostFocus"/>
                                    </Grid>
                                    <Button Grid.Column="2" Click="ClearTaskSearch_Click"
                                            Visibility="{Binding TaskSearchText, Converter={StaticResource StringToVis}}"
                                            Width="24" Height="24" Margin="0,0,0,0"
                                            Padding="0"
                                            Style="{StaticResource IconButton}">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11" Foreground="#6B778C"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding TaskStatusOptions}"
                                      SelectedItem="{Binding TaskStatusFilter}"
                                      Style="{StaticResource FormCombo}"
                                      Width="160" Margin="0,0,10,0"/>

                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding TaskPriorityOptions}"
                                      SelectedItem="{Binding TaskPriorityFilter}"
                                      Style="{StaticResource FormCombo}"
                                      Width="160"/>
                        </Grid>
                </Border>

                <Grid Grid.Row="0" Grid.RowSpan="2">
                    <ScrollViewer x:Name="TaskListPanel"
                                  VerticalScrollBarVisibility="Visible"
                                  Padding="24,68,24,16"
                                  Panel.ZIndex="0">
                        <StackPanel>
                            <Border Background="Transparent" Padding="15,8,15,8" Margin="0,0,0,2" Opacity="0.7"
                                    BorderThickness="1.5" BorderBrush="Transparent">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FilteredTasks.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4*" MinWidth="200"/>
                                        <ColumnDefinition Width="2*" MinWidth="170"/>
                                        <ColumnDefinition Width="*" MinWidth="125"/>
                                        <ColumnDefinition Width="*" MinWidth="87"/>
                                        <ColumnDefinition Width="*" MinWidth="92"/>
                                        <ColumnDefinition Width="*" MinWidth="115"/>
                                        <ColumnDefinition Width="*" MinWidth="67"/>
                                        <ColumnDefinition Width="*" MinWidth="87"/>
                                    </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="НАЗВАНИЕ" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,0,12,0"/>
                                            <TextBlock Grid.Column="1" Text="ИСПОЛНИТЕЛЬ" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="2" Text="СТАТУС" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="ПРИОРИТЕТ" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Column="4" Text="СРОК" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Column="5" Text="ПРОГРЕСС" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Column="6" Text="ЭТАПЫ" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="12,0,0,0"/>
                                            <TextBlock Grid.Column="7" Text="ДЕЙСТВИЯ" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Right"
                                                       Visibility="{Binding Project.IsClosed, Converter={StaticResource BoolToVisInv}}"/>
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding FilteredTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Margin="0,0,0,6"
                                                Padding="15,10" BorderThickness="1.5"
                                                Cursor="Hand" MouseLeftButtonDown="Task_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="#DFE1E6"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EffectiveTaskMarkedForDeletion}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#EF4444"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="#111111"/>
                                                        </Trigger>
                                                        <EventTrigger RoutedEvent="Loaded">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     From="0" To="1" Duration="0:0:0.2"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4*" MinWidth="200"/>
                                                    <ColumnDefinition Width="2*" MinWidth="170"/>
                                                    <ColumnDefinition Width="*" MinWidth="125"/>
                                                    <ColumnDefinition Width="*" MinWidth="87"/>
                                                    <ColumnDefinition Width="*" MinWidth="92"/>
                                                    <ColumnDefinition Width="*" MinWidth="115"/>
                                                    <ColumnDefinition Width="*" MinWidth="67"/>
                                                    <ColumnDefinition Width="*" MinWidth="87"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center"
                                                            Margin="0,0,12,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="#111111"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>

                                                        <Border CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                                                Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1"
                                                                Visibility="{Binding IsOverdue, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Просрочено" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="#DC2626"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding TaskInheritedDeletionHint}"
                                                               FontSize="10" Foreground="#B71C1C" Margin="0,4,0,0"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding TaskInheritedDeletionHint, Converter={StaticResource StringToVis}}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                            VerticalAlignment="Center" Margin="0,0,8,0"
                                                            ToolTip="{Binding AssignedUserName}">
                                                    <Border Style="{StaticResource AvatarCircle26}"
                                                            Background="{StaticResource AvatarPlaceholderBrush}" Margin="0,0,6,0">
                                                        <Grid>
                                                            <Image Style="{StaticResource AvatarImage}"
                                                                   Source="{Binding AssignedUserAvatarData, Converter={StaticResource AvatarBytesToImage}}"
                                                                   Width="26" Height="26"
                                                                   Visibility="{Binding AssignedUserAvatarData, Converter={StaticResource NullToVis}}"/>
                                                            <TextBlock Text="{Binding AssignedUserInitials}" FontSize="9" FontWeight="Bold"
                                                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding AssignedUserAvatarData, Converter={StaticResource NullToVisInv}}"/>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="{Binding AssignedUserName}"
                                                               FontSize="12" Foreground="#111111"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <Border Grid.Column="2"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="4" Padding="8,4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{Binding Status, Converter={StaticResource TaskStatusToBrush}}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding EffectiveTaskMarkedForDeletion}" Value="True">
                                                                    <Setter Property="Background" Value="#EF4444"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Foreground="White"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding Status, Converter={StaticResource TaskStatusToString}}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EffectiveTaskMarkedForDeletion}" Value="True">
                                                                        <Setter Property="Text" Value="Пометка удаления"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <Border Grid.Column="3"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="4" Padding="8,3"
                                                        BorderThickness="1"
                                                        BorderBrush="{Binding Priority, Converter={StaticResource PriorityToBrush}}">
                                                    <TextBlock Text="{Binding Priority, Converter={StaticResource PriorityToString}}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding Priority, Converter={StaticResource PriorityToBrush}}"/>
                                                </Border>

                                                <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Image Source="{svgc:SvgImage Source=/icons/calendar.svg, AppName=MPMS}"
                                                           Width="14" Height="14" Margin="0,0,4,0"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.5"/>
                                                    <TextBlock Text="{Binding DueDate, Converter={StaticResource DateOnlyToString}}"
                                                               FontSize="12" Foreground="#111111"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                                                                 Maximum="100" Height="6"
                                                                 Background="#E9ECEF"
                                                                 Foreground="{Binding ProgressPercent, Converter={StaticResource ProgressPercentToBrush}}"
                                                                 Margin="0,0,0,4"
                                                                 Template="{StaticResource SlimPB}"/>
                                                    <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0}%'}"
                                                               FontSize="11" Foreground="#64748B"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="6"
                                                           Text="{Binding TotalStages, Converter={StaticResource StageCountToString}}"
                                                           FontSize="12" Foreground="#64748B"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0,0,0"/>

                                                <StackPanel Grid.Column="7" Orientation="Horizontal"
                                                            VerticalAlignment="Center" HorizontalAlignment="Right"
                                                            Visibility="{Binding DataContext.Project.IsClosed, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisInv}}">

                                                    <Button ToolTip="Редактировать"
                                                            Tag="{Binding}" Click="EditTask_Click"
                                                            Margin="0,0,4,0">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                                <Setter Property="Visibility" Value="{Binding Converter={StaticResource RoleToVis}, ConverterParameter='Foreman,Project Manager,Administrator'}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EffectiveTaskMarkedForDeletion}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding DataContext.Project.IsClosed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Image Source="{svgc:SvgImage Source=/icons/editing.svg, AppName=MPMS}"
                                                               Width="14" Height="14" VerticalAlignment="Center"/>
                                                    </Button>

                                                    <Button Tag="{Binding}" Click="MarkTaskForDeletion_Click"
                                                            Margin="0,0,4,0">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                                <Setter Property="Visibility" Value="{Binding Converter={StaticResource RoleToVis}, ConverterParameter='Project Manager,Administrator'}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanToggleTaskDeletionMark}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding DataContext.Project.IsClosed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Button.ToolTip>
                                                            <ToolTip>
                                                                <TextBlock>
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="Пометить к удалению"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsMarkedForDeletion}" Value="True">
                                                                                    <Setter Property="Text" Value="Снять пометку удаления"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                        <Grid>
                                                            <Image Source="{svgc:SvgImage Source=/icons/markDelete.svg, AppName=MPMS}"
                                                                   Width="14" Height="14" VerticalAlignment="Center">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMarkedForDeletion}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                            <Image Source="{svgc:SvgImage Source=/icons/removeMarkDelete.svg, AppName=MPMS}"
                                                                   Width="14" Height="14" VerticalAlignment="Center">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMarkedForDeletion}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                        </Grid>
                                                    </Button>

                                                    <Button ToolTip="Удалить задачу"
                                                            Tag="{Binding}" Click="DeleteTask_Click">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource DangerIconButton}">
                                                                <Setter Property="Visibility" Value="{Binding Converter={StaticResource RoleToVis}, ConverterParameter='Project Manager,Administrator'}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataContext.Project.IsClosed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Image Width="14" Height="14" VerticalAlignment="Center">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="Source" Value="{svgc:SvgImage Source=/icons/trash.svg, AppName=MPMS}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding EffectiveTaskMarkedForDeletion}" Value="True">
                                                                            <Setter Property="Source" Value="{svgc:SvgImage Source=/icons/trash_red.svg, AppName=MPMS}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel HorizontalAlignment="Center" Margin="0,40,0,40"
                                        Visibility="{Binding FilteredTasks.Count, Converter={StaticResource IntToVisInv}}">
                                <Image Source="{svgc:SvgImage Source=/icons/tasks.svg, AppName=MPMS}"
                                       Width="48" Height="48" Opacity="0.1" Margin="0,0,0,16"/>
                                <TextBlock Text="Задачи не найдены"
                                           FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Создайте первую задачу для этого проекта"
                                           FontSize="12" Foreground="#64748B" TextAlignment="Center"
                                           Margin="0,8,0,0" LineHeight="18">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Project.IsClosed}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Grid x:Name="StagesPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Panel.ZIndex="1" Background="White" CornerRadius="8"
                        BorderBrush="#DFE1E6" BorderThickness="1"
                        Padding="16,10" Margin="24,8,32.5,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#F4F5F7" CornerRadius="6"
                                    Padding="10,0,2,0" Height="36" Margin="0,0,12,0"
                                    BorderThickness="1.5" BorderBrush="Transparent"
                                    VerticalAlignment="Center" HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE721;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14" VerticalAlignment="Center"
                                               Margin="0,0,8,0" Foreground="#6B778C"/>
                                    <Grid Grid.Column="1" Margin="0,0,4,0">
                                        <TextBlock Text="Поиск по этапу или задаче..."
                                                   Foreground="#6B778C" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StageSearchText}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StageSearchText}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox x:Name="StageSearchBox" Text="{Binding StageSearchText, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent" BorderThickness="0"
                                                 VerticalAlignment="Center" FontSize="13"
                                                 Foreground="#000000"
                                                 SelectionBrush="{StaticResource NeutralSelectionBrush}"
                                                 SelectionTextBrush="#000000"
                                                 GotFocus="LocalSearch_GotFocus"
                                                 LostFocus="LocalSearch_LostFocus"/>
                                    </Grid>
                                    <Button Grid.Column="2" Click="ClearStageSearch_Click"
                                            Visibility="{Binding StageSearchText, Converter={StaticResource StringToVis}}"
                                            Width="24" Height="24" Margin="0,0,0,0"
                                            Padding="0"
                                            Style="{StaticResource IconButton}">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11" Foreground="#6B778C"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding StageTaskFilterOptions}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding StageTaskFilter}"
                                      Style="{StaticResource FormCombo}"
                                      Width="220" Margin="0,0,12,0"/>

                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding StageStatusOptions}"
                                      SelectedItem="{Binding StageStatusFilter}"
                                      Style="{StaticResource FormCombo}"
                                      Width="160"/>
                        </Grid>
                </Border>

                <Grid Grid.Row="0" Grid.RowSpan="2">
                    <ScrollViewer x:Name="StageListHost" VerticalScrollBarVisibility="Visible"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="24,68,24,16"
                                  Panel.ZIndex="0">
                    <StackPanel x:Name="StageListPanel">

                    <ItemsControl ItemsSource="{Binding ProjectStageGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding TaskGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>

                                                    <Button Margin="0,10,0,6" VerticalAlignment="Center"
                                                            Click="TaskHeader_Click"
                                                            Cursor="Hand"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="0"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                                <Setter Property="BorderThickness" Value="0"/>
                                                                <Setter Property="Padding" Value="0"/>
                                                                <Setter Property="Cursor" Value="Hand"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border x:Name="Border" Background="{TemplateBinding Background}"
                                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                                    Padding="{TemplateBinding Padding}"
                                                                                    ClipToBounds="False"
                                                                                    CornerRadius="4">
                                                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Trigger.EnterActions>
                                                                                        <BeginStoryboard>
                                                                                            <Storyboard>
                                                                                                <ColorAnimation Storyboard.TargetName="Border"
                                                                                                              Storyboard.TargetProperty="Background.Color"
                                                                                                              To="#F1F5F9" Duration="0:0:0.25"/>
                                                                                            </Storyboard>
                                                                                        </BeginStoryboard>
                                                                                    </Trigger.EnterActions>
                                                                                    <Trigger.ExitActions>
                                                                                        <BeginStoryboard>
                                                                                            <Storyboard>
                                                                                                <ColorAnimation Storyboard.TargetName="Border"
                                                                                                              Storyboard.TargetProperty="Background.Color"
                                                                                                              To="Transparent" Duration="0:0:0.25"/>
                                                                                            </Storyboard>
                                                                                        </BeginStoryboard>
                                                                                    </Trigger.ExitActions>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </Button.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*" MinWidth="0"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Width="2" CornerRadius="1" Background="#64748B"
                                                                    VerticalAlignment="Center" Margin="7,0,8,0" Height="12"/>
                                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="10"
                                                                       Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,6,0"
                                                                       Text="Задача"/>
                                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12"
                                                                       FontWeight="SemiBold" Foreground="#111111"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Text="{Binding TaskName, Mode=OneWay}"/>

                                                            <Grid Grid.Column="3" Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0,8,0">
                                                                <Path Data="M 0 0 L 4 4 L 0 8" Stroke="#64748B" StrokeThickness="1.5" StrokeLineJoin="Round"
                                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"/>
                                                                <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#64748B" StrokeThickness="1.5" StrokeLineJoin="Round"
                                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisInv}}"/>
                                                            </Grid>
                                                        </Grid>
                                                    </Button>

                                        <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">

                                        <Border Background="Transparent" Padding="15,8,15,8" Margin="0,0,0,2" Opacity="0.7"
                                                BorderThickness="1.5" BorderBrush="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3*" MinWidth="200"/>
                                                    <ColumnDefinition Width="2*" MinWidth="142"/>
                                                    <ColumnDefinition Width="*" MinWidth="142"/>
                                                    <ColumnDefinition Width="*" MinWidth="122"/>
                                                    <ColumnDefinition Width="*" MinWidth="87"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="НАЗВАНИЕ"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,12,0"/>
                                                <TextBlock Grid.Column="1" Text="ИСПОЛНИТЕЛЬ"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="2" Text="СМЕНА СТАТУСА"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,24,0"
                                                           Visibility="{Binding DataContext.Project.IsClosed, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisInv}}"/>
                                                <TextBlock Grid.Column="3" Text="СТАТУС"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="ДЕЙСТВИЯ"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Right"
                                                           Visibility="{Binding DataContext.Project.IsClosed, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisInv}}"/>
                                            </Grid>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding Stages}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="8" Margin="0,0,0,6"
                                                            Padding="15,10" BorderThickness="1.5"
                                                            Cursor="Hand" MouseLeftButtonDown="Stage_Click">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="White"/>
                                                                <Setter Property="BorderBrush" Value="#DFE1E6"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Stage.EffectiveMarkedForDeletion}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="#EF4444"/>
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="BorderBrush" Value="#111111"/>
                                                                    </Trigger>
                                                                    <EventTrigger RoutedEvent="Loaded">
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                                 From="0" To="1" Duration="0:0:0.2"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="3*" MinWidth="200"/>
                                                                <ColumnDefinition Width="2*" MinWidth="142"/>
                                                                <ColumnDefinition Width="*" MinWidth="142"/>
                                                                <ColumnDefinition Width="*" MinWidth="122"/>
                                                                <ColumnDefinition Width="*" MinWidth="87"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Stage.Name}"
                                                                               FontSize="13" FontWeight="SemiBold"
                                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <Border CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                                                            Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1"
                                                                            Visibility="{Binding Stage.IsOverdue, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock Text="Просрочено" FontSize="10" FontWeight="SemiBold"
                                                                                   Foreground="#DC2626"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Stage.StageInheritedDeletionHint}"
                                                                           FontSize="10" Foreground="#B71C1C" Margin="0,4,0,0"
                                                                           TextWrapping="Wrap"
                                                                           Visibility="{Binding Stage.StageInheritedDeletionHint, Converter={StaticResource StringToVis}}"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                                        Margin="0,0,8,0"
                                                                        Visibility="{Binding Stage.AssignedUserName, Converter={StaticResource StringToVis}}"
                                                                        ToolTip="{Binding Stage.AssignedUserName}">
                                                                <Border Style="{StaticResource AvatarCircle26}"
                                                                        Background="{Binding Stage.AssignedUserInitials, Converter={StaticResource InitialsToBrush}}"
                                                                        Margin="0,0,6,0">
                                                                    <Grid>
                                                                        <Image Style="{StaticResource AvatarImage}"
                                                                               Source="{Binding Stage.AssignedUserAvatarData, Converter={StaticResource AvatarBytesToImage}}"
                                                                               Width="26" Height="26"
                                                                               Visibility="{Binding Stage.AssignedUserAvatarData, Converter={StaticResource NullToVis}}"/>
                                                                        <TextBlock Text="{Binding Stage.AssignedUserInitials}"
                                                                                   FontSize="9" FontWeight="Bold"
                                                                                   Foreground="White"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   Visibility="{Binding Stage.AssignedUserAvatarData, Converter={StaticResource NullToVisInv}}"/>
                                                                    </Grid>
                                                                </Border>
                                                                <TextBlock Text="{Binding Stage.AssignedUserName}"
                                                                           FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                        VerticalAlignment="Center" Margin="0,0,24,0"
                                                                        Visibility="{Binding Stage.EffectiveMarkedForDeletion, Converter={StaticResource BoolToVisInv}}">
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.Project.IsClosed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                                <Button Tag="{Binding Stage}"
                                                                        Click="StartStageFromProject_Click" Margin="0,0,4,0"
                                                                        Style="{StaticResource IconButton}" FontSize="12"
                                                                        Visibility="{Binding Stage.Status, Converter={StaticResource EqualityToVis}, ConverterParameter=Planned}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Image Source="{svgc:SvgImage Source=/icons/play.svg, AppName=MPMS}"
                                                                               Width="12" Height="12" Margin="0,0,4,0"
                                                                               VerticalAlignment="Center" Opacity="0.8"/>
                                                                        <TextBlock Text="Начать" VerticalAlignment="Center"
                                                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button Tag="{Binding Stage}"
                                                                        Click="CompleteStageFromProject_Click" Margin="0,0,4,0"
                                                                        Style="{StaticResource IconButton}" FontSize="12"
                                                                        Visibility="{Binding Stage.Status, Converter={StaticResource EqualityToVis}, ConverterParameter=InProgress}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Image Source="{svgc:SvgImage Source=/icons/check.svg, AppName=MPMS}"
                                                                               Width="10" Height="10" Margin="0,0,4,0"
                                                                               VerticalAlignment="Center" Opacity="0.9"/>
                                                                        <TextBlock Text="Завершить" VerticalAlignment="Center"
                                                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                    </StackPanel>
                                                                </Button>
                                                            </StackPanel>

                                                            <Border Grid.Column="3" CornerRadius="4" Padding="8,4"
                                                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{Binding Stage.Status, Converter={StaticResource StageStatusToBrush}}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Stage.EffectiveMarkedForDeletion}" Value="True">
                                                                                <Setter Property="Background" Value="#EF4444"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="{Binding Stage.Status, Converter={StaticResource StageStatusToString}}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Stage.EffectiveMarkedForDeletion}" Value="True">
                                                                                    <Setter Property="Text" Value="Пометка удаления"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>

                                                            <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                                        VerticalAlignment="Center" HorizontalAlignment="Right"
                                                                        Visibility="{Binding DataContext.Project.IsClosed, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisInv}}">

                                                                <Button ToolTip="Редактировать" Tag="{Binding Stage}"
                                                                        Click="EditStageFromProject_Click" Margin="0,0,4,0">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                                            <Setter Property="Visibility" Value="{Binding Converter={StaticResource RoleToVis}, ConverterParameter='Foreman,Project Manager,Administrator'}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Stage.CanEditStageDetails}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                    <Image Source="{svgc:SvgImage Source=/icons/editing.svg, AppName=MPMS}"
                                                                           Width="14" Height="14"
                                                                           VerticalAlignment="Center"/>
                                                                </Button>

                                                                <Button Tag="{Binding Stage}" Click="MarkStageForDeletion_Click"
                                                                        Margin="0,0,4,0">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                                            <Setter Property="Visibility" Value="{Binding Converter={StaticResource RoleToVis}, ConverterParameter='Foreman,Project Manager,Administrator'}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Stage.CanToggleStageDeletionMark}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding DataContext.Project.IsClosed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                    <Button.ToolTip>
                                                                        <ToolTip>
                                                                            <TextBlock>
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Text" Value="Пометить к удалению"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Stage.IsMarkedForDeletion}" Value="True">
                                                                                                <Setter Property="Text" Value="Снять пометку удаления"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </ToolTip>
                                                                    </Button.ToolTip>
                                                                    <Grid>
                                                                        <Image Source="{svgc:SvgImage Source=/icons/markDelete.svg, AppName=MPMS}"
                                                                               Width="14" Height="14" VerticalAlignment="Center">
                                                                            <Image.Style>
                                                                                <Style TargetType="Image">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Stage.IsMarkedForDeletion}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Image.Style>
                                                                        </Image>
                                                                        <Image Source="{svgc:SvgImage Source=/icons/removeMarkDelete.svg, AppName=MPMS}"
                                                                               Width="14" Height="14" VerticalAlignment="Center">
                                                                            <Image.Style>
                                                                                <Style TargetType="Image">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Stage.IsMarkedForDeletion}" Value="False">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Image.Style>
                                                                        </Image>
                                                                    </Grid>
                                                                </Button>

                                                                <Button ToolTip="Удалить этап"
                                                                        Tag="{Binding Stage}" Click="DeleteStageFromProject_Click">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource DangerIconButton}">
                                                                            <Setter Property="Visibility" Value="{Binding Converter={StaticResource RoleToVis}, ConverterParameter='Project Manager,Administrator'}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding DataContext.Project.IsClosed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                    <Image Width="14" Height="14" VerticalAlignment="Center">
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Setter Property="Source" Value="{svgc:SvgImage Source=/icons/trash.svg, AppName=MPMS}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Stage.EffectiveMarkedForDeletion}" Value="True">
                                                                                        <Setter Property="Source" Value="{svgc:SvgImage Source=/icons/trash_red.svg, AppName=MPMS}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                                    </StackPanel>
                                                </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    <StackPanel Visibility="{Binding AllStages.Count, Converter={StaticResource IntToVisInv}}"
                                HorizontalAlignment="Center" Margin="0,40,0,40">
                        <Image Source="{svgc:SvgImage Source=/icons/stages.svg, AppName=MPMS}"
                               Width="48" Height="48" Opacity="0.1" Margin="0,0,0,16"/>
                        <TextBlock Text="Этапы не найдены"
                                   FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Создайте первый этап"
                                   FontSize="12" Foreground="#64748B" TextAlignment="Center"
                                   Margin="0,8,0,0" LineHeight="18">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Project.IsClosed}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="StageKanbanPanel" Visibility="Collapsed" Margin="24,80,24,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="White" CornerRadius="8" BorderBrush="#DFE1E6" BorderThickness="1"
                                AllowDrop="False" VerticalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#FFEBEE" Padding="14,10" CornerRadius="8,8,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Пометка удаления" FontSize="12" FontWeight="SemiBold" Foreground="#B71C1C"/>
                                        <Border CornerRadius="10" Background="#FFCDD2" Padding="6,1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding FilteredMarkedStages.Count}" FontSize="11" Foreground="#B71C1C"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="8,8,8,8">
                                    <ItemsControl ItemsSource="{Binding FilteredMarkedStages}"
                                                  ItemTemplate="{StaticResource StageKanbanCardTemplate}"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="White" CornerRadius="8" BorderBrush="#DFE1E6" BorderThickness="1"
                                AllowDrop="True" Tag="Planned" VerticalAlignment="Stretch"
                                DragEnter="StageKanbanColumn_DragEnter"
                                DragLeave="StageKanbanColumn_DragLeave"
                                Drop="StageKanbanColumn_Drop">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#F4F5F7" Padding="14,10" CornerRadius="8,8,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="#6B778C" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Запланировано" FontSize="12" FontWeight="SemiBold" Foreground="#6B778C"/>
                                        <Border CornerRadius="10" Background="#E0E0E0" Padding="6,1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding FilteredPlannedStages.Count}" FontSize="11" Foreground="#6B778C"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="8,8,8,8">
                                    <ItemsControl ItemsSource="{Binding FilteredPlannedStages}"
                                                  ItemTemplate="{StaticResource StageKanbanCardTemplate}"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Grid.Column="4" Background="White" CornerRadius="8" BorderBrush="#DFE1E6" BorderThickness="1"
                                AllowDrop="True" Tag="InProgress" VerticalAlignment="Stretch"
                                DragEnter="StageKanbanColumn_DragEnter"
                                DragLeave="StageKanbanColumn_DragLeave"
                                Drop="StageKanbanColumn_Drop">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#E3F2FD" Padding="14,10" CornerRadius="8,8,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="#0082FF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Выполняется" FontSize="12" FontWeight="SemiBold" Foreground="#000000"/>
                                        <Border CornerRadius="10" Background="#BBDEFB" Padding="6,1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding FilteredInProgressStages.Count}" FontSize="11" Foreground="#000000"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="8,8,8,8">
                                    <ItemsControl ItemsSource="{Binding FilteredInProgressStages}"
                                                  ItemTemplate="{StaticResource StageKanbanCardTemplate}"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Grid.Column="6" Background="White" CornerRadius="8" BorderBrush="#DFE1E6" BorderThickness="1"
                                AllowDrop="True" Tag="Completed" VerticalAlignment="Stretch"
                                DragEnter="StageKanbanColumn_DragEnter"
                                DragLeave="StageKanbanColumn_DragLeave"
                                Drop="StageKanbanColumn_Drop">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#E8F5E9" Padding="14,10" CornerRadius="8,8,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="#00875A" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Завершено" FontSize="12" FontWeight="SemiBold" Foreground="#1B5E20"/>
                                        <Border CornerRadius="10" Background="#A5D6A7" Padding="6,1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding FilteredCompletedStages.Count}" FontSize="11" Foreground="#1B5E20"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="8,8,8,8">
                                    <ItemsControl ItemsSource="{Binding FilteredCompletedStages}"
                                                  ItemTemplate="{StaticResource StageKanbanCardTemplate}"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="DiscussionPanel" Visibility="Collapsed" Margin="24,8,24,16">
                <Border Background="White" CornerRadius="8"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <components:DiscussionPanelControl x:Name="ProjectDiscussionControl"
                                                       ItemsSource="{Binding Messages}"
                                                       IsClosed="{Binding Project.IsClosed}"/>
                </Border>
            </Grid>

            <Grid x:Name="FilesPanel" Visibility="Collapsed" Margin="24,8,24,16">
                <components:FilesControl DataContext="{Binding FilesControlVM}"/>
            </Grid>

            <Grid x:Name="SummaryPanel" Visibility="Collapsed" Margin="24,8,24,16">
                <components:ProjectSummaryControl DataContext="{Binding}"/>
            </Grid>


        </Grid>

        <controls:DragDropOverlay Grid.RowSpan="3"
                                  UploadCommand="{Binding FilesControlVM.ProcessFilesCommand}"
                                  Panel.ZIndex="9999"/>
    </Grid>
</UserControl>
