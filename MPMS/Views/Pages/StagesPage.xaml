<UserControl x:Class="MPMS.Views.Pages.StagesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="StageRow" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8F9FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Transparent" Padding="24,16,24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Этапы" FontSize="24" FontWeight="Bold" Foreground="#111111"/>
                    <TextBlock Text="{Binding Stages.Count, StringFormat='Этапов: {0}'}"
                               FontSize="13" Foreground="#64748B" Margin="0,3,0,0"/>
                </StackPanel>
                <Button x:Name="CreateStageBtn" Grid.Column="1"
                        Click="CreateStage_Click"
                        Visibility="{Binding Converter={StaticResource RoleToVis}, ConverterParameter='Foreman,Project Manager,Administrator'}"
                        Height="38" Padding="18,0" FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="#111111" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{svgc:SvgImage Source=/icons/plus.svg, AppName=MPMS}"
                                           Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Добавить этап" Foreground="White"
                                               VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#333333"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,12,0,24" ClipToBounds="True">
            <ScrollViewer x:Name="MainListScroll"
                          VerticalScrollBarVisibility="Visible"
                          Padding="0,62,24,0"
                          Background="Transparent"
                          Panel.ZIndex="0">
                <StackPanel>

                        <ItemsControl ItemsSource="{Binding ProjectStageGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel ClipToBounds="False">

                                        <Button Margin="0,10,0,6" VerticalAlignment="Center"
                                                Click="ProjectHeader_Click"
                                                Cursor="Hand"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                ClipToBounds="False">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="Border" Background="{TemplateBinding Background}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        Padding="{TemplateBinding Padding}"
                                                                        ClipToBounds="False"
                                                                        CornerRadius="4">
                                                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Trigger.EnterActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <ColorAnimation Storyboard.TargetName="Border"
                                                                                                  Storyboard.TargetProperty="Background.Color"
                                                                                                  To="#F1F5F9" Duration="0:0:0.25"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </Trigger.EnterActions>
                                                                        <Trigger.ExitActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <ColorAnimation Storyboard.TargetName="Border"
                                                                                                  Storyboard.TargetProperty="Background.Color"
                                                                                                  To="Transparent" Duration="0:0:0.25"/>
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </Trigger.ExitActions>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                            <Grid ClipToBounds="False">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="3" CornerRadius="1.5" Background="#111111"
                                                        VerticalAlignment="Center" Margin="0,0,10,0" Height="14"/>
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="10"
                                                           Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,6,0"
                                                           Text="Проект"/>
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12"
                                                           FontWeight="SemiBold" Foreground="#111111"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding ProjectName, Mode=OneWay}"/>

                                                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11"
                                                           Foreground="#64748B" Margin="8,0,8,0">
                                                    <Run Text="{Binding TaskCount, Mode=OneWay}"/>
                                                    <Run Text="{Binding TaskCount, Converter={StaticResource PluralTaskConverter}, Mode=OneWay}"/>
                                                    <Run Text="·"/>
                                                    <Run Text="{Binding StageCount, Mode=OneWay}"/>
                                                    <Run Text="{Binding StageCount, Converter={StaticResource PluralStageConverter}, Mode=OneWay}"/>
                                                </TextBlock>

                                                <Grid Grid.Column="4" Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0,8,0">
                                                    <Path Data="M 0 0 L 4 4 L 0 8" Stroke="#64748B" StrokeThickness="1.5" StrokeLineJoin="Round"
                                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"/>
                                                    <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#64748B" StrokeThickness="1.5" StrokeLineJoin="Round"
                                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisInv}}"/>
                                                </Grid>
                                            </Grid>
                                        </Button>
                                        
                                        <ItemsControl ItemsSource="{Binding TaskGroups}" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,0">

                                                        <Button Margin="0,8,0,4" VerticalAlignment="Center"
                                                                Click="TaskHeader_Click"
                                                                Cursor="Hand"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="0"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Setter Property="BorderThickness" Value="0"/>
                                                                    <Setter Property="Padding" Value="0"/>
                                                                    <Setter Property="Cursor" Value="Hand"/>
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border x:Name="Border" Background="{TemplateBinding Background}"
                                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                                        Padding="{TemplateBinding Padding}"
                                                                                        ClipToBounds="False"
                                                                                        CornerRadius="4">
                                                                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Trigger.EnterActions>
                                                                                            <BeginStoryboard>
                                                                                                <Storyboard>
                                                                                                    <ColorAnimation Storyboard.TargetName="Border"
                                                                                                                  Storyboard.TargetProperty="Background.Color"
                                                                                                                  To="#F1F5F9" Duration="0:0:0.25"/>
                                                                                                </Storyboard>
                                                                                            </BeginStoryboard>
                                                                                        </Trigger.EnterActions>
                                                                                        <Trigger.ExitActions>
                                                                                            <BeginStoryboard>
                                                                                                <Storyboard>
                                                                                                    <ColorAnimation Storyboard.TargetName="Border"
                                                                                                                  Storyboard.TargetProperty="Background.Color"
                                                                                                                  To="Transparent" Duration="0:0:0.25"/>
                                                                                                </Storyboard>
                                                                                            </BeginStoryboard>
                                                                                        </Trigger.ExitActions>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </Button.Style>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*" MinWidth="0"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Width="2" CornerRadius="1" Background="#64748B"
                                                                        VerticalAlignment="Center" Margin="7,0,8,0" Height="12"/>
                                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="10"
                                                                           Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,6,0"
                                                                           Text="Задача"/>
                                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12"
                                                                           FontWeight="SemiBold" Foreground="#111111"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Text="{Binding TaskName, Mode=OneWay}"/>

                                                                <Grid Grid.Column="3" Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0,8,0">
                                                                    <Path Data="M 0 0 L 4 4 L 0 8" Stroke="#64748B" StrokeThickness="1.5" StrokeLineJoin="Round"
                                                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"/>
                                                                    <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#64748B" StrokeThickness="1.5" StrokeLineJoin="Round"
                                                                          Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisInv}}"/>
                                                                </Grid>
                                                            </Grid>
                                                        </Button>

                                        <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">

                                        <Border Background="Transparent" Padding="15,8,15,8" Margin="0,0,0,2" Opacity="0.7"
                                                BorderThickness="1.5" BorderBrush="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3*" MinWidth="200"/>
                                                    <ColumnDefinition Width="2*" MinWidth="142"/>
                                                    <ColumnDefinition Width="*" MinWidth="142"/>
                                                    <ColumnDefinition Width="*" MinWidth="122"/>
                                                    <ColumnDefinition Width="*" MinWidth="87"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="НАЗВАНИЕ"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,12,0"/>
                                                <TextBlock Grid.Column="1" Text="ИСПОЛНИТЕЛЬ"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="2" Text="СМЕНА СТАТУСА"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                                                           Margin="0,0,24,0"/>
                                                <TextBlock Grid.Column="3" Text="СТАТУС"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="ДЕЙСТВИЯ"
                                                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding Stages}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="StageCardBorder" CornerRadius="8" Margin="0,0,0,6"
                                                            Padding="15,10" BorderThickness="1.5"
                                                            Cursor="Hand" MouseLeftButtonDown="Stage_Click">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="White"/>
                                                                <Setter Property="BorderBrush" Value="#DFE1E6"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Stage.EffectiveMarkedForDeletion}" Value="True">
                                                                        <Setter Property="BorderBrush" Value="#EF4444"/>
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="BorderBrush" Value="#111111"/>
                                                                    </Trigger>
                                                                    <EventTrigger RoutedEvent="Loaded">
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                                 From="0" To="1" Duration="0:0:0.2"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="3*" MinWidth="200"/>
                                                                <ColumnDefinition Width="2*" MinWidth="142"/>
                                                                <ColumnDefinition Width="*" MinWidth="142"/>
                                                                <ColumnDefinition Width="*" MinWidth="122"/>
                                                                <ColumnDefinition Width="*" MinWidth="87"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Stage.Name}"
                                                                               FontSize="13" FontWeight="SemiBold"
                                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <Border CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                                                            Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1"
                                                                            Visibility="{Binding Stage.IsOverdue, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock Text="Просрочено" FontSize="10" FontWeight="SemiBold"
                                                                                   Foreground="#DC2626"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Stage.StageInheritedDeletionHint}"
                                                                           FontSize="10" Foreground="#B71C1C" Margin="0,4,0,0"
                                                                           TextWrapping="Wrap"
                                                                           Visibility="{Binding Stage.StageInheritedDeletionHint, Converter={StaticResource StringToVis}}"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                                        Margin="0,0,8,0"
                                                                        Visibility="{Binding Stage.AssignedUserName, Converter={StaticResource StringToVis}}"
                                                                        ToolTip="{Binding Stage.AssignedUserName}">
                                                                <Border Style="{StaticResource AvatarCircle26}"
                                                                        Background="{Binding Stage.AssignedUserInitials, Converter={StaticResource InitialsToBrush}}"
                                                                        Margin="0,0,6,0">
                                                                    <Grid>
                                                                        <Image Style="{StaticResource AvatarImage}"
                                                                               Source="{Binding Stage.AssignedUserAvatarData, Converter={StaticResource AvatarBytesToImage}}"
                                                                               Width="26" Height="26"
                                                                               Visibility="{Binding Stage.AssignedUserAvatarData, Converter={StaticResource NullToVis}}"/>
                                                                        <TextBlock Text="{Binding Stage.AssignedUserInitials}"
                                                                                   FontSize="9" FontWeight="Bold"
                                                                                   Foreground="White"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   Visibility="{Binding Stage.AssignedUserAvatarData, Converter={StaticResource NullToVisInv}}"/>
                                                                    </Grid>
                                                                </Border>
                                                                <TextBlock Text="{Binding Stage.AssignedUserName}"
                                                                           FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                        VerticalAlignment="Center" Margin="0,0,24,0"
                                                                        Visibility="{Binding Stage.EffectiveMarkedForDeletion, Converter={StaticResource BoolToVisInv}}">
                                                                    <Button Tag="{Binding}"
                                                                            Click="StartStage_Click" Margin="0,0,4,0"
                                                                            Style="{StaticResource IconButton}" FontSize="12"
                                                                            Visibility="{Binding Stage.Status, Converter={StaticResource EqualityToVis}, ConverterParameter=Planned}">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Image Source="{svgc:SvgImage Source=/icons/play.svg, AppName=MPMS}"
                                                                                   Width="12" Height="12" Margin="0,0,4,0"
                                                                                   VerticalAlignment="Center" Opacity="0.8"/>
                                                                            <TextBlock Text="Начать" VerticalAlignment="Center"
                                                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Button Tag="{Binding}"
                                                                            Click="CompleteStage_Click" Margin="0,0,4,0"
                                                                            Style="{StaticResource IconButton}" FontSize="12"
                                                                            Visibility="{Binding Stage.Status, Converter={StaticResource EqualityToVis}, ConverterParameter=InProgress}">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Image Source="{svgc:SvgImage Source=/icons/check.svg, AppName=MPMS}"
                                                                                   Width="10" Height="10" Margin="0,0,4,0"
                                                                                   VerticalAlignment="Center" Opacity="0.9"/>
                                                                            <TextBlock Text="Завершить" VerticalAlignment="Center"
                                                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                        </StackPanel>
                                                                    </Button>
                                                            </StackPanel>

                                                            <Border Grid.Column="3" CornerRadius="4" Padding="8,4"
                                                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{Binding Stage.Status, Converter={StaticResource StageStatusToBrush}}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Stage.EffectiveMarkedForDeletion}" Value="True">
                                                                                <Setter Property="Background" Value="#EF4444"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="White"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="{Binding Stage.Status, Converter={StaticResource StageStatusToString}}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Stage.EffectiveMarkedForDeletion}" Value="True">
                                                                                    <Setter Property="Text" Value="Пометка удаления"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>

                                                            <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                                        VerticalAlignment="Center" HorizontalAlignment="Right">

                                                                <Button ToolTip="Редактировать" Tag="{Binding}"
                                                                        Click="EditStage_Click" Margin="0,0,4,0">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                                            <Setter Property="Visibility" Value="{Binding Converter={StaticResource RoleToVis}, ConverterParameter='Foreman,Project Manager,Administrator'}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Stage.CanEditStageDetails}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                    <Image Source="{svgc:SvgImage Source=/icons/editing.svg, AppName=MPMS}"
                                                                           Width="14" Height="14"
                                                                           VerticalAlignment="Center"/>
                                                                </Button>

                                                                <Button Tag="{Binding}" Click="MarkStage_Click"
                                                                        Margin="0,0,4,0">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                                            <Setter Property="Visibility" Value="{Binding Converter={StaticResource RoleToVis}, ConverterParameter='Foreman,Project Manager,Administrator'}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Stage.CanToggleStageDeletionMark}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                    <Button.ToolTip>
                                                                        <ToolTip>
                                                                            <TextBlock>
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Text" Value="Пометить к удалению"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Stage.IsMarkedForDeletion}" Value="True">
                                                                                                <Setter Property="Text" Value="Снять пометку удаления"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </ToolTip>
                                                                    </Button.ToolTip>
                                                                    <Grid>
                                                                        <Image Source="{svgc:SvgImage Source=/icons/markDelete.svg, AppName=MPMS}"
                                                                               Width="14" Height="14" VerticalAlignment="Center">
                                                                            <Image.Style>
                                                                                <Style TargetType="Image">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Stage.IsMarkedForDeletion}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Image.Style>
                                                                        </Image>
                                                                        <Image Width="14" Height="14" VerticalAlignment="Center">
                                                                            <Image.Style>
                                                                                <Style TargetType="Image">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    <Setter Property="Source" Value="{svgc:SvgImage Source=/icons/removeMarkDelete.svg, AppName=MPMS}"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Stage.IsMarkedForDeletion}" Value="True">
                                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding ElementName=StageCardBorder, Path=IsMouseOver}" Value="True">
                                                                                            <Setter Property="Source" Value="{svgc:SvgImage Source=/icons/removeMarkDelete_black.svg, AppName=MPMS}"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Image.Style>
                                                                        </Image>
                                                                    </Grid>
                                                                </Button>

                                                                <Button ToolTip="Удалить этап" Tag="{Binding}"
                                                                        Click="DeleteStage_Click"
                                                                        Style="{StaticResource DangerIconButton}"
                                                                        Visibility="{Binding Converter={StaticResource RoleToVis}, ConverterParameter='Project Manager,Administrator'}">
                                                                    <Image Width="14" Height="14" VerticalAlignment="Center">
                                                                        <Image.Style>
                                                                            <Style TargetType="Image">
                                                                                <Setter Property="Source" Value="{svgc:SvgImage Source=/icons/trash.svg, AppName=MPMS}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Stage.EffectiveMarkedForDeletion}" Value="True">
                                                                                        <Setter Property="Source" Value="{svgc:SvgImage Source=/icons/trash_red.svg, AppName=MPMS}"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding ElementName=StageCardBorder, Path=IsMouseOver}" Value="True">
                                                                                        <Setter Property="Source" Value="{svgc:SvgImage Source=/icons/trash.svg, AppName=MPMS}"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Image.Style>
                                                                    </Image>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel HorizontalAlignment="Center" Margin="0,40,0,40"
                                    Visibility="{Binding ProjectStageGroups.Count, Converter={StaticResource IntToVisInv}}">
                            <Image Source="{svgc:SvgImage Source=/icons/stages.svg, AppName=MPMS}" 
                                   Width="48" Height="48" Opacity="0.1" Margin="0,0,0,16"/>
                            <TextBlock Text="Этапы не найдены" 
                                       FontSize="15" FontWeight="SemiBold" Foreground="#0F172A" 
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Создайте первый этап" 
                                       FontSize="12" Foreground="#64748B" TextAlignment="Center" 
                                       Margin="0,8,0,0" LineHeight="18"/>
                        </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <Border VerticalAlignment="Top" Panel.ZIndex="1"
                    HorizontalAlignment="Left"
                    Width="{Binding ElementName=MainListScroll, Path=ViewportWidth}"
                    Background="White" CornerRadius="8"
                    BorderBrush="#DFE1E6" BorderThickness="1"
                    Padding="16,10,16,14"
                    PreviewMouseWheel="FilterBar_PreviewMouseWheel">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#F4F5F7" CornerRadius="6"
                            Padding="10,0,2,0" Height="36" Margin="0,0,12,0"
                            BorderThickness="1" BorderBrush="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE721;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center"
                                       Margin="0,0,8,0" Foreground="#64748B"/>
                            <Grid Grid.Column="1" Margin="0,0,4,0">
                                <TextBlock Text="Поиск по этапу, задаче или проекту..."
                                           Foreground="#64748B" FontSize="12"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0"
                                         VerticalAlignment="Center" FontSize="13"
                                         Foreground="#111111"
                                         SelectionBrush="{StaticResource NeutralSelectionBrush}"
                                         SelectionTextBrush="#111111"
                                         GotFocus="SearchBox_GotFocus"
                                         LostFocus="SearchBox_LostFocus"/>
                            </Grid>
                            <Button Grid.Column="2" Click="ClearSearch_Click"
                                    Visibility="{Binding SearchText, Converter={StaticResource StringToVis}}"
                                    Width="24" Height="24" Margin="0,0,0,0"
                                    Padding="0"
                                    Style="{StaticResource IconButton}">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="11" Foreground="#64748B"/>
                            </Button>
                        </Grid>
                    </Border>

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding ProjectFilterOptions}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding ProjectFilter}"
                              Style="{StaticResource FormCombo}"
                              Width="200" Margin="0,0,8,0"/>

                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding TaskFilterOptions}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding TaskFilter}"
                              Style="{StaticResource FormCombo}"
                              Width="220" Margin="0,0,8,0"/>

                    <ComboBox Grid.Column="3"
                              ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding StatusFilter}"
                              Style="{StaticResource FormCombo}"
                              Width="160"/>
                </Grid>
            </Border>


        </Grid>
    </Grid>
</UserControl>
