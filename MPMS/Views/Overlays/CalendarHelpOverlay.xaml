<UserControl x:Class="MPMS.Views.Overlays.CalendarHelpOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <UserControl.Resources>
        <Style x:Key="ColorLegendItem" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,18" BorderBrush="#E8E9EC" BorderThickness="0,0,0,1" Background="White">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Календарь" FontSize="20" FontWeight="Bold" Foreground="#000000"/>
                    <TextBlock Text="Визуализация сроков задач и этапов с дедлайном" FontSize="12" Foreground="#6B778C" Margin="0,4,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="Close_Click" Width="32" Height="32">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="#F4F5F7" CornerRadius="16">
                                <TextBlock Text="✕" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#6B778C"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#E8E9EC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,18,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="ЦВЕТА ПЛАШЕК ЗАДАЧ" FontSize="11" FontWeight="SemiBold" Foreground="#8993A4" Margin="0,0,0,10"/>
                <UniformGrid Grid.Row="1" Columns="1" Rows="3">
                    <Border Style="{StaticResource ColorLegendItem}"><StackPanel Orientation="Horizontal"><Border Width="18" Height="18" CornerRadius="5" Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1" Margin="0,0,8,0"/><TextBlock Text="Красный — запланировано" FontSize="13" FontWeight="SemiBold" Foreground="#172B4D"/></StackPanel></Border>
                    <Border Style="{StaticResource ColorLegendItem}"><StackPanel Orientation="Horizontal"><Border Width="18" Height="18" CornerRadius="5" Background="#DBEAFE" BorderBrush="#3B82F6" BorderThickness="1" Margin="0,0,8,0"/><TextBlock Text="Синий — выполняется" FontSize="13" FontWeight="SemiBold" Foreground="#172B4D"/></StackPanel></Border>
                    <Border Style="{StaticResource ColorLegendItem}"><StackPanel Orientation="Horizontal"><Border Width="18" Height="18" CornerRadius="5" Background="#D1FAE5" BorderBrush="#10B981" BorderThickness="1" Margin="0,0,8,0"/><TextBlock Text="Зелёный — завершено" FontSize="13" FontWeight="SemiBold" Foreground="#172B4D"/></StackPanel></Border>
                </UniformGrid>

                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,8,0,0" VerticalAlignment="Stretch">
                    <TextBlock Text="Плашки задач отображаются в ячейках календаря в соответствии с дедлайном. Цвет плашки указывает на текущий статус задачи: запланировано, выполняется или завершено." FontSize="11" Foreground="#475569" TextWrapping="Wrap" LineHeight="16"/>
                </Border>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="ЦВЕТА ПЛАШЕК ЭТАПОВ" FontSize="11" FontWeight="SemiBold" Foreground="#8993A4" Margin="0,0,0,10"/>
                <UniformGrid Grid.Row="1" Columns="1" Rows="1">
                    <Border Style="{StaticResource ColorLegendItem}"><StackPanel Orientation="Horizontal"><Border Width="18" Height="18" CornerRadius="5" Background="#EDE9FE" BorderBrush="#7C3AED" BorderThickness="1" Margin="0,0,8,0"/><TextBlock Text="Фиолетовый — этапы задач" FontSize="13" FontWeight="SemiBold" Foreground="#172B4D"/></StackPanel></Border>
                </UniformGrid>

                <Border Grid.Row="2" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,8,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="18" Height="18" Fill="#DE350B" Margin="0,0,8,0"/>
                            <TextBlock Text="Красная точка" FontSize="11" FontWeight="SemiBold" Foreground="#7F1D1D"/>
                        </StackPanel>
                        <TextBlock Text="появляется рядом с плашкой, если задача или этап просрочены (дедлайн уже прошёл)." FontSize="11" Foreground="#7F1D1D" TextWrapping="Wrap" LineHeight="16" Margin="26,0,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Background="#EEF2FF" CornerRadius="8" Padding="10" VerticalAlignment="Stretch">
                    <TextBlock Text="Сегодняшний день подсвечивается серым фоном с тёмно-серым кругом вокруг номера. При наведении на ячейку показывается фон. Клик по ячейке открывает список всех задач и этапов на этот день. Клик по плашке открывает детальную карточку задачи или этапа." FontSize="11" Foreground="#334155" TextWrapping="Wrap" LineHeight="16" VerticalAlignment="Top"/>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1,1,0,0" Padding="24,14">
            <TextBlock Text="Окно «Календарь» показывает задачи и этапы с дедлайнами в виде календарной сетки выбранного месяца. Используйте стрелки для перехода между месяцами и кнопку «Сегодня» для быстрого возврата к текущему месяцу. В каждой ячейке отображаются плашки задач и этапов, срок которых приходится на этот день. Если плашек больше 3–4, показывается счётчик «+N»." FontSize="11.5" Foreground="#475569" TextWrapping="Wrap" LineHeight="17"/>
        </Border>
    </Grid>
</UserControl>
