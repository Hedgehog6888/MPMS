<UserControl x:Class="MPMS.Views.Overlays.AdminActivityDetailOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:infra="clr-namespace:MPMS.Infrastructure"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="520">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <infra:ActivityLogToAccentBrushConverter x:Key="ActivityLogToAccentBrush"/>
        <infra:EntityTypeToBadgeLabelConverter x:Key="EntityTypeToLabel"/>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8993A4"/>
            <Setter Property="Margin"     Value="0,20,0,10"/>
        </Style>
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#6B778C"/>
            <Setter Property="Margin"     Value="0,0,0,2"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ Header ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Padding="24,18"
                BorderBrush="#E8E9EC" BorderThickness="0,0,0,1" Background="White">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Детали операции"
                               FontSize="20" FontWeight="Bold" Foreground="#000000"/>
                    <TextBlock x:Name="HeaderSubtitle"
                               Text="Просмотр подробной информации"
                               FontSize="12" Foreground="#6B778C" Margin="0,4,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="Cancel_Click" Width="32" Height="32">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="#F4F5F7" CornerRadius="16">
                                <TextBlock Text="✕" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#6B778C"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#E8E9EC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ═══ Body ═════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,8">

                <!-- User info -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Border Style="{StaticResource AvatarCircle48}"
                            x:Name="AvatarBorder"
                            Margin="0,0,12,0">
                        <Grid>
                            <Image x:Name="AvatarImage"
                                   Style="{StaticResource AvatarImage}"
                                   Width="48" Height="48"/>
                            <TextBlock x:Name="AvatarInitials"
                                       FontSize="14" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="UserNameText"
                                   FontSize="16" FontWeight="Bold" Foreground="#000000"/>
                        <TextBlock x:Name="UserRoleText"
                                   FontSize="12" Foreground="#6B778C" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Action type badge -->
                <Border x:Name="ActionBadge" CornerRadius="6" Padding="12,8" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ActionTypeText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- OPERATION INFO -->
                <TextBlock Text="ИНФОРМАЦИЯ ОПЕРАЦИИ" Style="{StaticResource SectionHeader}"/>

                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Grid.Row="0">
                        <TextBlock Text="Тип действия" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="ActionKindText" Style="{StaticResource InfoValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.Row="0">
                        <TextBlock Text="Дата и время" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="CreatedAtText" Style="{StaticResource InfoValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="0" Grid.Row="2">
                        <TextBlock Text="Сущность" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="EntityTypeText" Style="{StaticResource InfoValue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Grid.Row="2">
                        <TextBlock Text="ID сущности" Style="{StaticResource InfoLabel}"/>
                        <TextBlock x:Name="EntityIdText" Style="{StaticResource InfoValue}"/>
                    </StackPanel>
                </Grid>

                <!-- DESCRIPTION -->
                <TextBlock Text="ОПИСАНИЕ" Style="{StaticResource SectionHeader}"/>
                <Border Background="#F4F5F7" CornerRadius="6" Padding="14,12" Margin="0,0,0,4">
                    <TextBlock x:Name="ActionDescriptionText"
                               FontSize="13" Foreground="#000000"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- DETAILS -->
                <TextBlock x:Name="DetailsHeader"
                           Text="ДЕТАЛИ"
                           Style="{StaticResource SectionHeader}"
                           Visibility="Collapsed"/>
                <Border x:Name="DetailsBorder"
                        Background="#F4F5F7" CornerRadius="6" Padding="14,12" Margin="0,0,0,4"
                        Visibility="Collapsed">
                    <TextBlock x:Name="DetailsText"
                               FontSize="13" Foreground="#000000"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- TOOLTIP DETAILS -->
                <TextBlock x:Name="TooltipHeader"
                           Text="ДОПОЛНИТЕЛЬНО"
                           Style="{StaticResource SectionHeader}"
                           Visibility="Collapsed"/>
                <ItemsControl x:Name="TooltipDetailLinesList" Margin="0,0,0,4" Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F4F5F7" CornerRadius="4" Padding="10,8" Margin="0,0,0,4">
                                <TextBlock Text="{Binding}"
                                           FontSize="12" Foreground="#344563"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══ Footer ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Padding="24,14"
                BorderBrush="#E8E9EC" BorderThickness="0,1,0,0" Background="White">
            <Button Content="Закрыть"
                    Style="{StaticResource BlackBtn}"
                    HorizontalAlignment="Right"
                    Click="Cancel_Click"/>
        </Border>
    </Grid>
</UserControl>
