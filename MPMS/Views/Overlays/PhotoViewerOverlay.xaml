<UserControl x:Class="MPMS.Views.Overlays.PhotoViewerOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             Background="Transparent">

    <UserControl.Resources>

        <!-- Light icon button style matching app design -->
        <Style x:Key="ViewerIconBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DFE1E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F4F5F7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- View Toggle RadioButton with borders for inactive state -->
        <Style x:Key="DrawToolToggleButton" TargetType="RadioButton">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DFE1E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#111111"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#111111"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background" Value="#F4F5F7"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background" Value="#333333"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Aspect ratio button style (square like undo/redo buttons) -->
        <Style x:Key="AspectRatioButton" TargetType="RadioButton">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DFE1E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#111111"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#111111"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background" Value="#F4F5F7"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bg" Property="Background" Value="#333333"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Save button (black style) -->
        <Style x:Key="SaveInfoBtn" TargetType="Button">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#333333"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close circle button (light style) -->
        <Style x:Key="CloseCircleBtn" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#F4F5F7" CornerRadius="16">
                            <Image Source="{svgc:SvgImage Source=/icons/close.svg, AppName=MPMS}" 
                                   Width="16" Height="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E8E9EC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Light zoom slider -->
        <Style x:Key="ZoomSliderStyle" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#111111" Height="3" CornerRadius="1.5"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="14" Height="14" Background="White"
                                                        CornerRadius="7"
                                                        BorderBrush="#111111" BorderThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#E8E9EC" Height="3" CornerRadius="1.5"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Info row label (light theme) -->
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6B778C"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="CropHandleVisual" TargetType="Border">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#111111"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="0" Opacity="0.7"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Note button styles (same as in HomePage) -->
        <Style x:Key="NoteActionButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BlackNoteButton" TargetType="Button" BasedOn="{StaticResource NoteActionButton}">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#333333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WhiteNoteButton" TargetType="Button" BasedOn="{StaticResource NoteActionButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#DFE1E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F4F5F7"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <!-- Root: full overlay light background -->
    <Grid Background="#FFFFFF">
        <Grid.ColumnDefinitions>
            <!-- Main image area -->
            <ColumnDefinition Width="*"/>
            <!-- Info panel -->
            <ColumnDefinition Width="290"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- Bottom bar -->
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- LEFT: Image viewport                                        -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="0" Grid.Row="0">

            <!-- Viewport -->
            <Grid x:Name="ViewportGrid"
                  Background="#F4F5F7"
                  ClipToBounds="True"
                  SizeChanged="ViewportGrid_SizeChanged">

                <!-- Canvas provides infinite layout space to prevent WPF clipping -->
                <Canvas x:Name="InfiniteCanvas">

                    <!-- Scale + Rotate + Pan applied here -->
                    <Grid x:Name="ImageContainer"
                          RenderTransformOrigin="0.5,0.5"
                          ClipToBounds="True">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ImgScale" ScaleX="1" ScaleY="1"/>
                                <RotateTransform x:Name="ImgRotate" Angle="0"/>
                                <TranslateTransform x:Name="ImgTranslate" X="0" Y="0"/>
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <!-- Image — explicit W/H set from code after load -->
                        <Image x:Name="MainImage"
                               Stretch="Fill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <!-- Draw canvas — same size as image (set from code) -->
                        <Canvas x:Name="DrawCanvas"
                                Background="Transparent"
                                Cursor="Hand"
                                SizeChanged="DrawCanvas_SizeChanged"
                                MouseLeftButtonDown="DrawCanvas_MouseDown"
                                MouseMove="DrawCanvas_MouseMove"
                                MouseLeftButtonUp="DrawCanvas_MouseUp"
                                MouseWheel="DrawCanvas_MouseWheel"
                                MouseEnter="DrawCanvas_MouseEnter"
                                MouseLeave="DrawCanvas_MouseLeave">

                            <!-- Custom cursor circle for drawing tools -->
                            <Ellipse x:Name="CursorCircle"
                                     Stroke="White"
                                     StrokeThickness="3"
                                     Fill="Transparent"
                                     IsHitTestVisible="False"
                                     Visibility="Collapsed"
                                     Panel.ZIndex="9999">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="0" Opacity="0.8"/>
                                </Ellipse.Effect>
                            </Ellipse>

                            <!-- Crop overlay -->
                            <Canvas x:Name="CropOverlayGrid" Visibility="Collapsed"
                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                    Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                    Panel.ZIndex="9000"
                                    IsHitTestVisible="False">
                                <Rectangle x:Name="DimTop"    Fill="#A6000000" IsHitTestVisible="False"/>
                                <Rectangle x:Name="DimBottom" Fill="#A6000000" IsHitTestVisible="False"/>
                                <Rectangle x:Name="DimLeft"   Fill="#A6000000" IsHitTestVisible="False"/>
                                <Rectangle x:Name="DimRight"  Fill="#A6000000" IsHitTestVisible="False"/>

                                <Border x:Name="CropBorder"
                                        BorderBrush="White" BorderThickness="4"
                                        Background="Transparent" IsHitTestVisible="False">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="12" Opacity="0.6" ShadowDepth="0"/>
                                    </Border.Effect>
                                </Border>

                                <Line x:Name="CropGridV1" Stroke="#CCFFFFFF" StrokeThickness="1" IsHitTestVisible="False"/>
                                <Line x:Name="CropGridV2" Stroke="#CCFFFFFF" StrokeThickness="1" IsHitTestVisible="False"/>
                                <Line x:Name="CropGridH1" Stroke="#CCFFFFFF" StrokeThickness="1" IsHitTestVisible="False"/>
                                <Line x:Name="CropGridH2" Stroke="#CCFFFFFF" StrokeThickness="1" IsHitTestVisible="False"/>

                                <Border x:Name="HandleTL" Style="{StaticResource CropHandleVisual}" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="HandleTLScale" ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                </Border>
                                <Border x:Name="HandleT"  Style="{StaticResource CropHandleVisual}" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="HandleTScale" ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                </Border>
                                <Border x:Name="HandleTR" Style="{StaticResource CropHandleVisual}" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="HandleTRScale" ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                </Border>
                                <Border x:Name="HandleR"  Style="{StaticResource CropHandleVisual}" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="HandleRScale" ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                </Border>
                                <Border x:Name="HandleBR" Style="{StaticResource CropHandleVisual}" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="HandleBRScale" ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                </Border>
                                <Border x:Name="HandleB"  Style="{StaticResource CropHandleVisual}" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="HandleBScale" ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                </Border>
                                <Border x:Name="HandleBL" Style="{StaticResource CropHandleVisual}" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="HandleBLScale" ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                </Border>
                                <Border x:Name="HandleL"  Style="{StaticResource CropHandleVisual}" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="HandleLScale" ScaleX="1" ScaleY="1"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Canvas>
                        </Canvas>
                    </Grid>
                </Canvas>
            </Grid>

        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- RIGHT: Info panel                                           -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="1" Grid.Row="0"
                Background="White"
                BorderBrush="#E8E9EC" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <!-- Drawing tools below info -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,14,16,12">

                        <!-- Header: title + close + save -->
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Сведения" FontSize="15" FontWeight="SemiBold"
                                       Foreground="#111111" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="SaveBtn" Content="Сохранить"
                                        Style="{StaticResource SaveInfoBtn}"
                                        IsEnabled="False" Margin="0,0,6,0"
                                        Click="Save_Click"/>
                                <Button Style="{StaticResource CloseCircleBtn}"
                                        Click="Close_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- File name editable -->
                        <Border Background="#F4F5F7" BorderBrush="#E8E9EC" BorderThickness="1"
                                CornerRadius="6" Margin="0,0,0,12">
                            <Grid Margin="10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FileNameBox"
                                         Background="Transparent"
                                         Foreground="#111111"
                                         BorderThickness="0"
                                         FontSize="13"
                                         CaretBrush="#111111"
                                         SelectionBrush="#111111"
                                         TextChanged="FileNameBox_TextChanged"/>
                            </Grid>
                        </Border>

                        <!-- Created date -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{svgc:SvgImage Source=/icons/created.svg, AppName=MPMS}" Width="16" Height="16" Opacity="0.6" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource InfoLabel}" Text="Создано"/>
                                <TextBlock x:Name="CreatedText" Style="{StaticResource InfoValue}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Modified time -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{svgc:SvgImage Source=/icons/modified.svg, AppName=MPMS}" Width="16" Height="16" Opacity="0.6" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource InfoLabel}" Text="Изменено"/>
                                <TextBlock x:Name="ModifiedText" Style="{StaticResource InfoValue}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Divider -->
                        <Border Height="1" Background="#E8E9EC" Margin="0,4,0,12"/>

                        <!-- Description editable -->
                        <Border Background="#F4F5F7" BorderBrush="#E8E9EC" BorderThickness="1"
                                CornerRadius="6" Margin="0,0,0,12">
                            <Grid Margin="10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DescriptionBox"
                                         Background="Transparent"
                                         Foreground="#111111"
                                         BorderThickness="0"
                                         FontSize="13"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         MinHeight="60"
                                         VerticalScrollBarVisibility="Auto"
                                         CaretBrush="#111111"
                                         SelectionBrush="#111111"
                                         TextChanged="DescriptionBox_TextChanged"/>
                            </Grid>
                        </Border>

                        <!-- Camera/Device info -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{svgc:SvgImage Source=/icons/camera.svg, AppName=MPMS}" Width="16" Height="16" Opacity="0.6" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource InfoLabel}" Text="Камера/Устройство"/>
                                <TextBlock x:Name="CameraText" Style="{StaticResource InfoValue}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Uploaded by info -->
                        <Grid Margin="0,0,0,10" Cursor="Hand" MouseLeftButtonUp="UploadedByAvatar_Click">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="UploadedByAvatarBorder" Width="24" Height="24" CornerRadius="12" Background="#34495E" VerticalAlignment="Center">
                                <Image x:Name="UploadedByAvatarImage" Width="24" Height="24" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource InfoLabel}" Text="Загружено"/>
                                <TextBlock x:Name="UploadedByText" Style="{StaticResource InfoValue}"/>
                            </StackPanel>
                        </Grid>


                    </StackPanel>
                </ScrollViewer>

                <!-- ─── Drawing tools panel ──────────────────────────────── -->
                <Border Grid.Row="1" x:Name="DrawingToolsPanel"
                        Background="#F8F9FA"
                        BorderBrush="#E8E9EC" BorderThickness="0,1,0,0"
                        Padding="12,10">
                    <StackPanel>
                        <!-- Row 1: Drawing tools (left) + Undo/Redo (right) -->
                        <Grid Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <RadioButton x:Name="PencilBtn" Tag="Pencil" GroupName="DrawTools"
                                             Style="{StaticResource DrawToolToggleButton}"
                                             ToolTip="Карандаш" Click="SelectPencil_Click" Margin="0,0,2,0">
                                    <Grid Width="20" Height="20">
                                        <Image x:Name="PencilIconDark" Width="18" Height="18"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Source="{svgc:SvgImage Source=/icons/pencil.svg, AppName=MPMS}"
                                               Visibility="Collapsed"/>
                                        <Image x:Name="PencilIconLight" Width="18" Height="18"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Source="{svgc:SvgImage Source=/icons/pencil_white.svg, AppName=MPMS}"/>
                                    </Grid>
                                </RadioButton>
                                <RadioButton x:Name="MarkerBtn" Tag="Marker" GroupName="DrawTools"
                                             Style="{StaticResource DrawToolToggleButton}"
                                             ToolTip="Маркер" Click="SelectMarker_Click" Margin="0,0,2,0">
                                    <Grid Width="20" Height="20">
                                        <Image x:Name="MarkerIconDark" Width="18" Height="18"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Source="{svgc:SvgImage Source=/icons/marker.svg, AppName=MPMS}"/>
                                        <Image x:Name="MarkerIconLight" Width="18" Height="18"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Source="{svgc:SvgImage Source=/icons/marker_white.svg, AppName=MPMS}"
                                               Visibility="Collapsed"/>
                                    </Grid>
                                </RadioButton>
                                <RadioButton x:Name="EraserBtn" Tag="Eraser" GroupName="DrawTools"
                                             Style="{StaticResource DrawToolToggleButton}"
                                             ToolTip="Ластик" Click="SelectEraser_Click">
                                    <Grid Width="20" Height="20">
                                        <Image x:Name="EraserIconDark" Width="18" Height="18"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Source="{svgc:SvgImage Source=/icons/eraser.svg, AppName=MPMS}"/>
                                        <Image x:Name="EraserIconLight" Width="18" Height="18"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Source="{svgc:SvgImage Source=/icons/eraser_white.svg, AppName=MPMS}"
                                               Visibility="Collapsed"/>
                                    </Grid>
                                </RadioButton>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource ViewerIconBtn}" ToolTip="Отменить"
                                        Click="Undo_Click" Width="32" Height="32" Padding="0">
                                    <Image Source="{svgc:SvgImage Source=/icons/undo.svg, AppName=MPMS}" Width="16" Height="16"/>
                                </Button>
                                <Button Style="{StaticResource ViewerIconBtn}" ToolTip="Повторить"
                                        Click="Redo_Click" Width="32" Height="32" Padding="0" Margin="2,0,0,0">
                                    <Image Source="{svgc:SvgImage Source=/icons/redo.svg, AppName=MPMS}" Width="16" Height="16"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <!-- Row 2: Brush size slider -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Размер кисти" Foreground="#6B778C" FontSize="11" 
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider x:Name="BrushSizeSlider" Grid.Column="1"
                                    Minimum="1" Maximum="30" Value="3"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ZoomSliderStyle}"
                                    ValueChanged="BrushSizeSlider_ValueChanged"/>
                            <TextBlock x:Name="BrushSizeLabel" Text="3"
                                       Grid.Column="2"
                                       Foreground="#111111" FontSize="11"
                                       VerticalAlignment="Center" Margin="8,0,0,0" Width="16"/>
                        </Grid>
                        <!-- Row 3: Color palette -->
                        <UniformGrid x:Name="ColorPalettePanel"
                                   Rows="2" Columns="8"/>
                    </StackPanel>
                </Border>

                <!-- ─── Crop tools panel ─────────────────────────────────── -->
                <Border Grid.Row="2" x:Name="CropToolsPanel"
                        Background="#F8F9FA"
                        BorderBrush="#E8E9EC" BorderThickness="0,1,0,0"
                        Padding="12,10"
                        Visibility="Collapsed">
                    <StackPanel>
                        <!-- Header: Size + Reset -->
                        <Grid Margin="0,0,0,12">
                            <TextBlock x:Name="CropPanelSizeText" Text="— × —" Foreground="#111111" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Button Style="{StaticResource ViewerIconBtn}" Click="ResetCrop_Click"
                                    ToolTip="Сбросить" HorizontalAlignment="Right" Width="32" Height="32" Padding="0">
                                <Image Source="{svgc:SvgImage Source=/icons/undo.svg, AppName=MPMS}" Width="16" Height="16"/>
                            </Button>
                        </Grid>

                        <!-- Aspect ratio buttons - better organized -->
                        <TextBlock Text="Соотношение сторон" Foreground="#6B778C" FontSize="11" Margin="0,0,0,8"/>
                        <UniformGrid Rows="2" Columns="6" Margin="0,0,0,12">
                            <RadioButton Content="1:1" GroupName="AspectRatio"
                                         Style="{StaticResource AspectRatioButton}" Margin="2"
                                         Click="AspectRatioButton_Click" Tag="1:1"/>
                            <RadioButton Content="4:3" GroupName="AspectRatio"
                                         Style="{StaticResource AspectRatioButton}" Margin="2"
                                         Click="AspectRatioButton_Click" Tag="4:3"/>
                            <RadioButton Content="3:4" GroupName="AspectRatio"
                                         Style="{StaticResource AspectRatioButton}" Margin="2"
                                         Click="AspectRatioButton_Click" Tag="3:4"/>
                            <RadioButton Content="16:9" GroupName="AspectRatio"
                                         Style="{StaticResource AspectRatioButton}" Margin="2"
                                         Click="AspectRatioButton_Click" Tag="16:9"/>
                            <RadioButton Content="9:16" GroupName="AspectRatio"
                                         Style="{StaticResource AspectRatioButton}" Margin="2"
                                         Click="AspectRatioButton_Click" Tag="9:16"/>
                            <RadioButton Content="3:2" GroupName="AspectRatio"
                                         Style="{StaticResource AspectRatioButton}" Margin="2"
                                         Click="AspectRatioButton_Click" Tag="3:2"/>
                            <RadioButton Content="2:3" GroupName="AspectRatio"
                                         Style="{StaticResource AspectRatioButton}" Margin="2"
                                         Click="AspectRatioButton_Click" Tag="2:3"/>
                            <RadioButton Content="5:4" GroupName="AspectRatio"
                                         Style="{StaticResource AspectRatioButton}" Margin="2"
                                         Click="AspectRatioButton_Click" Tag="5:4"/>
                            <RadioButton Content="4:5" GroupName="AspectRatio"
                                         Style="{StaticResource AspectRatioButton}" Margin="2"
                                         Click="AspectRatioButton_Click" Tag="4:5"/>
                            <RadioButton Content="5:7" GroupName="AspectRatio"
                                         Style="{StaticResource AspectRatioButton}" Margin="2"
                                         Click="AspectRatioButton_Click" Tag="5:7"/>
                            <RadioButton Content="7:5" GroupName="AspectRatio"
                                         Style="{StaticResource AspectRatioButton}" Margin="2"
                                         Click="AspectRatioButton_Click" Tag="7:5"/>
                            <RadioButton Content="16:10" GroupName="AspectRatio"
                                         Style="{StaticResource AspectRatioButton}" Margin="2"
                                         Click="AspectRatioButton_Click" Tag="16:10"/>
                        </UniformGrid>

                        <!-- Cancel + Apply buttons - full width -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Отмена" Click="CancelCrop_Click"
                                    Style="{StaticResource ViewerIconBtn}"
                                    Margin="0,0,4,0" Padding="0,8"/>
                            <Button Grid.Column="1" Content="Применить" Click="ApplyCrop_Click"
                                    Background="#111111" Foreground="White"
                                    BorderThickness="0" Padding="0,8"
                                    FontSize="12" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#333333"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- BOTTOM BAR                                                  -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Grid.ColumnSpan="2"
                Background="White"
                BorderBrush="#E8E9EC" BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: resolution + size -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Center: zoom controls -->
                    <ColumnDefinition Width="*"/>
                    <!-- Right: action buttons (print, crop, rotate) -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{svgc:SvgImage Source=/icons/dimensions.svg, AppName=MPMS}" 
                           Width="16" Height="16" Opacity="0.6"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="ResolutionText" Text="— × —"
                               Foreground="#6B778C" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Image Source="{svgc:SvgImage Source=/icons/file_size.svg, AppName=MPMS}" 
                           Width="16" Height="16" Opacity="0.6"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="FileSizeText" Text="—"
                               Foreground="#6B778C" FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: zoom controls only -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Zoom out -->
                    <Button Style="{StaticResource ViewerIconBtn}" Click="ZoomOut_Click" Width="32" Height="32" Padding="0">
                        <Image Source="{svgc:SvgImage Source=/icons/zoom_out.svg, AppName=MPMS}" Width="16" Height="16"/>
                    </Button>
                    <!-- Zoom slider -->
                    <Slider x:Name="ZoomSlider"
                            Minimum="10" Maximum="500" Value="100"
                            Width="140" VerticalAlignment="Center" Margin="6,0"
                            Style="{StaticResource ZoomSliderStyle}"
                            ValueChanged="ZoomSlider_ValueChanged"/>
                    <!-- Zoom in -->
                    <Button Style="{StaticResource ViewerIconBtn}" Click="ZoomIn_Click" Width="32" Height="32" Padding="0">
                        <Image Source="{svgc:SvgImage Source=/icons/zoom_in.svg, AppName=MPMS}" Width="16" Height="16"/>
                    </Button>
                    <!-- Zoom text -->
                    <TextBlock x:Name="ZoomText" Text="100 %" Foreground="#6B778C"
                               FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" Width="46"/>
                </StackPanel>

                <!-- Right: action buttons with separator -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Separator -->
                    <Border Width="1" Background="#E8E9EC" Margin="0,10" Height="20"/>
                    
                    <!-- Print -->
                    <Button Style="{StaticResource ViewerIconBtn}" Click="Print_Click"
                            ToolTip="Печать" Margin="12,0,4,0" Width="32" Height="32" Padding="0">
                        <Image Source="{svgc:SvgImage Source=/icons/print.svg, AppName=MPMS}" Width="16" Height="16"/>
                    </Button>

                    <!-- Crop/Markup toggle -->
                    <Button Style="{StaticResource ViewerIconBtn}" Click="ToggleCrop_Click"
                            ToolTip="Разметка / Обрезка" Margin="0,0,4,0" Width="32" Height="32" Padding="0">
                        <Image Source="{svgc:SvgImage Source=/icons/crop.svg, AppName=MPMS}" Width="16" Height="16"/>
                    </Button>

                    <!-- Rotate separator -->
                    <Border Width="1" Background="#E8E9EC" Margin="0,10" Height="20"/>

                    <!-- Rotate CCW -->
                    <Button Style="{StaticResource ViewerIconBtn}" Click="RotateCCW_Click"
                            ToolTip="Повернуть влево" Margin="8,0,2,0" Width="32" Height="32" Padding="0">
                        <Image Source="{svgc:SvgImage Source=/icons/rotate_left.svg, AppName=MPMS}" Width="16" Height="16"/>
                    </Button>
                    <!-- Rotate CW -->
                    <Button Style="{StaticResource ViewerIconBtn}" Click="RotateCW_Click"
                            ToolTip="Повернуть вправо" Width="32" Height="32" Padding="0">
                        <Image Source="{svgc:SvgImage Source=/icons/rotate_right.svg, AppName=MPMS}" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Confirmation Overlay -->
        <Border x:Name="ConfirmPopupBorder" Background="Transparent" CornerRadius="8" Margin="0"
                Visibility="Collapsed"
                UseLayoutRounding="True" SnapsToDevicePixels="True"
                Panel.ZIndex="100">
            <Border Background="White" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="24,20" CornerRadius="12"
                    BorderBrush="#DFE1E6" BorderThickness="1" Width="260">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="4" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Сохранить изменения?" FontSize="15" FontWeight="Bold" Foreground="#111111" Margin="0,0,0,18" HorizontalAlignment="Center" TextAlignment="Center"/>

                    <Button x:Name="ConfirmSaveBtn" Style="{StaticResource BlackNoteButton}"
                            Width="Auto" Height="38" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                            Click="ConfirmSave_Click">
                        <TextBlock Text="Сохранить" FontSize="13" FontWeight="Bold"/>
                    </Button>

                    <Button x:Name="ConfirmDiscardBtn" Style="{StaticResource WhiteNoteButton}"
                            Width="Auto" Height="38" HorizontalAlignment="Stretch"
                            Click="ConfirmDiscard_Click">
                        <TextBlock Text="Не сохранять" FontSize="13" FontWeight="Bold"/>
                    </Button>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>
