<UserControl x:Class="MPMS.Views.Overlays.PhotoViewerOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>

        <!-- Dark icon button for viewer -->
        <Style x:Key="ViewerIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#B0B8C8"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2A2D35"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active tool button -->
        <Style x:Key="DrawToolBtn" TargetType="Button" BasedOn="{StaticResource ViewerIconBtn}">
            <Style.Triggers>
                <Trigger Property="Tag" Value="active">
                    <Setter Property="Background" Value="#2563EB"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Save button in info panel -->
        <Style x:Key="SaveInfoBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close ✕ circle button -->
        <Style x:Key="CloseCircleBtn" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#2A2D35" CornerRadius="14">
                            <TextBlock Text="✕" FontSize="12" Foreground="#9AA3B0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3A3D45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Zoom slider -->
        <Style x:Key="ZoomSliderStyle" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#2563EB" Height="3" CornerRadius="1.5"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="14" Height="14" Background="White"
                                                        CornerRadius="7"
                                                        BorderBrush="#2563EB" BorderThickness="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="#3A3D45" Height="3" CornerRadius="1.5"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Info row label -->
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6B778C"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#D0D6E0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

    </UserControl.Resources>

    <!-- Root: full overlay dark background -->
    <Grid Background="#1A1C22">
        <Grid.ColumnDefinitions>
            <!-- Main image area -->
            <ColumnDefinition Width="*"/>
            <!-- Info panel -->
            <ColumnDefinition Width="270"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- Bottom bar -->
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- LEFT: Image viewport                                        -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="0" Grid.Row="0">

            <!-- Viewport -->
            <Grid x:Name="ViewportGrid"
                  Background="#1A1C22"
                  ClipToBounds="True"
                  SizeChanged="ViewportGrid_SizeChanged">

                <!-- Canvas provides infinite layout space to prevent WPF clipping -->
                <Canvas x:Name="InfiniteCanvas">

                    <!-- Scale + Rotate + Pan applied here -->
                    <Grid x:Name="ImageContainer"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ImgScale" ScaleX="1" ScaleY="1"/>
                                <RotateTransform x:Name="ImgRotate" Angle="0"/>
                                <TranslateTransform x:Name="ImgTranslate" X="0" Y="0"/>
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <!-- Image — explicit W/H set from code after load -->
                        <Image x:Name="MainImage"
                               Stretch="Fill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <!-- Draw canvas — same size as image (set from code) -->
                        <Canvas x:Name="DrawCanvas"
                                Background="Transparent"
                                Cursor="Hand"
                                SizeChanged="DrawCanvas_SizeChanged"
                                MouseLeftButtonDown="DrawCanvas_MouseDown"
                                MouseMove="DrawCanvas_MouseMove"
                                MouseLeftButtonUp="DrawCanvas_MouseUp"
                                MouseWheel="DrawCanvas_MouseWheel">

                            <!-- Crop overlay -->
                            <Grid x:Name="CropOverlayGrid" Visibility="Collapsed"
                                  Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                  Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Canvas}}">
                                <Rectangle x:Name="DimTop"    Fill="#99000000" IsHitTestVisible="False"/>
                                <Rectangle x:Name="DimBottom" Fill="#99000000" IsHitTestVisible="False"/>
                                <Rectangle x:Name="DimLeft"   Fill="#99000000" IsHitTestVisible="False"/>
                                <Rectangle x:Name="DimRight"  Fill="#99000000" IsHitTestVisible="False"/>

                                <Border x:Name="CropBorder"
                                        BorderBrush="White" BorderThickness="1.5"
                                        Background="Transparent" IsHitTestVisible="False">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="8" Opacity="0.5" ShadowDepth="0"/>
                                    </Border.Effect>
                                </Border>

                                <Border x:Name="HandleTL" Width="10" Height="10" Background="White" CornerRadius="2" IsHitTestVisible="False"/>
                                <Border x:Name="HandleTR" Width="10" Height="10" Background="White" CornerRadius="2" IsHitTestVisible="False"/>
                                <Border x:Name="HandleBL" Width="10" Height="10" Background="White" CornerRadius="2" IsHitTestVisible="False"/>
                                <Border x:Name="HandleBR" Width="10" Height="10" Background="White" CornerRadius="2" IsHitTestVisible="False"/>

                                <TextBlock x:Name="CropSizeText"
                                           Foreground="White" FontSize="11"
                                           Background="#88000000" Padding="4,2"
                                           IsHitTestVisible="False"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,8"/>
                            </Grid>
                        </Canvas>
                    </Grid>
                </Canvas>
            </Grid>

        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- RIGHT: Info panel                                           -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="1" Grid.Row="0"
                Background="#1E2028"
                BorderBrush="#2A2D35" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <!-- Drawing tools below info -->
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,14,16,12">

                        <!-- Header: title + close + save -->
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Сведения" FontSize="15" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="SaveBtn" Content="Сохранить"
                                        Style="{StaticResource SaveInfoBtn}"
                                        IsEnabled="False" Margin="0,0,6,0"
                                        Click="Save_Click"/>
                                <Button Style="{StaticResource CloseCircleBtn}"
                                        Click="Close_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- File name editable -->
                        <Border Background="#252830" BorderBrush="#2A2D35" BorderThickness="1"
                                CornerRadius="6" Margin="0,0,0,12">
                            <Grid Margin="10,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FileNameBox"
                                         Background="Transparent"
                                         Foreground="White"
                                         BorderThickness="0"
                                         FontSize="13"
                                         CaretBrush="White"
                                         SelectionBrush="#2563EB"
                                         TextChanged="FileNameBox_TextChanged"/>
                                <TextBlock Grid.Column="1" Text="✎" Foreground="#6B778C"
                                           FontSize="13" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Created date -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📅" FontSize="13" VerticalAlignment="Top" Margin="0,1,0,0"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource InfoLabel}" Text="Создано"/>
                                <TextBlock x:Name="CreatedText" Style="{StaticResource InfoValue}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Modified time -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🕐" FontSize="13" VerticalAlignment="Top" Margin="0,1,0,0"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource InfoLabel}" Text="Изменено"/>
                                <TextBlock x:Name="ModifiedText" Style="{StaticResource InfoValue}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Divider -->
                        <Border Height="1" Background="#2A2D35" Margin="0,4,0,12"/>

                        <!-- Size info -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📐" FontSize="13" VerticalAlignment="Top" Margin="0,1,0,0"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource InfoLabel}" Text="Сведения о размере"/>
                                <TextBlock x:Name="ResolutionDetail" Style="{StaticResource InfoValue}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Source -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔗" FontSize="13" VerticalAlignment="Top" Margin="0,1,0,0"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource InfoLabel}" Text="Источник"/>
                                <TextBlock Text="Этот компьютер" Style="{StaticResource InfoValue}"/>
                            </StackPanel>
                        </Grid>

                        <!-- File path -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📁" FontSize="13" VerticalAlignment="Top" Margin="0,1,0,0"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Style="{StaticResource InfoLabel}" Text="Путь к файлу"/>
                                <TextBlock x:Name="PathText" Style="{StaticResource InfoValue}"
                                           FontSize="11"/>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>

                <!-- ─── Drawing tools panel ──────────────────────────────── -->
                <Border Grid.Row="1" x:Name="DrawingToolsPanel"
                        Background="#16181F"
                        BorderBrush="#2A2D35" BorderThickness="0,1,0,0"
                        Padding="10,10">
                    <StackPanel>
                        <!-- Row 1: Brush size slider -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="BrushSizeSlider"
                                    Minimum="1" Maximum="30" Value="3"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ZoomSliderStyle}"
                                    ValueChanged="BrushSizeSlider_ValueChanged"/>
                            <TextBlock x:Name="BrushSizeLabel" Text="3"
                                       Grid.Column="1"
                                       Foreground="White" FontSize="11"
                                       VerticalAlignment="Center" Margin="8,0,0,0" Width="14"/>
                        </Grid>
                        <!-- Row 2: Color palette -->
                        <WrapPanel x:Name="ColorPalettePanel"
                                   Orientation="Horizontal" Margin="0,0,0,8"/>
                        <!-- Row 3: Tools + Undo/Redo -->
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button x:Name="PencilBtn" Style="{StaticResource DrawToolBtn}"
                                        ToolTip="Карандаш" Click="SelectPencil_Click" Margin="0,0,2,0">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" FontSize="16"/>
                                </Button>
                                <Button x:Name="MarkerBtn" Style="{StaticResource DrawToolBtn}"
                                        ToolTip="Маркер" Click="SelectMarker_Click" Margin="0,0,2,0">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEDAE;" FontSize="16"/>
                                </Button>
                                <Button x:Name="EraserBtn" Style="{StaticResource DrawToolBtn}"
                                        ToolTip="Ластик" Click="SelectEraser_Click">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE75C;" FontSize="16"/>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource ViewerIconBtn}" ToolTip="Отменить"
                                        Click="Undo_Click">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7A7;" FontSize="16"/>
                                </Button>
                                <Button Style="{StaticResource ViewerIconBtn}" ToolTip="Повторить"
                                        Click="Redo_Click">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7A6;" FontSize="16"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ─── Crop tools panel ─────────────────────────────────── -->
                <Border Grid.Row="2" x:Name="CropToolsPanel"
                        Background="#16181F"
                        BorderBrush="#2A2D35" BorderThickness="0,1,0,0"
                        Padding="10,8"
                        Visibility="Collapsed">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Style="{StaticResource ViewerIconBtn}" Click="ResetCrop_Click"
                                    ToolTip="Сбросить" Margin="0,0,4,0">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE777;" FontSize="15"/>
                            </Button>
                            <TextBlock Text="Свободно" Foreground="#6B778C" FontSize="12"
                                       VerticalAlignment="Center" Margin="8,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Отмена" Click="CancelCrop_Click"
                                    Style="{StaticResource ViewerIconBtn}"
                                    Foreground="#9AA3B0" Margin="0,0,6,0" Padding="10,6"/>
                            <Button Content="Применить" Click="ApplyCrop_Click"
                                    Background="#2563EB" Foreground="White"
                                    BorderThickness="0" Padding="10,6"
                                    FontSize="12" FontWeight="SemiBold" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- BOTTOM BAR                                                  -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Grid.ColumnSpan="2"
                Background="#16181F"
                BorderBrush="#2A2D35" BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: resolution + size -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Center: zoom + print + crop -->
                    <ColumnDefinition Width="*"/>
                    <!-- Right: rotate buttons -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7C5;"
                               Foreground="#6B778C" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="ResolutionText" Text="— × —"
                               Foreground="#6B778C" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7EF;"
                               Foreground="#6B778C" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="FileSizeText" Text="—"
                               Foreground="#6B778C" FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: zoom slider + label + print + crop -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Zoom out -->
                    <Button Style="{StaticResource ViewerIconBtn}" Click="ZoomOut_Click" Padding="5">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71F;" FontSize="14"/>
                    </Button>
                    <!-- Zoom slider -->
                    <Slider x:Name="ZoomSlider"
                            Minimum="10" Maximum="500" Value="100"
                            Width="120" VerticalAlignment="Center" Margin="4,0"
                            Style="{StaticResource ZoomSliderStyle}"
                            ValueChanged="ZoomSlider_ValueChanged"/>
                    <!-- Zoom in -->
                    <Button Style="{StaticResource ViewerIconBtn}" Click="ZoomIn_Click" Padding="5">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A3;" FontSize="14"/>
                    </Button>
                    <!-- Zoom text -->
                    <TextBlock x:Name="ZoomText" Text="100 %" Foreground="#9AA3B0"
                               FontSize="12" VerticalAlignment="Center" Margin="8,0,20,0" Width="46"/>

                    <!-- Separator -->
                    <Border Width="1" Background="#2A2D35" Margin="0,10" Height="20"/>

                    <!-- Print -->
                    <Button Style="{StaticResource ViewerIconBtn}" Click="Print_Click"
                            ToolTip="Печать" Margin="12,0,4,0">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE749;" FontSize="16"/>
                    </Button>

                    <!-- Crop/Markup toggle -->
                    <Button Style="{StaticResource ViewerIconBtn}" Click="ToggleCrop_Click"
                            ToolTip="Разметка / Обрезка" Margin="4,0,0,0">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7A8;" FontSize="16"/>
                    </Button>
                </StackPanel>

                <!-- Right: rotate -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ViewerIconBtn}" Click="RotateCCW_Click"
                            ToolTip="Повернуть влево" Margin="0,0,2,0">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE935;" FontSize="17"/>
                    </Button>
                    <Button Style="{StaticResource ViewerIconBtn}" Click="RotateCW_Click"
                            ToolTip="Повернуть вправо">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE934;" FontSize="17"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
