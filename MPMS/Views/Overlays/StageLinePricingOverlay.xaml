<UserControl x:Class="MPMS.Views.Overlays.StageLinePricingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <UserControl.Resources>
        <Style x:Key="OverlayQtyBtn" TargetType="Button" BasedOn="{StaticResource OutlineBtn}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="OverlayQtyBox" TargetType="TextBox">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D0D4DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="CaretBrush" Value="#111111"/>
            <Setter Property="SelectionBrush" Value="{StaticResource NeutralSelectionBrush}"/>
            <Setter Property="SelectionTextBrush" Value="#111111"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#111111"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#111111"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,18"
                BorderBrush="#E8E9EC" BorderThickness="0,0,0,1" Background="White">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Позиция этапа"
                               FontSize="20" FontWeight="Bold" Foreground="#000000"/>
                    <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="#6B778C" Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="Cancel_Click" Width="32" Height="32">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="#F4F5F7" CornerRadius="16">
                                <TextBlock Text="✕" FontSize="14" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="#6B778C"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#E8E9EC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,8">
                <Border Background="#F4F5F7" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Базовая цена" FontSize="11" Foreground="#6B778C"/>
                            <TextBlock x:Name="BasePriceText" FontSize="16" FontWeight="SemiBold" Foreground="#000000"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="Итого за позицию" FontSize="11" Foreground="#6B778C" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="PreviewTotalText" FontSize="16" FontWeight="Bold" Foreground="#000000" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Количество" Style="{StaticResource FormLabel}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                    <Button Content="−" Style="{StaticResource OverlayQtyBtn}" Click="DecQty_Click"/>
                    <TextBox x:Name="QuantityBox" Style="{StaticResource OverlayQtyBox}" Margin="6,0"
                             TextChanged="QuantityBox_TextChanged"/>
                    <Button Content="+" Style="{StaticResource OverlayQtyBtn}" Click="IncQty_Click"/>
                </StackPanel>
                <TextBlock x:Name="StockInfoText" FontSize="11" Foreground="#6B778C" Margin="0,0,0,16" Visibility="Collapsed"/>

                <TextBlock Text="Скидка / наценка" Style="{StaticResource FormLabel}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="-5%" Click="Discount5_Click" Style="{StaticResource OutlineBtn}" Padding="10,4" Margin="0,0,6,0"/>
                    <Button Content="-10%" Click="Discount10_Click" Style="{StaticResource OutlineBtn}" Padding="10,4" Margin="0,0,6,0"/>
                    <Button Content="+5%" Click="Markup5_Click" Style="{StaticResource OutlineBtn}" Padding="10,4" Margin="0,0,6,0"/>
                    <Button Content="+10%" Click="Markup10_Click" Style="{StaticResource OutlineBtn}" Padding="10,4"/>
                </StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="White" BorderBrush="#DFE1E6" BorderThickness="1"
                            CornerRadius="8" Padding="12,10" Height="42">
                        <TextBox x:Name="PercentBox" BorderThickness="0" Background="Transparent"
                                 Foreground="#000000" FontSize="13" VerticalContentAlignment="Center"
                                 Padding="0" TextChanged="PercentBox_TextChanged"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="%" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#6B778C"/>
                </Grid>

                <TextBlock Text="Новая цена за единицу" Style="{StaticResource FormLabel}"/>
                <Border Background="White" BorderBrush="#DFE1E6" BorderThickness="1"
                        CornerRadius="8" Padding="12,10" Margin="0,0,0,12" Height="42">
                    <TextBox x:Name="PriceBox" BorderThickness="0" Background="Transparent"
                             Foreground="#000000" FontSize="13" VerticalContentAlignment="Center"
                             Padding="0" TextChanged="PriceBox_TextChanged"/>
                </Border>

                <TextBlock Text="Изменения действуют только в рамках этого этапа и не меняют данные в каталоге."
                           FontSize="11" Foreground="#6B778C" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <Button Content="Сбросить цену" Click="Reset_Click"
                        Style="{StaticResource OutlineBtn}" HorizontalAlignment="Left" Padding="12,6"/>

                <Border x:Name="ErrorPanel" Background="#FFF0F0"
                        CornerRadius="8" Padding="14,10"
                        Margin="0,12,0,0" Visibility="Collapsed"
                        BorderBrush="#FCA5A5" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" FontSize="13" Margin="0,0,8,0"
                                   Foreground="#DC2626" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ErrorText" FontSize="12" Foreground="#DC2626"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="24,14"
                BorderBrush="#E8E9EC" BorderThickness="0,1,0,0"
                Background="White">
            <Grid>
                <Button Content="Отмена" HorizontalAlignment="Left"
                        Click="Cancel_Click" Style="{StaticResource OutlineBtn}"/>
                <Button Content="Сохранить"
                        HorizontalAlignment="Right"
                        Click="Save_Click" Style="{StaticResource BlackBtn}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
