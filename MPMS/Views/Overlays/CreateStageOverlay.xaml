<UserControl x:Class="MPMS.Views.Overlays.CreateStageOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8993A4"/>
            <Setter Property="Margin" Value="0,20,0,10"/>
        </Style>

        <Style x:Key="UserPickerItem" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,18"
                BorderBrush="#E8E9EC" BorderThickness="0,0,0,1" Background="White">
            <Grid>
                <StackPanel>
                    <TextBlock x:Name="TitleLabel" Text="Создать этап"
                               FontSize="20" FontWeight="Bold" Foreground="#000000"/>
                    <TextBlock x:Name="SubtitleLabel" Text="Добавьте этап для отслеживания выполнения"
                               FontSize="12" Foreground="#6B778C" Margin="0,4,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="Cancel_Click" Width="32" Height="32">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="#F4F5F7" CornerRadius="16">
                                <TextBlock Text="&#x2715;" FontSize="14" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="#6B778C"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#E8E9EC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24,8,24,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="ОСНОВНАЯ ИНФОРМАЦИЯ" Style="{StaticResource SectionHeader}"/>

                    <TextBlock Text="Название этапа *" Style="{StaticResource FormLabel}"/>
                    <Border Background="White" BorderBrush="#DFE1E6" BorderThickness="1"
                            CornerRadius="8" Padding="12,10" Margin="0,0,0,12" Height="42">
                        <TextBox x:Name="NameBox" BorderThickness="0" Background="Transparent"
                                 Foreground="#000000" FontSize="13" VerticalContentAlignment="Center"
                                 Padding="0"/>
                    </Border>

                    <TextBlock Text="Описание" Style="{StaticResource FormLabel}"/>
                    <Border Background="White" BorderBrush="#DFE1E6" BorderThickness="1"
                            CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                        <TextBox x:Name="DescriptionBox" BorderThickness="0" Background="Transparent"
                                 Foreground="#000000" FontSize="13"
                                 Height="76" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalContentAlignment="Top" Padding="0"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Border>

                    <TextBlock Text="Срок выполнения *" Style="{StaticResource FormLabel}"/>
                    <DatePicker x:Name="DueDatePicker" Height="42" FontSize="13" Margin="0,0,0,12"/>

                    <StackPanel x:Name="StatusRow" Visibility="Collapsed" Margin="0,0,0,12">
                        <TextBlock Text="Статус" Style="{StaticResource FormLabel}"/>
                        <ComboBox x:Name="StatusCombo" Style="{StaticResource FormCombo}" Height="42">
                            <ComboBoxItem Content="Запланирован" Tag="Planned"/>
                            <ComboBoxItem Content="Выполняется" Tag="InProgress"/>
                            <ComboBoxItem Content="Завершён" Tag="Completed"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel x:Name="ProjectRow" Visibility="Collapsed" Margin="0,0,0,12">
                        <TextBlock Text="Проект *" Style="{StaticResource FormLabel}"/>
                        <ComboBox x:Name="ProjectCombo" Style="{StaticResource FormCombo}"
                                  Height="42" Margin="0,0,0,12"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectionChanged="ProjectCombo_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel x:Name="TaskRow" Visibility="Collapsed" Margin="0,0,0,12">
                        <TextBlock Text="Задача *" Style="{StaticResource FormLabel}"/>
                        <ComboBox x:Name="TaskCombo" Style="{StaticResource FormCombo}"
                                  Height="42"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectionChanged="TaskCombo_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel x:Name="ProjectReadOnlyRow" Visibility="Collapsed" Margin="0,0,0,12">
                        <TextBlock Text="Проект" Style="{StaticResource FormLabel}"/>
                        <Border Background="#F8F9FA" BorderBrush="#DFE1E6" BorderThickness="1"
                                CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                            <TextBlock x:Name="ProjectReadOnlyText" Foreground="#6B778C"/>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="TaskReadOnlyRow" Visibility="Collapsed" Margin="0,0,0,12">
                        <TextBlock Text="Задача" Style="{StaticResource FormLabel}"/>
                        <Border Background="#F8F9FA" BorderBrush="#DFE1E6" BorderThickness="1"
                                CornerRadius="8" Padding="12,10">
                            <TextBlock x:Name="TaskReadOnlyText" Foreground="#6B778C"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Background="#E8E9EC" Width="1" Margin="0,20,0,0"/>

                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                    <TextBlock Text="ИСПОЛНИТЕЛИ" Style="{StaticResource SectionHeader}"/>

                    <Border x:Name="NoTaskHint" Background="#FFFBEB" CornerRadius="8"
                            Padding="12,10" Margin="0,0,0,12"
                            BorderBrush="#FCD34D" BorderThickness="1">
                        <TextBlock x:Name="NoTaskHintText"
                                   Text="Выберите задачу, чтобы увидеть доступных исполнителей"
                                   FontSize="12" Foreground="#92400E" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock x:Name="ForemanSectionTitle" Text="Прорабы" FontSize="11" FontWeight="SemiBold"
                               Foreground="#166534" Margin="0,0,0,6" Visibility="Collapsed"/>
                    <Border x:Name="ForemanPickerBorder" Background="White" BorderBrush="#DFE1E6"
                            BorderThickness="1" CornerRadius="8" MaxHeight="180"
                            Visibility="Collapsed" Margin="0,0,0,10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      PreviewMouseWheel="NestedScrollViewer_PreviewMouseWheel">
                            <StackPanel>
                                <ItemsControl x:Name="ForemanPickerList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Tag="{Binding}" MouseLeftButtonDown="ForemanItem_Click">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource UserPickerItem}">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#F8F9FA"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Style="{StaticResource AvatarCircle32}"
                                                                Background="{Binding AvatarBrush}"
                                                                Margin="0,0,10,0">
                                                            <Grid>
                                                                <Image Style="{StaticResource AvatarImage}"
                                                                       Source="{Binding AvatarData, Converter={StaticResource AvatarBytesToImage}}"
                                                                       Width="32" Height="32"
                                                                       Visibility="{Binding AvatarData, Converter={StaticResource NullToVis}}"/>
                                                                <TextBlock Text="{Binding Initials}"
                                                                           FontSize="11" FontWeight="Bold"
                                                                           Foreground="White"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Visibility="{Binding AvatarData, Converter={StaticResource NullToVisInv}}"/>
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="#000000"/>
                                                            <TextBlock Text="{Binding RoleSubtitle}"
                                                                       FontSize="11"
                                                                       Foreground="{Binding RoleSubtitleBrush}"
                                                                       Visibility="{Binding RoleSubtitleVis}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Border Width="22" Height="22" CornerRadius="11"
                                                            Background="#111111"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsSelectedVis}">
                                                        <TextBlock Text="&#x2713;" FontSize="10" Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="NoForemenHint"
                                           Text="В задаче нет назначенных прорабов"
                                           FontSize="12" Foreground="#97A0AF"
                                           HorizontalAlignment="Center"
                                           Margin="0,12,0,12" Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <TextBlock x:Name="WorkerSectionTitle" Text="Работники" FontSize="11" FontWeight="SemiBold"
                               Foreground="#92400E" Margin="0,0,0,6" Visibility="Collapsed"/>
                    <Border x:Name="WorkerPickerBorder" Background="White" BorderBrush="#DFE1E6"
                            BorderThickness="1" CornerRadius="8" MaxHeight="220"
                            Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      PreviewMouseWheel="NestedScrollViewer_PreviewMouseWheel">
                            <StackPanel>
                                <ItemsControl x:Name="WorkerPickerList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Tag="{Binding}" MouseLeftButtonDown="WorkerItem_Click">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource UserPickerItem}">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#F8F9FA"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Style="{StaticResource AvatarCircle32}"
                                                                Background="{Binding AvatarBrush}"
                                                                Margin="0,0,10,0">
                                                            <Grid>
                                                                <Image Style="{StaticResource AvatarImage}"
                                                                       Source="{Binding AvatarData, Converter={StaticResource AvatarBytesToImage}}"
                                                                       Width="32" Height="32"
                                                                       Visibility="{Binding AvatarData, Converter={StaticResource NullToVis}}"/>
                                                                <TextBlock Text="{Binding Initials}"
                                                                           FontSize="11" FontWeight="Bold"
                                                                           Foreground="White"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Visibility="{Binding AvatarData, Converter={StaticResource NullToVisInv}}"/>
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="#000000"/>
                                                            <TextBlock Text="{Binding RoleSubtitle}"
                                                                       FontSize="11"
                                                                       Foreground="{Binding RoleSubtitleBrush}"
                                                                       Visibility="{Binding RoleSubtitleVis}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Border Width="22" Height="22" CornerRadius="11"
                                                            Background="#111111"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsSelectedVis}">
                                                        <TextBlock Text="&#x2713;" FontSize="10" Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="NoWorkersHint"
                                           Text="В задаче нет назначенных работников"
                                           FontSize="12" Foreground="#97A0AF"
                                           HorizontalAlignment="Center"
                                           Margin="0,12,0,12" Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="24,14"
                BorderBrush="#E8E9EC" BorderThickness="0,1,0,0"
                Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Отмена" HorizontalAlignment="Left"
                        Click="Cancel_Click" Style="{StaticResource OutlineBtn}"/>
                <Border x:Name="ErrorPanel" Grid.Column="1"
                        Background="#FFF0F0" BorderBrush="#FCA5A5" BorderThickness="1"
                        CornerRadius="8" Padding="12,8" Margin="16,0"
                        MaxWidth="520" Visibility="Collapsed"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <TextBlock x:Name="ErrorText" FontSize="12" Foreground="#DC2626"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </Border>
                <Button Grid.Column="2" x:Name="SaveButton" Content="Создать этап"
                        HorizontalAlignment="Right"
                        Click="Save_Click" Style="{StaticResource BlackBtn}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
