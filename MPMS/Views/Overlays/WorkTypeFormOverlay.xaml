<UserControl x:Class="MPMS.Views.Overlays.WorkTypeFormOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d"
             Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,18"
                BorderBrush="#E8E9EC" BorderThickness="0,0,0,1" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="HeaderArticleLine" Grid.Row="0"
                           FontSize="11" Foreground="#A8B0BC"
                           Margin="0,0,0,8" Visibility="Collapsed"/>
                <StackPanel Grid.Row="1">
                    <TextBlock x:Name="TitleText" Text="Новый вид работ"
                               FontSize="20" FontWeight="Bold" Foreground="#000000"/>
                    <TextBlock x:Name="SubtitleText" Text="Заполните данные о виде работ"
                               FontSize="12" Foreground="#6B778C" Margin="0,4,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="Cancel_Click" Width="32" Height="32">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="#F4F5F7" CornerRadius="16">
                                <TextBlock Text="✕" FontSize="14" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="#6B778C"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#E8E9EC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <Border x:Name="ErrorPanel" Grid.Row="1" Background="#FFF0F0"
                CornerRadius="8" Padding="14,10"
                Margin="24,12,24,0" Visibility="Collapsed"
                BorderBrush="#FCA5A5" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠" FontSize="13" Margin="0,0,8,0"
                           Foreground="#DC2626" VerticalAlignment="Center"/>
                <TextBlock x:Name="ErrorText" FontSize="12" Foreground="#DC2626"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,12,24,8">
                <TextBlock Text="Название *" Style="{StaticResource FormLabel}"/>
                <Border Background="White" BorderBrush="#DFE1E6" BorderThickness="1"
                        CornerRadius="8" Padding="12,10" Margin="0,0,0,12" Height="42">
                    <TextBox x:Name="NameInput" BorderThickness="0" Background="Transparent"
                             Foreground="#000000" FontSize="13" VerticalContentAlignment="Center"
                             Padding="0"/>
                </Border>

                <TextBlock Text="Категория *" Style="{StaticResource FormLabel}"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="CategoryCombo" Grid.Column="0" Style="{StaticResource FormCombo}"
                              Height="42" DisplayMemberPath="Name" SelectedValuePath="Id"
                              Margin="0,0,0,0"/>
                    <Button Grid.Column="2" Click="AddCategory_Click"
                            Height="42" MinWidth="42" Padding="11,0"
                            VerticalAlignment="Top"
                            Style="{StaticResource OutlineBtn}">
                        <Image Source="{svgc:SvgImage Source=/icons/plus_black.svg, AppName=MPMS}"
                               Width="14" Height="14"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Button>
                </Grid>

                <TextBlock Text="Цена (₽) *" Style="{StaticResource FormLabel}"/>
                <Border Background="White" BorderBrush="#DFE1E6" BorderThickness="1"
                        CornerRadius="8" Padding="12,10" Height="42" Margin="0,0,0,12">
                    <TextBox x:Name="PriceInput" BorderThickness="0" Background="Transparent"
                             Foreground="#000000" FontSize="13" VerticalContentAlignment="Center"
                             Padding="0" Text="0,00"/>
                </Border>

                <TextBlock Text="Описание" Style="{StaticResource FormLabel}"/>
                <Border Background="White" BorderBrush="#DFE1E6" BorderThickness="1"
                        CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                    <TextBox x:Name="DescriptionInput" BorderThickness="0" Background="Transparent"
                             Foreground="#000000" FontSize="13" TextWrapping="Wrap"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             Height="80" Padding="0"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Padding="24,14"
                BorderBrush="#E8E9EC" BorderThickness="0,1,0,0"
                Background="White">
            <Grid>
                <Button Content="Отмена" HorizontalAlignment="Left"
                        Click="Cancel_Click" Style="{StaticResource OutlineBtn}"/>
                <Button x:Name="SaveButton" Content="Сохранить"
                        HorizontalAlignment="Right"
                        Click="Save_Click" Style="{StaticResource BlackBtn}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
