<UserControl x:Class="MPMS.Views.Overlays.StageDetailOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:MPMS.Infrastructure"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             Background="#F8F9FA">

    <UserControl.Resources>
        <ControlTemplate x:Key="SlimProgressBar" TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                <Border x:Name="PART_Track" CornerRadius="4">
                    <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                            HorizontalAlignment="Left" CornerRadius="4"/>
                </Border>
            </Border>
        </ControlTemplate>

        <Style x:Key="OutlineBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#DFE1E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F4F5F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BlackBtn" TargetType="Button">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#EF4444"/>
            <Setter Property="BorderBrush" Value="#FFBDAD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FEF2F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> 
            <RowDefinition Height="*"/>     
            <RowDefinition Height="Auto"/> 
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="20,16"
                BorderBrush="#E8E9EC" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="StatusBadge" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="6" Height="6" CornerRadius="3"
                                    Background="White" Opacity="0.8"
                                    Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" FontSize="11" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                            Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1"
                            x:Name="HeaderOverdueBadge" Visibility="Collapsed">
                        <TextBlock Text="Просрочено" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#DC2626" VerticalAlignment="Center"/>
                    </Border>
                    <Border CornerRadius="6" Padding="8,4" Background="#F4F5F7" VerticalAlignment="Center" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Задача: " FontSize="11" Foreground="#8993A4"/>
                            <TextBlock x:Name="TaskNameText" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#000000" MaxWidth="140"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Button HorizontalAlignment="Right" Click="Close_Click"
                        Width="32" Height="32" ToolTip="Закрыть">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="#F4F5F7" CornerRadius="16">
                                <TextBlock Text="✕" FontSize="14" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="#6B778C"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#E8E9EC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Background="White" Padding="20,16,20,16"
                        BorderBrush="#E8E9EC" BorderThickness="0,0,0,1" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" MinWidth="0">
                            <TextBlock Text="ЭТАП" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#8993A4" Margin="0,0,0,4"/>
                            <TextBlock x:Name="StageNameText" FontSize="22" FontWeight="Bold"
                                       Foreground="#000000" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel x:Name="StageDueDatePanel" Grid.Column="1"
                                    VerticalAlignment="Top" HorizontalAlignment="Right"
                                    Margin="16,0,0,0" Visibility="Collapsed">
                            <TextBlock Text="СРОК ВЫПОЛНЕНИЯ" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#8993A4" Margin="0,0,0,8"/>
                            <TextBlock x:Name="StageDueDateLongText" FontSize="15" FontWeight="Bold"
                                       Foreground="#000000" Margin="0,0,0,2" TextAlignment="Right"/>
                            <TextBlock x:Name="StageDueDayNameText" FontSize="12" Foreground="#6B778C"
                                       TextAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="DeletionWarningBorder" CornerRadius="8" Padding="14,10"
                        Background="#FEF2F2" BorderBrush="#FFBDAD" BorderThickness="1"
                        Margin="16,0,16,12" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Top"
                                   Foreground="#DC2626"/>
                        <StackPanel>
                            <TextBlock Text="Пометка удаления" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#DC2626"/>
                            <TextBlock x:Name="DeletionHintText" FontSize="12" Foreground="#DC2626"
                                       Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Margin="16,0,16,16">


                    <Border Background="White" CornerRadius="10" Padding="16"
                            BorderBrush="#E8E9EC" BorderThickness="1" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ОПИСАНИЕ" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#8993A4" Margin="0,0,0,8"/>
                            <TextBlock x:Name="DescriptionText" FontSize="13" Foreground="#6B778C"
                                       TextWrapping="Wrap" LineHeight="22"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="10" Padding="16"
                            BorderBrush="#E8E9EC" BorderThickness="1" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ИСПОЛНИТЕЛИ" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#8993A4" Margin="0,0,0,8"/>

                            <ItemsControl x:Name="AssigneesList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,12,8">
                                            <Button Style="{StaticResource PeekRowButton}"
                                                    Visibility="{Binding IsUserPeekInteractive, Converter={StaticResource BoolToVis}}"
                                                    Click="AssigneePeek_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Style="{StaticResource AvatarCircle30}"
                                                            Background="#92400E" Margin="0,0,8,0">
                                                        <Grid>
                                                            <Image Style="{StaticResource AvatarImage}"
                                                                   Source="{Binding AvatarData, Converter={StaticResource AvatarBytesToImage}}"
                                                                   Width="30" Height="30"
                                                                   Visibility="{Binding AvatarData, Converter={StaticResource NullToVis}}"/>
                                                            <TextBlock Text="{Binding Initials}"
                                                                       FontSize="10" FontWeight="Bold"
                                                                       Foreground="White"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="{Binding AvatarData, Converter={StaticResource NullToVisInv}}"/>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding UserName}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="#000000"/>
                                                        <TextBlock Text="{Binding SubRoleLabel}"
                                                                   FontSize="10" Foreground="{Binding SubRoleLabelBrush}"
                                                                   Visibility="{Binding SubRoleLabelVis}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding IsUserPeekInteractive, Converter={StaticResource BoolToVisInv}}">
                                                <Border Style="{StaticResource AvatarCircle30}"
                                                        Background="#92400E" Margin="0,0,8,0">
                                                    <Grid>
                                                        <Image Style="{StaticResource AvatarImage}"
                                                               Source="{Binding AvatarData, Converter={StaticResource AvatarBytesToImage}}"
                                                               Width="30" Height="30"
                                                               Visibility="{Binding AvatarData, Converter={StaticResource NullToVis}}"/>
                                                        <TextBlock Text="{Binding Initials}"
                                                                   FontSize="10" FontWeight="Bold"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding AvatarData, Converter={StaticResource NullToVisInv}}"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding UserName}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="#000000"/>
                                                    <TextBlock Text="{Binding SubRoleLabel}"
                                                               FontSize="10" Foreground="{Binding SubRoleLabelBrush}"
                                                               Visibility="{Binding SubRoleLabelVis}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="NoAssigneesText" Text="Не назначено"
                                       FontSize="12" Foreground="#97A0AF"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="10" Padding="16"
                            BorderBrush="#E8E9EC" BorderThickness="1" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ВИДЫ РАБОТ" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#8993A4" Margin="0,0,0,8"/>

                            <ItemsControl x:Name="WorkTypesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#FAFBFC" BorderBrush="#DFE1E6" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#F4F5F7" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Quantity, StringFormat={}{0:N2}}" FontWeight="SemiBold" Foreground="#000000"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding WorkTypeName}" FontWeight="SemiBold" Foreground="#000000" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Итого" FontSize="10" Foreground="#8993A4" TextAlignment="Right"/>
                                                    <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#000000" TextAlignment="Right">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{x:Static infra:QuantityPriceMultiplierConverter.Instance}" StringFormat="{}{0:N2} ₽">
                                                                <Binding Path="Quantity"/>
                                                                <Binding Path="PricePerUnit"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Text="{Binding Unit}" FontSize="12" Foreground="#6B778C" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel x:Name="NoWorkTypesState" Visibility="Collapsed"
                                        HorizontalAlignment="Center" Margin="0,8,0,0">
                                <Image Source="{svgc:SvgImage Source=/icons/list.svg, AppName=MPMS}"
                                       Width="28" Height="28" Opacity="0.25"
                                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Виды работ не добавлены" FontSize="12"
                                           Foreground="#97A0AF" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="20,14" Background="White"
                BorderBrush="#E8E9EC" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="ChangeStatusBtn" Click="ChangeStatus_Click"
                            Style="{StaticResource OutlineBtn}" Margin="0,0,8,0">
                        <TextBlock Text="Сменить статус" Foreground="#000000" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="MarkDeletionBtn" Click="MarkDeletion_Click"
                            Style="{StaticResource DangerBtn}">
                        <TextBlock x:Name="MarkDeletionBtnText" Text="Пометить к удалению"
                                   Foreground="#EF4444" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="OpenDetailPageBtn" Click="OpenDetailPage_Click"
                            Style="{StaticResource OutlineBtn}" Margin="0,0,8,0">
                        <TextBlock Text="Открыть детали" Foreground="#000000" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="EditButton" HorizontalAlignment="Right"
                            Click="Edit_Click" Style="{StaticResource BlackBtn}">
                        <TextBlock Text="Редактировать" Foreground="White"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
