<UserControl x:Class="MPMS.Views.Overlays.TaskDetailOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:MPMS.Infrastructure"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/">

    <UserControl.Resources>
        <ControlTemplate x:Key="SlimProgressBar" TargetType="ProgressBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="2">
                <Border x:Name="PART_Track" CornerRadius="2">
                    <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                            HorizontalAlignment="Left" CornerRadius="2"/>
                </Border>
            </Border>
        </ControlTemplate>

        <Style x:Key="OutlineBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#DFE1E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F4F5F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#EF4444"/>
            <Setter Property="BorderBrush" Value="#FFBDAD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FEF2F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BlackBtn" TargetType="Button">
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  
            <RowDefinition Height="*"/>     
            <RowDefinition Height="Auto"/>   
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,16"
                BorderBrush="#E8E9EC" BorderThickness="0,0,0,1" Background="White">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="StatusBadge" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{Binding Task.Status, Converter={StaticResource TaskStatusToBrush}}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Task.EffectiveTaskMarkedForDeletion}" Value="True">
                                        <Setter Property="Background" Value="#EF4444"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="6" Height="6" CornerRadius="3"
                                    Background="White" Opacity="0.8"
                                    Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Task.Status, Converter={StaticResource TaskStatusToString}}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Task.EffectiveTaskMarkedForDeletion}" Value="True">
                                                <Setter Property="Text" Value="Пометка удаления"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="6" Padding="10,5"
                            BorderThickness="1.5"
                            BorderBrush="{Binding Task.Priority, Converter={StaticResource PriorityToBrush}}">
                        <TextBlock Text="{Binding Task.Priority, Converter={StaticResource PriorityToString}}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{Binding Task.Priority, Converter={StaticResource PriorityToBrush}}"/>
                    </Border>

                    <Border CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                            Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1"
                            Visibility="{Binding Task.IsOverdue, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Просрочена" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#DC2626" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <Button HorizontalAlignment="Right" Click="Close_Click"
                        Width="32" Height="32"
                        ToolTip="Закрыть">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="#F4F5F7" CornerRadius="16">
                                <TextBlock Text="✕" FontSize="14" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="#6B778C"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#E8E9EC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,16">

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Task.Name}"
                               FontSize="20" FontWeight="Bold"
                               Foreground="#000000"
                               TextWrapping="Wrap"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="12,0,0,0">
                        <TextBlock FontSize="15" FontWeight="Bold" Foreground="#000000"
                                   Text="{Binding Task.DueDate, Converter={StaticResource DateOnlyToString}, ConverterParameter=long}"
                                   TextAlignment="Right"/>
                        <TextBlock FontSize="12" Foreground="#6B778C"
                                   Text="{Binding Task.DueDate, Converter={StaticResource DateOnlyToString}, ConverterParameter=dayname}"
                                   TextAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding Task.Description}"
                           FontSize="13" Foreground="#6B778C"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"
                           Visibility="{Binding Task.Description, Converter={StaticResource StringToVis}}"/>

                <Border Background="#DFE1E6" Height="1" Margin="0,0,0,16"/>

                <Grid Margin="0,0,0,10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ПРОГРЕСС ВЫПОЛНЕНИЯ"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="#8993A4" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Task.CompletedStages}"
                                       FontSize="13" Foreground="#6B778C"/>
                            <TextBlock Text=" из " FontSize="13" Foreground="#6B778C"/>
                            <TextBlock Text="{Binding Task.TotalStages}"
                                       FontSize="13" Foreground="#6B778C"/>
                            <TextBlock Text=" этапов" FontSize="13" Foreground="#6B778C"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding Task.ProgressPercent, StringFormat='{}{0}%'}"
                               FontSize="32" FontWeight="Bold"
                               Foreground="#000000"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
                <ProgressBar Value="{Binding Task.ProgressPercent, Mode=OneWay}"
                             Maximum="100" Height="10" Margin="0,0,0,8"
                             Background="#EEF0F3"
                             Foreground="{Binding Task.ProgressPercent, Converter={StaticResource ProgressPercentToBrush}}"
                             Template="{StaticResource SlimProgressBar}"/>

                <Border Background="#DFE1E6" Height="1" Margin="0,0,0,16"/>

                <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="ИСПОЛНИТЕЛИ" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#8993A4" Margin="0,0,0,8"/>

                        <StackPanel x:Name="ForemenSection" Margin="0,0,0,8" Visibility="Collapsed">
                            <TextBlock Text="Прорабы" FontSize="11" FontWeight="SemiBold" Foreground="#166534" Margin="0,0,0,6"/>
                            <ItemsControl x:Name="ForemenDisplay">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,12,8">
                                            <Button Style="{StaticResource PeekRowButton}"
                                                    Visibility="{Binding IsUserPeekInteractive, Converter={StaticResource BoolToVis}}"
                                                    Click="AssigneePeek_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Style="{StaticResource AvatarCircle30}"
                                                            Background="#166534" Margin="0,0,8,0">
                                                        <Grid>
                                                            <Image Style="{StaticResource AvatarImage}"
                                                                   Source="{Binding AvatarData, Converter={StaticResource AvatarBytesToImage}}"
                                                                   Width="30" Height="30"
                                                                   Visibility="{Binding AvatarData, Converter={StaticResource NullToVis}}"/>
                                                            <TextBlock Text="{Binding Initials}"
                                                                       FontSize="10" FontWeight="Bold"
                                                                       Foreground="White"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="{Binding AvatarData, Converter={StaticResource NullToVisInv}}"/>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock Text="{Binding UserName}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="#000000"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding IsUserPeekInteractive, Converter={StaticResource BoolToVisInv}}">
                                                <Border Style="{StaticResource AvatarCircle30}"
                                                        Background="#166534" Margin="0,0,8,0">
                                                    <Grid>
                                                        <Image Style="{StaticResource AvatarImage}"
                                                               Source="{Binding AvatarData, Converter={StaticResource AvatarBytesToImage}}"
                                                               Width="30" Height="30"
                                                               Visibility="{Binding AvatarData, Converter={StaticResource NullToVis}}"/>
                                                        <TextBlock Text="{Binding Initials}"
                                                                   FontSize="10" FontWeight="Bold"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding AvatarData, Converter={StaticResource NullToVisInv}}"/>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding UserName}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="#000000"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel x:Name="WorkersSection" Visibility="Collapsed">
                            <TextBlock Text="Работники" FontSize="11" FontWeight="SemiBold" Foreground="#92400E" Margin="0,0,0,6"/>
                            <ItemsControl x:Name="WorkersDisplay">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,12,8">
                                            <Button Style="{StaticResource PeekRowButton}"
                                                    Visibility="{Binding IsUserPeekInteractive, Converter={StaticResource BoolToVis}}"
                                                    Click="AssigneePeek_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Style="{StaticResource AvatarCircle30}"
                                                            Background="#92400E" Margin="0,0,8,0">
                                                        <Grid>
                                                            <Image Style="{StaticResource AvatarImage}"
                                                                   Source="{Binding AvatarData, Converter={StaticResource AvatarBytesToImage}}"
                                                                   Width="30" Height="30"
                                                                   Visibility="{Binding AvatarData, Converter={StaticResource NullToVis}}"/>
                                                            <TextBlock Text="{Binding Initials}"
                                                                       FontSize="10" FontWeight="Bold"
                                                                       Foreground="White"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="{Binding AvatarData, Converter={StaticResource NullToVisInv}}"/>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding UserName}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="#000000"/>
                                                        <TextBlock Text="{Binding SubRoleLabel}"
                                                                   FontSize="10" Foreground="{Binding SubRoleLabelBrush}"
                                                                   Visibility="{Binding SubRoleLabelVis}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Button>
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding IsUserPeekInteractive, Converter={StaticResource BoolToVisInv}}">
                                                <Border Style="{StaticResource AvatarCircle30}"
                                                        Background="#92400E" Margin="0,0,8,0">
                                                    <Grid>
                                                        <Image Style="{StaticResource AvatarImage}"
                                                               Source="{Binding AvatarData, Converter={StaticResource AvatarBytesToImage}}"
                                                               Width="30" Height="30"
                                                               Visibility="{Binding AvatarData, Converter={StaticResource NullToVis}}"/>
                                                        <TextBlock Text="{Binding Initials}"
                                                                   FontSize="10" FontWeight="Bold"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding AvatarData, Converter={StaticResource NullToVisInv}}"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding UserName}"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="#000000"/>
                                                    <TextBlock Text="{Binding SubRoleLabel}"
                                                               FontSize="10" Foreground="{Binding SubRoleLabelBrush}"
                                                               Visibility="{Binding SubRoleLabelVis}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock x:Name="NoAssigneesText"
                                   Text="Не назначено" FontSize="12"
                                   Foreground="#97A0AF" Visibility="Collapsed"/>
                </StackPanel>

                <Border Background="#DFE1E6" Height="1" Margin="0,0,0,16"/>

                <TextBlock Text="ЭТАПЫ" FontSize="10" FontWeight="SemiBold"
                           Foreground="#8993A4" Margin="0,0,0,8"/>

                <ItemsControl ItemsSource="{Binding Stages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="StageCardBorder" CornerRadius="6" Margin="0,0,0,4"
                                                Padding="10,6" BorderThickness="1.5"
                                                Cursor="Hand" HorizontalAlignment="Stretch"
                                                MouseLeftButtonDown="StageCard_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="White"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EffectiveMarkedForDeletion}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#EF4444"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="#000000"/>
                                                        </Trigger>
                                                        <EventTrigger RoutedEvent="Loaded">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                     From="0" To="1" Duration="0:0:0.2"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border CornerRadius="4" Padding="5,2" Margin="0,0,6,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{Binding Status, Converter={StaticResource StageStatusToBrush}}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding EffectiveMarkedForDeletion}" Value="True">
                                                                            <Setter Property="Background" Value="#EF4444"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="White">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="{Binding Status, Converter={StaticResource StageStatusToString}}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding EffectiveMarkedForDeletion}" Value="True">
                                                                                <Setter Property="Text" Value="Пометка удаления"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                        <TextBlock Text="{Binding AssignedUserName}"
                                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Visibility="{Binding AssignedUserName, Converter={StaticResource StringToVis}}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal"
                                                                Visibility="{Binding EffectiveMarkedForDeletion, Converter={StaticResource BoolToVisInv}}">
                                                    <Button Tag="{Binding}" Click="StartStage_Click" Margin="0,0,4,0"
                                                            Style="{StaticResource IconButton}" FontSize="12"
                                                            Visibility="{Binding Status, Converter={StaticResource EqualityToVis}, ConverterParameter=Planned}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Source="{svgc:SvgImage Source=/icons/play.svg, AppName=MPMS}"
                                                                   Width="12" Height="12" Margin="0,0,4,0"
                                                                   VerticalAlignment="Center" Opacity="0.8"/>
                                                            <TextBlock Text="Начать" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Tag="{Binding}" Click="CompleteStage_Click" Margin="0,0,4,0"
                                                            Style="{StaticResource IconButton}" FontSize="12"
                                                            Visibility="{Binding Status, Converter={StaticResource EqualityToVis}, ConverterParameter=InProgress}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Source="{svgc:SvgImage Source=/icons/check.svg, AppName=MPMS}"
                                                                   Width="10" Height="10" Margin="0,0,4,0"
                                                                   VerticalAlignment="Center" Opacity="0.9"/>
                                                            <TextBlock Text="Завершить" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        </StackPanel>
                                                    </Button>
                                                    </StackPanel>

                                                    <Button ToolTip="Редактировать" Tag="{Binding}"
                                                            Click="EditStage_Click" Margin="0,0,4,0">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                                <Setter Property="Visibility" Value="{Binding Converter={StaticResource RoleToVis}, ConverterParameter='Foreman,Project Manager,Administrator'}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanEditStageDetails}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding EffectiveMarkedForDeletion}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Image Source="{svgc:SvgImage Source=/icons/editing.svg, AppName=MPMS}"
                                                               Width="14" Height="14" VerticalAlignment="Center"/>
                                                    </Button>

                                                    <Button Tag="{Binding}" Click="MarkStageForDeletion_Click"
                                                            Margin="0,0,4,0">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                                <Setter Property="Visibility" Value="{Binding Converter={StaticResource RoleToVis}, ConverterParameter='Foreman,Project Manager,Administrator'}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CanToggleStageDeletionMark}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding EffectiveMarkedForDeletion}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Button.ToolTip>
                                                            <ToolTip>
                                                                <TextBlock>
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="Пометить к удалению"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsMarkedForDeletion}" Value="True">
                                                                                    <Setter Property="Text" Value="Снять пометку удаления"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </ToolTip>
                                                        </Button.ToolTip>
                                                        <Grid>
                                                            <Image Source="{svgc:SvgImage Source=/icons/markDelete.svg, AppName=MPMS}"
                                                                   Width="14" Height="14" VerticalAlignment="Center">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMarkedForDeletion}" Value="True">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding ElementName=StageCardBorder, Path=IsMouseOver}" Value="True">
                                                                                <Setter Property="Source" Value="{svgc:SvgImage Source=/icons/markDelete.svg, AppName=MPMS}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                            <Image Source="{svgc:SvgImage Source=/icons/removeMarkDelete.svg, AppName=MPMS}"
                                                                   Width="14" Height="14" VerticalAlignment="Center">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsMarkedForDeletion}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding ElementName=StageCardBorder, Path=IsMouseOver}" Value="True">
                                                                                <Setter Property="Source" Value="{svgc:SvgImage Source=/icons/removeMarkDelete.svg, AppName=MPMS}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                        </Grid>
                                                    </Button>

                                                    <Button ToolTip="Удалить этап" Tag="{Binding}"
                                                            Click="DeleteStage_Click"
                                                            Visibility="{Binding Converter={StaticResource RoleToVis}, ConverterParameter='Project Manager,Administrator'}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource DangerIconButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding EffectiveMarkedForDeletion}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Image Width="14" Height="14" VerticalAlignment="Center">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="Source" Value="{svgc:SvgImage Source=/icons/trash.svg, AppName=MPMS}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding EffectiveMarkedForDeletion}" Value="True">
                                                                            <Setter Property="Source" Value="{svgc:SvgImage Source=/icons/trash_red.svg, AppName=MPMS}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding ElementName=StageCardBorder, Path=IsMouseOver}" Value="True">
                                                                            <Setter Property="Source" Value="{svgc:SvgImage Source=/icons/trash.svg, AppName=MPMS}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                    </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel HorizontalAlignment="Center" Margin="0,24,0,8"
                                        Visibility="{Binding HasNoStages, Converter={StaticResource BoolToVis}}">
                                <Border Width="56" Height="56" CornerRadius="28" Background="#F4F5F7"
                                        HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <Image Source="{svgc:SvgImage Source=/icons/check.svg, AppName=MPMS}"
                                           Width="28" Height="28" HorizontalAlignment="Center" Opacity="0.35"/>
                                </Border>
                                <TextBlock Text="Этапы ещё не добавлены" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#6B778C" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Разбейте задачу на этапы для лучшего отслеживания" FontSize="12"
                                           Foreground="#97A0AF" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <Button x:Name="AddStageBtn" Click="AddStage_Click"
                                    Margin="0,10,0,0" Height="36" FontSize="13"
                                    Style="{StaticResource OutlineBtn}"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{svgc:SvgImage Source=/icons/plus_black.svg, AppName=MPMS}"
                                           Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Добавить этап" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                </StackPanel>
            </ScrollViewer>

        <Border Grid.Row="2" Padding="20,14"
                BorderBrush="#E8E9EC" BorderThickness="0,1,0,0"
                Background="White">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="MarkDeletionBtn" Click="MarkTaskForDeletion_Click"
                            Style="{StaticResource DangerBtn}">
                        <TextBlock x:Name="MarkDeletionBtnText" Text="Пометить к удалению"
                                   Foreground="#EF4444" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
                <Button x:Name="EditTaskBtn" HorizontalAlignment="Right"
                        Click="EditTask_Click"
                        Style="{StaticResource BlackBtn}">
                    <TextBlock Text="Редактировать" Foreground="White"/>
                </Button>
            </Grid>
        </Border>

    </Grid>
</UserControl>
