<UserControl x:Class="MPMS.Views.Overlays.ActivityHelpOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <UserControl.Resources>
        <Style x:Key="ColorLegendItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F4F5F7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E8E9EC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,18" BorderBrush="#E8E9EC" BorderThickness="0,0,0,1" Background="White">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Цвета последних действий" FontSize="20" FontWeight="Bold" Foreground="#000000"/>
                    <TextBlock Text="Цвет показывает раздел, оттенок — характер операции" FontSize="12" Foreground="#6B778C" Margin="0,4,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="Close_Click" Width="32" Height="32">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="#F4F5F7" CornerRadius="16">
                                <TextBlock Text="✕" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#6B778C"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#E8E9EC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,18,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="РАЗДЕЛЫ" FontSize="11" FontWeight="SemiBold" Foreground="#8993A4" Margin="0,0,0,10"/>
                <UniformGrid Grid.Row="1" Columns="2" Rows="5">
                    <Button Style="{StaticResource ColorLegendItem}" Tag="Project" Click="LegendItem_Click"><StackPanel Orientation="Horizontal"><Border Width="18" Height="18" CornerRadius="5" Background="#2563EB" Margin="0,0,8,0"/><TextBlock Text="Проект" FontSize="13" FontWeight="SemiBold" Foreground="#172B4D"/></StackPanel></Button>
                    <Button Style="{StaticResource ColorLegendItem}" Tag="Task" Click="LegendItem_Click"><StackPanel Orientation="Horizontal"><Border Width="18" Height="18" CornerRadius="5" Background="#10B981" Margin="0,0,8,0"/><TextBlock Text="Задача" FontSize="13" FontWeight="SemiBold" Foreground="#172B4D"/></StackPanel></Button>
                    <Button Style="{StaticResource ColorLegendItem}" Tag="Stage" Click="LegendItem_Click"><StackPanel Orientation="Horizontal"><Border Width="18" Height="18" CornerRadius="5" Background="#BE185D" Margin="0,0,8,0"/><TextBlock Text="Этап" FontSize="13" FontWeight="SemiBold" Foreground="#172B4D"/></StackPanel></Button>
                    <Button Style="{StaticResource ColorLegendItem}" Tag="Material" Click="LegendItem_Click"><StackPanel Orientation="Horizontal"><Border Width="18" Height="18" CornerRadius="5" Background="#E1B12C" Margin="0,0,8,0"/><TextBlock Text="Материал" FontSize="13" FontWeight="SemiBold" Foreground="#172B4D"/></StackPanel></Button>
                    <Button Style="{StaticResource ColorLegendItem}" Tag="Equipment" Click="LegendItem_Click"><StackPanel Orientation="Horizontal"><Border Width="18" Height="18" CornerRadius="5" Background="#089182" Margin="0,0,8,0"/><TextBlock Text="Оборуд." FontSize="13" FontWeight="SemiBold" Foreground="#172B4D"/></StackPanel></Button>
                    <Button Style="{StaticResource ColorLegendItem}" Tag="File" Click="LegendItem_Click"><StackPanel Orientation="Horizontal"><Border Width="18" Height="18" CornerRadius="5" Background="#E11D48" Margin="0,0,8,0"/><TextBlock Text="Файл" FontSize="13" FontWeight="SemiBold" Foreground="#172B4D"/></StackPanel></Button>
                    <Button Style="{StaticResource ColorLegendItem}" Tag="Image" Click="LegendItem_Click"><StackPanel Orientation="Horizontal"><Border Width="18" Height="18" CornerRadius="5" Background="#6366F1" Margin="0,0,8,0"/><TextBlock Text="Изображ." FontSize="13" FontWeight="SemiBold" Foreground="#172B4D"/></StackPanel></Button>
                    <Button Style="{StaticResource ColorLegendItem}" Tag="Document" Click="LegendItem_Click"><StackPanel Orientation="Horizontal"><Border Width="18" Height="18" CornerRadius="5" Background="#84CC16" Margin="0,0,8,0"/><TextBlock Text="Документ" FontSize="13" FontWeight="SemiBold" Foreground="#172B4D"/></StackPanel></Button>
                    <Button Style="{StaticResource ColorLegendItem}" Tag="Message" Click="LegendItem_Click"><StackPanel Orientation="Horizontal"><Border Width="18" Height="18" CornerRadius="5" Background="#5474A6" Margin="0,0,8,0"/><TextBlock Text="Обсужд." FontSize="13" FontWeight="SemiBold" Foreground="#172B4D"/></StackPanel></Button>
                    <Button Style="{StaticResource ColorLegendItem}" Tag="User" Click="LegendItem_Click"><StackPanel Orientation="Horizontal"><Border Width="18" Height="18" CornerRadius="5" Background="#6B7280" Margin="0,0,8,0"/><TextBlock Text="Пользов." FontSize="13" FontWeight="SemiBold" Foreground="#172B4D"/></StackPanel></Button>
                </UniformGrid>

                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,8,0,0" VerticalAlignment="Stretch">
                    <TextBlock Text="Если действие относится к файлу, система уточняет тип по расширению: изображения получают индиго-гамму, документы — оливковую, остальные файлы — розовую." FontSize="11" Foreground="#475569" TextWrapping="Wrap" LineHeight="16"/>
                </Border>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="ОТТЕНКИ ДЕЙСТВИЙ" FontSize="11" FontWeight="SemiBold" Foreground="#8993A4" Margin="0,0,0,10"/>
                <Grid Grid.Row="1" Margin="0,0,0,12" Visibility="{Binding MultiShadeVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,5,0"><Border Height="24" CornerRadius="6" Background="{Binding CreatedBrush}"/><TextBlock Text="{Binding CreatedLabel}" FontSize="10" Foreground="#475569" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,5,0"><Border Height="24" CornerRadius="6" Background="{Binding UpdatedBrush}"/><TextBlock Text="{Binding UpdatedLabel}" FontSize="10" Foreground="#475569" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,5,0"><Border Height="24" CornerRadius="6" Background="{Binding DeletedBrush}"/><TextBlock Text="{Binding DeletedLabel}" FontSize="10" Foreground="#475569" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Column="3"><Border Height="24" CornerRadius="6" Background="{Binding WarningBrush}"/><TextBlock Text="{Binding WarningLabel}" FontSize="10" Foreground="#475569" TextAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,12" Visibility="{Binding SingleShadeVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <Border Height="24" CornerRadius="6" Background="{Binding CreatedBrush}"/>
                        <TextBlock Text="{Binding CreatedLabel}" FontSize="10" Foreground="#475569" TextAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2" Background="{Binding ExampleBackground}" BorderBrush="{Binding ExampleBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="{Binding ExampleTitle}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding ExampleForeground}" Margin="0,0,0,7"/>
                        <TextBlock Text="{Binding ExampleText}" FontSize="11.5" Foreground="{Binding ExampleForeground}" LineHeight="17"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Background="#EEF2FF" CornerRadius="8" Padding="10" VerticalAlignment="Stretch">
                    <TextBlock Text="Особые случаи: закрытый проект отображается тёмно-серым; смена статуса использует светлый оттенок своего раздела; сообщения выделяются фиолетовой гаммой." FontSize="11" Foreground="#334155" TextWrapping="Wrap" LineHeight="16" VerticalAlignment="Top"/>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1,1,0,0" Padding="24,14">
            <TextBlock Text="Окно «Последние действия» показывает недавние события системы: кто выполнил действие, в каком разделе, когда это произошло и что именно изменилось. Цветная полоса и бейдж помогают быстро понять тип события без открытия деталей." FontSize="11.5" Foreground="#475569" TextWrapping="Wrap" LineHeight="17"/>
        </Border>
    </Grid>
</UserControl>
