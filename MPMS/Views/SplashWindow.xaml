<Window x:Class="MPMS.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MPMS"
        Width="320" Height="200"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True">
    
    <Border CornerRadius="8" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" Opacity="0.18"
                              ShadowDepth="8" Direction="270"/>
        </Border.Effect>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32,24,32,32">

            <Border Width="80" Height="36"
                    Background="#111111"
                    CornerRadius="8"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,24">
                <TextBlock Text="MPMS"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="Загрузка"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#111111"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <TextBlock x:Name="LoadingText"
                       Text="Инициализация..."
                       FontSize="13"
                       Foreground="#6B778C"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
