<Window x:Class="MPMS.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MPMS"
        Width="500" Height="250"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True">
    
    <Border CornerRadius="24" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" Opacity="0.18"
                              ShadowDepth="8" Direction="270"/>
        </Border.Effect>

        <Grid ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left branding panel -->
            <Grid Grid.Column="0" Background="#111111">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0,24,0">
                    <!-- Logo -->
                    <Border Width="80" Height="36"
                            Background="White"
                            CornerRadius="8"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,16">
                        <TextBlock Text="MPMS"
                                   Foreground="#111111"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <!-- Tagline -->
                    <TextBlock Text="Montage Project"
                               Foreground="#C1C7D0"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Management System"
                               Foreground="#C1C7D0"
                               FontSize="11"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,24"/>

                    <!-- Version -->
                    <Border Background="#1A1A1A"
                            CornerRadius="4"
                            Padding="8,4"
                            HorizontalAlignment="Center">
                        <TextBlock Text="v 1.0"
                                   Foreground="#6B778C"
                                   FontSize="10"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Right loading panel -->
            <Grid Grid.Column="1" Background="{StaticResource BackgroundBrush}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="48,0,48,0">
                    <TextBlock Text="Загрузка"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,28"/>

                    <!-- Progress bar container -->
                    <Border Width="220" Height="4"
                            Background="#E2E8F0"
                            CornerRadius="2">
                        <Border x:Name="ProgressBar"
                                Width="0"
                                Height="4"
                                Background="#111111"
                                CornerRadius="2"
                                HorizontalAlignment="Left">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Opacity="0.3" ShadowDepth="0"/>
                            </Border.Effect>
                        </Border>
                    </Border>

                    <!-- Loading text -->
                    <TextBlock x:Name="LoadingText"
                               Text="Инициализация..."
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
