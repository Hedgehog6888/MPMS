<Window x:Class="MPMS.Views.StageStatusChangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Смена статуса этапа"
        SizeToContent="WidthAndHeight"
        MinWidth="380"
        MaxWidth="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="DialogBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="BlackDialogBtn" TargetType="Button" BasedOn="{StaticResource DialogBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#000000" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" Height="{TemplateBinding Height}">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="White"
                                       FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1a1a1a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#F4F5F7"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="White"
            BorderBrush="#E2E8F0" BorderThickness="1"
            Padding="0,0,0,0"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" Opacity="0.15" ShadowDepth="3"/>
        </Border.Effect>

        <StackPanel>
            <!-- Header -->
            <Border Background="White" CornerRadius="12,12,0,0" Padding="20,18,20,14"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock x:Name="TitleText" Text="Сменить статус этапа?"
                               FontSize="15" FontWeight="Bold" Foreground="#000000"
                               VerticalAlignment="Center"/>
                    <Button Click="Cancel_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="24" Height="24" Margin="0,0,-4,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="Transparent" CornerRadius="12">
                                    <TextBlock Text="✕" FontSize="11" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Foreground="#6B778C"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#F4F5F7"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <StackPanel Margin="20,14,20,0">
                <!-- Stage name -->
                <TextBlock x:Name="StageNameText" Text=""
                           FontSize="13" FontWeight="SemiBold" Foreground="#000000"
                           TextWrapping="Wrap" Margin="0,0,0,12"/>

                <!-- Status change display -->
                <Grid Margin="0,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Current status -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Текущий статус" FontSize="11" Foreground="#6B778C" Margin="0,0,0,4"/>
                    <Border Grid.Row="1" Grid.Column="0" x:Name="CurrentStatusBadge" Style="{StaticResource StatusBadge}">
                        <TextBlock x:Name="CurrentStatusText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="#42526E"/>
                    </Border>

                    <!-- Arrow icon -->
                    <Grid Grid.Row="1" Grid.Column="1" Width="20" Height="20" Margin="8,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Path Data="M 6 4 L 10 8 L 6 12" Stroke="#6B778C" StrokeThickness="2" 
                              Fill="{x:Null}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- New status -->
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Новый статус" FontSize="11" Foreground="#6B778C" Margin="0,0,0,4"/>
                    <Border Grid.Row="1" Grid.Column="2" x:Name="NewStatusBadge" Style="{StaticResource StatusBadge}">
                        <TextBlock x:Name="NewStatusText" Text="" FontSize="12" FontWeight="SemiBold" Foreground="#42526E"/>
                    </Border>
                </Grid>

                <!-- Optional message -->
                <TextBlock x:Name="MessageText" Text=""
                           FontSize="12" Foreground="#6B778C" TextWrapping="Wrap"
                           Margin="0,12,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <!-- Footer -->
            <Border Padding="20,14,20,18">
                <Grid>
                    <Button Content="Отмена" HorizontalAlignment="Left"
                            Click="Cancel_Click"
                            Style="{StaticResource DialogBtn}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="White" CornerRadius="8"
                                        BorderBrush="#E2E8F0" BorderThickness="1"
                                        Padding="{TemplateBinding Padding}" Height="{TemplateBinding Height}">
                                    <TextBlock Text="Отмена" Foreground="#000000"
                                               FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="ConfirmBtn" HorizontalAlignment="Right"
                            Click="Confirm_Click"
                            Style="{StaticResource BlackDialogBtn}"
                            Content="Сменить"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
