<Window x:Class="MPMS.Views.ConfirmDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение удаления"
        SizeToContent="WidthAndHeight"
        MinWidth="420"
        MaxWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="DialogBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        
        <Style x:Key="RedDialogBtn" TargetType="Button" BasedOn="{StaticResource DialogBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#EF4444" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" Height="{TemplateBinding Height}">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="White"
                                       FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style x:Key="GrayDialogBtn" TargetType="Button" BasedOn="{StaticResource DialogBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#000000" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" Height="{TemplateBinding Height}">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="White"
                                       FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1a1a1a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AmberDialogBtn" TargetType="Button" BasedOn="{StaticResource DialogBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#D97706" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" Height="{TemplateBinding Height}">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="White"
                                       FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#B45309"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenDialogBtn" TargetType="Button" BasedOn="{StaticResource DialogBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#00875A" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" Height="{TemplateBinding Height}">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="White"
                                       FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#006B47"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BlueDialogBtn" TargetType="Button" BasedOn="{StaticResource DialogBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#2563EB" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" Height="{TemplateBinding Height}">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="White"
                                       FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" Background="White"
            BorderBrush="#DFE1E6" BorderThickness="1"
            Padding="0,0,0,0"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" Opacity="0.18" ShadowDepth="4"/>
        </Border.Effect>
        <StackPanel>

            <Border x:Name="HeaderBorder" Background="White" CornerRadius="12,12,0,0" Padding="24,20,24,16"
                    BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock x:Name="TitleText" Text="Удалить элемент?"
                                       FontSize="16" FontWeight="Bold" Foreground="#000000"/>
                            <TextBlock x:Name="SubtitleText" Text="Это действие нельзя отменить" FontSize="12"
                                       Foreground="#EF4444" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Click="Cancel_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Width="26" Height="26">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="Transparent" CornerRadius="13">
                                    <TextBlock Text="✕" FontSize="12" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Foreground="#6B778C"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#F4F5F7"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <StackPanel Margin="24,16,24,0">

                <Border Background="#F4F5F7" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock x:Name="EntityTypeText" Text="Элемент"
                                   FontSize="11" Foreground="#6B778C" Margin="0,0,0,4"/>
                        <TextBlock x:Name="ItemNameText" Text=""
                                   FontSize="14" FontWeight="SemiBold" Foreground="#000000"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border x:Name="CascadeWarning" Background="#FFF8E1" CornerRadius="6" Padding="12,10"
                        BorderBrush="#FFC107" BorderThickness="1" Margin="0,0,0,0"
                        Visibility="Collapsed">
                    <TextBlock x:Name="CascadeText"
                               FontSize="12" Foreground="#856404" TextWrapping="Wrap"/>
                </Border>

                <StackPanel x:Name="ClosureReasonPanel" Visibility="Collapsed" Margin="0,14,0,0">
                    <TextBlock Text="Причина закрытия (необязательно)" FontSize="12" FontWeight="SemiBold"
                               Foreground="#344563" Margin="0,0,0,6"/>
                    <Border Background="White" BorderBrush="#DFE1E6" BorderThickness="1"
                            CornerRadius="8" Padding="12,10" Margin="0,0,0,4">
                        <TextBox x:Name="ClosureReasonTextBox"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="#000000" FontSize="13"
                                 Height="72" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalContentAlignment="Top"/>
                    </Border>
                    <TextBlock Text="Укажите причину закрытия проекта."
                               FontSize="11" Foreground="#8993A4" Margin="0,0,0,0"/>
                </StackPanel>

                <StackPanel x:Name="BlockReasonPanel" Visibility="Collapsed" Margin="0,14,0,0">
                    <TextBlock Text="Причина блокировки (необязательно)" FontSize="12" FontWeight="SemiBold"
                               Foreground="#344563" Margin="0,0,0,6"/>
                    <Border Background="White" BorderBrush="#DFE1E6" BorderThickness="1"
                            CornerRadius="8" Padding="12,10" Margin="0,0,0,4">
                        <TextBox x:Name="BlockReasonTextBox"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="#000000" FontSize="13"
                                 Height="72" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalContentAlignment="Top"/>
                    </Border>
                    <TextBlock Text="Причина будет показана пользователю при входе."
                               FontSize="11" Foreground="#8993A4" Margin="0,0,0,0"/>
                </StackPanel>

                <StackPanel x:Name="BlockReasonDisplayPanel" Visibility="Collapsed" Margin="0,14,0,0">
                    <TextBlock Text="Причина блокировки" FontSize="12" FontWeight="SemiBold"
                               Foreground="#344563" Margin="0,0,0,6"/>
                    <Border Background="#F4F5F7" CornerRadius="8" Padding="12,10" Margin="0,0,0,0">
                        <TextBlock x:Name="BlockReasonDisplayText" FontSize="13" Foreground="#6B778C"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <Border Padding="24,16,24,20">
                <Grid>
                    <Button Content="Отмена" HorizontalAlignment="Left"
                            Click="Cancel_Click"
                            Style="{StaticResource DialogBtn}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="White" CornerRadius="8"
                                        BorderBrush="#DFE1E6" BorderThickness="1"
                                        Padding="{TemplateBinding Padding}" Height="{TemplateBinding Height}">
                                    <TextBlock Text="Отмена" Foreground="#000000"
                                               FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#F4F5F7"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="ConfirmBtn" HorizontalAlignment="Right"
                            Click="Confirm_Click"
                            Style="{StaticResource RedDialogBtn}"
                            Content="Удалить"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
