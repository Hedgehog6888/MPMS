<Window x:Class="MPMS.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:MPMS.Infrastructure"
        xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
        Title="MPMS" Height="640" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <infra:BoolToVisibilityConverter x:Key="StringToVis" IsStringMode="True"/>
        <infra:HexToBrushConverter       x:Key="HexToBrush"/>

        <Style x:Key="InputContainer" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Height"          Value="50"/>
        </Style>

        <Style x:Key="FloatingInputContainer" TargetType="Border">
            <Setter Property="Background"      Value="#F8FAFC"/>
            <Setter Property="CornerRadius"    Value="8"/>
            <Setter Property="BorderBrush"     Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height"          Value="54"/>
        </Style>

        <Style x:Key="InnerTextBox" TargetType="TextBox">
            <Setter Property="Background"             Value="Transparent"/>
            <Setter Property="BorderThickness"        Value="0"/>
            <Setter Property="FontSize"               Value="14"/>
            <Setter Property="Foreground"             Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding"                Value="0,0,14,0"/>
            <Setter Property="CaretBrush"             Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="SelectionBrush"         Value="{StaticResource NeutralSelectionBrush}"/>
            <Setter Property="SelectionTextBrush"     Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FloatingTextBox" TargetType="TextBox">
            <Setter Property="Background"             Value="Transparent"/>
            <Setter Property="BorderThickness"        Value="0"/>
            <Setter Property="FontSize"               Value="14"/>
            <Setter Property="Foreground"             Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding"                Value="0,12,14,0"/>
            <Setter Property="CaretBrush"             Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="SelectionBrush"         Value="{StaticResource NeutralSelectionBrush}"/>
            <Setter Property="SelectionTextBrush"     Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="FloatingPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background"             Value="Transparent"/>
            <Setter Property="BorderThickness"        Value="0"/>
            <Setter Property="FontSize"               Value="14"/>
            <Setter Property="Foreground"             Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding"                Value="0,12,14,2"/>
            <Setter Property="CaretBrush"             Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="SelectionBrush"         Value="{StaticResource NeutralSelectionBrush}"/>
            <Setter Property="SelectionTextBrush"     Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="InnerPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background"             Value="Transparent"/>
            <Setter Property="BorderThickness"        Value="0"/>
            <Setter Property="FontSize"               Value="14"/>
            <Setter Property="Foreground"             Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding"                Value="0,0,14,2"/>
            <Setter Property="CaretBrush"             Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="SelectionBrush"         Value="{StaticResource NeutralSelectionBrush}"/>
            <Setter Property="SelectionTextBrush"     Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginBtn" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="15"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height"          Value="50"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="#111111">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#333333"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccountCard" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBd"
                                Background="Transparent"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8,10">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBd" Property="Background"
                                        Value="{StaticResource BackgroundBrush}"/>
                                <Setter TargetName="CardBd" Property="BorderBrush"
                                        Value="#B0BEC5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="8" Background="White" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" Opacity="0.22"
                              ShadowDepth="8" Direction="270"/>
        </Border.Effect>

        <Grid MouseLeftButtonDown="DragBar_MouseLeftButtonDown" Margin="16">

            <Grid Background="White">

                <Button x:Name="CloseBtn" Click="CloseButton_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,14,16,0" Width="30" Height="30"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CloseBd" CornerRadius="15"
                                    Background="Transparent">
                                <TextBlock Text="✕" FontSize="13"
                                           Foreground="#BBBBBB"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseBd"
                                            Property="Background" Value="#F5F5F5"/>
                                    <Setter TargetName="CloseBd"
                                            Property="TextElement.Foreground"
                                            Value="#666666"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <StackPanel VerticalAlignment="Center"
                            Margin="52,0,52,0"
                            MaxWidth="380">

                    <TextBlock Text="Вход в систему"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="Segoe UI"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Введите логин и пароль для доступа"
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,20"/>

                    <Border x:Name="UsernameContainer"
                            Style="{StaticResource FloatingInputContainer}"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="&#xE77B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15" Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="UsernamePlaceholder"
                                       Grid.Column="1"
                                       Text="Логин"
                                       FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Margin="0,0,0,0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <TranslateTransform Y="0"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text.Length, ElementName=UsernameBox}" Value="0">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                                             To="0" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="FontSize"
                                                                             To="14" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                                             To="-14" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="FontSize"
                                                                             To="11" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsFocused, ElementName=UsernameBox}" Value="True">
                                                <Setter Property="Foreground" Value="#2563EB"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="UsernameBox"
                                     Grid.Column="1"
                                     Style="{StaticResource FloatingTextBox}"
                                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                     GotFocus="UsernameBox_GotFocus"
                                     LostFocus="UsernameBox_LostFocus"/>
                        </Grid>
                    </Border>

                    <Border x:Name="PasswordContainer"
                            Style="{StaticResource FloatingInputContainer}"
                            Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="&#xE72E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15" Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="PasswordPlaceholder"
                                       Grid.Column="1"
                                       Text="Пароль"
                                       FontSize="14"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Margin="0,0,0,0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <TranslateTransform Y="0"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Password.Length, ElementName=PwdBox}" Value="0"/>
                                                    <Condition Binding="{Binding Text.Length, ElementName=PwdVisibleBox}" Value="0"/>
                                                </MultiDataTrigger.Conditions>
                                                <MultiDataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                                             To="0" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="FontSize"
                                                                             To="14" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.EnterActions>
                                                <MultiDataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                                             To="-14" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="FontSize"
                                                                             To="11" Duration="0:0:0.15"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </MultiDataTrigger.ExitActions>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsFocused, ElementName=PwdBox}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Foreground" Value="#2563EB"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsFocused, ElementName=PwdVisibleBox}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Foreground" Value="#2563EB"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <PasswordBox x:Name="PwdBox"
                                         Grid.Column="1"
                                         Style="{StaticResource FloatingPasswordBox}"
                                         PasswordChanged="PasswordBox_PasswordChanged"
                                         GotFocus="PwdBox_GotFocus"
                                         LostFocus="PwdBox_LostFocus"/>

                            <TextBox x:Name="PwdVisibleBox"
                                     Grid.Column="1"
                                     Style="{StaticResource FloatingTextBox}"
                                     Visibility="Collapsed"
                                     TextChanged="PwdVisibleBox_TextChanged"
                                     GotFocus="PwdBox_GotFocus"
                                     LostFocus="PwdBox_LostFocus"/>

                            <Grid Grid.Column="2"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Cursor="Hand"
                                  MouseLeftButtonDown="EyeIcon_Click">

                                <Image x:Name="EyeOffIcon"
                                       Width="18"
                                       Height="18"
                                       Source="{svgc:SvgImage Source=/icons/еуе2.svg, AppName=MPMS}"
                                       Opacity="0.85"/>

                                <Image x:Name="EyeOnIcon"
                                       Width="18"
                                       Height="18"
                                       Source="{svgc:SvgImage Source=/icons/еуе.svg, AppName=MPMS}"
                                       Opacity="0.85"
                                       Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Background="#FFF5F5" CornerRadius="8"
                            BorderBrush="#FFCDD2" BorderThickness="1"
                            Padding="14,10" Margin="0,0,0,14"
                            Visibility="{Binding ErrorMessage,
                                Converter={StaticResource StringToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="⚠" Foreground="#E53935"
                                       FontSize="14" Margin="0,0,8,0"
                                       VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ErrorMessage}"
                                       Foreground="#C62828" FontSize="13"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <Button Content="Войти в систему"
                            Style="{StaticResource LoginBtn}"
                            Command="{Binding LoginCommand}"/>

                    <Button Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,10,0,0"
                            Command="{Binding ToggleApiUrlExpandedCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="Transparent"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="0,8,0,0">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <TextBlock x:Name="LabelText"
                                                   Text="Дополнительно"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,0,4,0"/>
                                        <TextBlock x:Name="ArrowIcon"
                                                   Text="&#xE70D;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#111111"/>
                                        <Setter TargetName="LabelText" Property="Foreground" Value="#111111"/>
                                        <Setter TargetName="ArrowIcon" Property="Foreground" Value="#111111"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsApiUrlExpanded}" Value="True">
                                        <Setter TargetName="ArrowIcon" Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="180" CenterX="5" CenterY="5"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <StackPanel Visibility="{Binding IsApiUrlExpanded, Converter={StaticResource BoolToVis}}"
                                Margin="0,16,0,0">
                        <Border x:Name="ApiUrlContainer"
                                Style="{StaticResource FloatingInputContainer}"
                                Margin="0,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="&#xE839;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="ApiUrlPlaceholder"
                                           Grid.Column="1"
                                           Text="Адрес сервера"
                                           FontSize="14"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           Margin="0,0,0,0"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <TranslateTransform Y="0"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text.Length, ElementName=ApiUrlBox}" Value="0">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                                                 To="0" Duration="0:0:0.15"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="FontSize"
                                                                                 To="14" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                                                 To="-14" Duration="0:0:0.15"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="FontSize"
                                                                                 To="11" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsFocused, ElementName=ApiUrlBox}" Value="True">
                                                    <Setter Property="Foreground" Value="#2563EB"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="ApiUrlBox"
                                         Grid.Column="1"
                                         Style="{StaticResource FloatingTextBox}"
                                         Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Например: http://localhost:5147/api/ или http://192.168.1.5:5147/api/"
                                         GotFocus="ApiUrlBox_GotFocus"
                                         LostFocus="ApiUrlBox_LostFocus"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,12,0,0"
                                Visibility="{Binding IsBusy,
                                    Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="⟳ " Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Выполняется вход..."
                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Margin="0,22,0,0"
                                Visibility="{Binding HasRecentAccounts,
                                    Converter={StaticResource BoolToVis}}">

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Height="1"
                                       Fill="{StaticResource BorderBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="  Недавние аккаунты  "
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="2" Height="1"
                                       Fill="{StaticResource BorderBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding RecentAccounts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource AccountCard}"
                                            Margin="3,0"
                                            Command="{Binding DataContext.SelectAccountCommand,
                                                RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel HorizontalAlignment="Center"
                                                    Width="76">

                                            <Grid Width="46" Height="46"
                                                  HorizontalAlignment="Center"
                                                  Margin="0,0,0,7">
                                                <Ellipse Fill="{Binding AvatarColor,
                                                             Converter={StaticResource HexToBrush}}"/>
                                                <TextBlock
                                                    Text="{Binding Initials}"
                                                    Foreground="White"
                                                    FontSize="16" FontWeight="Bold"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                            </Grid>

                                            <TextBlock
                                                Text="{Binding Username}"
                                                FontSize="12" FontWeight="SemiBold"
                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                HorizontalAlignment="Center"
                                                TextTrimming="CharacterEllipsis"/>
                                        
                                            <TextBlock
                                                Text="{Binding Role}"
                                                FontSize="10"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                HorizontalAlignment="Center"
                                                TextTrimming="CharacterEllipsis"
                                                Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
