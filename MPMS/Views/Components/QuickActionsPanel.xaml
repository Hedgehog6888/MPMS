<UserControl x:Class="MPMS.Views.Components.QuickActionsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:MPMS.Infrastructure"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/">
    <UserControl.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    
    <Border Background="White" CornerRadius="8" Padding="16"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            Visibility="{Binding Project.IsClosed, Converter={StaticResource BoolToVisInv}}">
        <StackPanel>
            <TextBlock Text="Быстрые действия" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
            <WrapPanel>
                <Button x:Name="CreateTaskQuickBtn" Click="CreateTask_Click"
                        Height="34" Padding="12,0" Margin="0,0,8,0" FontSize="13"
                        ToolTipService.ShowOnDisabled="True">
                    <Button.ToolTip>
                        <ToolTip>
                            <TextBlock Text="Сначала снимите пометку удаления"/>
                        </ToolTip>
                    </Button.ToolTip>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="ToolTipService.IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Project.IsMarkedForDeletion}" Value="True">
                                    <Setter Property="ToolTipService.IsEnabled" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="Black" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="{svgc:SvgImage Source=/icons/plus.svg, AppName=MPMS}"
                                           Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Opacity="0.9"/>
                                    <TextBlock Text="Добавить задачу" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#333"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="QuickTeamBtn" Click="OpenQuickTeamOverlay_Click"
                        Height="34" Padding="12,0" Margin="0,0,8,0" FontSize="13"
                        ToolTipService.ShowOnDisabled="True">
                    <Button.ToolTip>
                        <ToolTip>
                            <TextBlock Text="Сначала снимите пометку удаления"/>
                        </ToolTip>
                    </Button.ToolTip>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="ToolTipService.IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Project.IsMarkedForDeletion}" Value="True">
                                    <Setter Property="ToolTipService.IsEnabled" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="White" CornerRadius="6"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="{svgc:SvgImage Source=/icons/users_black.svg, AppName=MPMS}"
                                           Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Обновить состав" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource BackgroundBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="UploadFileQuickBtn" Click="UploadFile_Click"
                        Height="34" Padding="12,0" FontSize="13"
                        ToolTipService.ShowOnDisabled="True">
                    <Button.ToolTip>
                        <ToolTip>
                            <TextBlock Text="Сначала снимите пометку удаления"/>
                        </ToolTip>
                    </Button.ToolTip>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="ToolTipService.IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Project.IsMarkedForDeletion}" Value="True">
                                    <Setter Property="ToolTipService.IsEnabled" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="White" CornerRadius="6"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="{svgc:SvgImage Source=/icons/upload.svg, AppName=MPMS}"
                                           Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Загрузить файл" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource BackgroundBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
