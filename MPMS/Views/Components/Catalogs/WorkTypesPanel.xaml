<UserControl x:Class="MPMS.Views.Components.Catalogs.WorkTypesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:MPMS.ViewModels"
             xmlns:models="clr-namespace:MPMS.Models"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CatalogsViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Views/Components/Admin/AdminStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель инструментов -->
        <Border Grid.Row="0" Background="White" CornerRadius="8"
                BorderBrush="#DFE1E6" BorderThickness="1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Поиск -->
                <Border Grid.Column="0" x:Name="SearchBorder"
                        Background="#F4F5F7" CornerRadius="6"
                        Padding="10,0" Height="36"
                        BorderThickness="1.5" BorderBrush="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="#6B778C"/>
                        <Grid Grid.Column="1">
                            <TextBlock Text="Поиск по названию или артикулу..."
                                       Foreground="#6B778C" FontSize="12"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WorkTypeSearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox Text="{Binding WorkTypeSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     VerticalAlignment="Center" FontSize="13"
                                     Foreground="#000000"
                                     GotFocus="Search_GotFocus"
                                     LostFocus="Search_LostFocus"/>
                        </Grid>
                        <Button Grid.Column="2"
                                Visibility="{Binding WorkTypeSearchText, Converter={StaticResource StringToVis}}"
                                Style="{StaticResource IconButton}"
                                Click="ClearSearch_Click">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="11" Foreground="#6B778C"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Фильтр категорий -->
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding WorkTypeCategoryFilterOptions}"
                          SelectedItem="{Binding WorkTypeCategoryFilter}"
                          Style="{StaticResource FormCombo}"/>

                <!-- Кнопка добавления -->
                <Button Grid.Column="4" Style="{StaticResource BlackBtn}"
                        Height="38" Padding="18,0"
                        Click="AddWorkType_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{svgc:SvgImage Source=/icons/plus.svg, AppName=MPMS}"
                               Width="14" Height="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Добавить" Foreground="White"
                                   FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Таблица -->
        <Border Grid.Row="2" Background="White" CornerRadius="8"
                BorderBrush="#DFE1E6" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Заголовок -->
                <Border Grid.Row="0" Background="#F4F5F7" CornerRadius="8,8,0,0"
                        BorderBrush="#DFE1E6" BorderThickness="0,0,0,1" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="152"/>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="67"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Название" Style="{StaticResource ThCell}"/>
                        <TextBlock Grid.Column="1" Text="Категория" Style="{StaticResource ThCell}" Margin="-130,0,0,0"/>
                        <TextBlock Grid.Column="2" Text="Артикул" Style="{StaticResource ThCell}"/>
                        <TextBlock Grid.Column="3" Text="Цена" Style="{StaticResource ThCell}"/>
                        <TextBlock Grid.Column="4" Text="Действия" Style="{StaticResource ThCell}"/>
                    </Grid>
                </Border>

                <!-- Строки -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredWorkTypes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:LocalWorkTypeTemplate}">
                                <Border Padding="16,10"
                                        BorderBrush="#F4F5F7" BorderThickness="0,0,0,1"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="WorkTypeRow_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FAFBFC"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Название + описание -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="#000000"/>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="11" Foreground="#6B778C"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="400">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Description}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Категория -->
                                        <Border Grid.Column="1"
                                                Background="#E3F2FD"
                                                CornerRadius="4" Padding="8,3"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Margin="-130,0,0,0">
                                            <TextBlock Text="{Binding CategoryName}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#1565C0"/>
                                        </Border>

                                        <!-- Артикул -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Article}" FontSize="12" Foreground="#344563"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                        <!-- Цена -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding BasePrice, StringFormat='{}{0:N2}'}" FontSize="12" Foreground="#000000"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                        <!-- Действия -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button Style="{StaticResource RowIconBtn}" ToolTip="Просмотр"
                                                    Command="{Binding DataContext.ViewWorkTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Image Source="{svgc:SvgImage Source=/icons/eye.svg, AppName=MPMS}" Width="14" Height="14"/>
                                            </Button>
                                            <Button Style="{StaticResource RowIconBtn}" ToolTip="Редактировать"
                                                    Command="{Binding DataContext.EditWorkTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Image Source="{svgc:SvgImage Source=/icons/editing.svg, AppName=MPMS}" Width="14" Height="14"/>
                                            </Button>
                                            <Button Style="{StaticResource RowIconBtn}" ToolTip="Удалить"
                                                    Command="{Binding DataContext.DeleteWorkTypeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Image Source="{svgc:SvgImage Source=/icons/trash.svg, AppName=MPMS}" Width="14" Height="14"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
