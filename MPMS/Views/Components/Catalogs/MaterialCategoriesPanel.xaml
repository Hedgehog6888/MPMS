<UserControl x:Class="MPMS.Views.Components.Catalogs.MaterialCategoriesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:MPMS.ViewModels"
             xmlns:models="clr-namespace:MPMS.Models"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CatalogsViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Views/Components/Admin/AdminStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель инструментов -->
        <Border Grid.Row="0" Background="White" CornerRadius="8"
                BorderBrush="#DFE1E6" BorderThickness="1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Поиск -->
                <Border Grid.Column="0" x:Name="SearchBorder"
                        Background="#F4F5F7" CornerRadius="6"
                        Padding="10,0" Height="36"
                        BorderThickness="1.5" BorderBrush="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="#6B778C"/>
                        <Grid Grid.Column="1">
                            <TextBlock Text="Поиск по названию..."
                                       Foreground="#6B778C" FontSize="12"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MaterialCategorySearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox Text="{Binding MaterialCategorySearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     VerticalAlignment="Center" FontSize="13"
                                     Foreground="#000000"
                                     GotFocus="Search_GotFocus"
                                     LostFocus="Search_LostFocus"/>
                        </Grid>
                        <Button Grid.Column="2"
                                Visibility="{Binding MaterialCategorySearchText, Converter={StaticResource StringToVis}}"
                                Style="{StaticResource IconButton}"
                                Click="ClearSearch_Click">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="11" Foreground="#6B778C"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Кнопка Добавить -->
                <Button Grid.Column="2" Style="{StaticResource BlackBtn}"
                        Height="38" Padding="18,0"
                        Click="AddCategory_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{svgc:SvgImage Source=/icons/plus.svg, AppName=MPMS}"
                               Width="14" Height="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Добавить" Foreground="White"
                                   FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Таблица категорий -->
        <Border Grid.Row="2" Background="White" CornerRadius="8"
                BorderBrush="#DFE1E6" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Заголовок -->
                <Border Grid.Row="0" Background="#F4F5F7" CornerRadius="8,8,0,0"
                        BorderBrush="#DFE1E6" BorderThickness="0,0,0,1" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="67"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Название" Style="{StaticResource ThCell}"/>
                        <TextBlock Grid.Column="1" Text="Действия" Style="{StaticResource ThCell}"/>
                    </Grid>
                </Border>
                <!-- Строки -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredMaterialCategories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:LocalMaterialCategory}">
                            <Border Padding="16,10"
                                    BorderBrush="#F4F5F7" BorderThickness="0,0,0,1"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="CategoryRow_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#FAFBFC"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Название -->
                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                               FontSize="13" FontWeight="SemiBold" Foreground="#000000"
                                               VerticalAlignment="Center"/>

                                    <!-- Действия -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Style="{StaticResource RowIconBtn}" ToolTip="Просмотр"
                                                Command="{Binding DataContext.ViewMaterialCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Image Source="{svgc:SvgImage Source=/icons/eye.svg, AppName=MPMS}" Width="14" Height="14"/>
                                        </Button>
                                        <Button Style="{StaticResource RowIconBtn}" ToolTip="Редактировать"
                                                Command="{Binding DataContext.EditMaterialCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Image Source="{svgc:SvgImage Source=/icons/editing.svg, AppName=MPMS}" Width="14" Height="14"/>
                                        </Button>
                                        <Button Style="{StaticResource RowIconBtn}" ToolTip="Удалить"
                                                Command="{Binding DataContext.DeleteMaterialCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Image Source="{svgc:SvgImage Source=/icons/trash.svg, AppName=MPMS}" Width="14" Height="14"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
