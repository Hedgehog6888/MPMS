<UserControl x:Class="MPMS.Views.Components.ProjectSummaryReceiptControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MPMS.ViewModels">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#DFE1E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="ReceiptRow" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditable}" Value="True">
                    <Setter Property="Cursor" Value="Hand"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsEditable}" Value="True"/>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#F8F9FA"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="ReceiptRowTemplate" DataType="{x:Type vm:ReceiptRowVm}">
            <Border Style="{StaticResource ReceiptRow}"
                    Tag="{Binding}"
                    MouseLeftButtonUp="ReceiptRow_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                               SizeChanged="ReceiptName_SizeChanged"/>
                    <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat={}{0:N2}}" HorizontalAlignment="Right"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding EffectiveUnitPrice, StringFormat={}{0:N2} ₽}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding BaseUnitPrice, StringFormat={}{0:N2} ₽}"
                                   TextDecorations="Strikethrough"
                                   Foreground="#8993A4" FontSize="11"
                                   Visibility="{Binding HasPriceOverride, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding AdjustmentLabel}" HorizontalAlignment="Right" Foreground="#6B778C"/>
                    <TextBlock Grid.Column="4" Text="{Binding AdjustedTotal, StringFormat={}{0:N2} ₽}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Виды работ" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="{Binding ProjectSummaryReceiptServicesGroupButtonText}"
                            Command="{Binding ToggleProjectSummaryReceiptServicesGroupingCommand}"
                            Style="{StaticResource OutlineBtn}"
                            Padding="10,4" Height="28" FontSize="11"
                            Visibility="{Binding ProjectSummaryReceiptShowGroupToggle, Converter={StaticResource BoolToVis}}"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch">
                    <ItemsControl ItemsSource="{Binding ProjectSummaryFilteredServiceSections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProjectSummaryReceiptStageSectionVm}">
                                <StackPanel Margin="0,0,0,4">
                                    <StackPanel Visibility="{Binding ShowStageHeader, Converter={StaticResource BoolToVis}}" Margin="0,10,0,6">
                                        <Border Height="1" Background="#DFE1E6" Margin="0,0,0,8"
                                                Visibility="{Binding ShowStageDivider, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding StageName}" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding ServiceRows}"
                                                  ItemTemplate="{StaticResource ReceiptRowTemplate}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <Border Height="1" Background="#EBECF0" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Итого виды работ"/>
                        <TextBlock Grid.Column="1" Text="{Binding ProjectSummaryFilteredAdjustedServicesTotal, StringFormat={}{0:N2} ₽}" FontWeight="Bold"/>
                    </Grid>
                    <TextBlock Text="{Binding ProjectSummaryFilteredServicesSubtotal, StringFormat='Без корректировки: {0:N2} ₽'}"
                               FontSize="10" Foreground="#94A3B8" Margin="0,4,0,0"
                               Visibility="{Binding ProjectSummaryFilteredHasServiceAdjustment, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Материалы" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Content="{Binding ProjectSummaryReceiptMaterialsGroupButtonText}"
                            Command="{Binding ToggleProjectSummaryReceiptMaterialsGroupingCommand}"
                            Style="{StaticResource OutlineBtn}"
                            Padding="10,4" Height="28" FontSize="11"
                            Visibility="{Binding ProjectSummaryReceiptShowGroupToggle, Converter={StaticResource BoolToVis}}"/>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch">
                    <ItemsControl ItemsSource="{Binding ProjectSummaryFilteredMaterialSections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProjectSummaryReceiptStageSectionVm}">
                                <StackPanel Margin="0,0,0,4">
                                    <StackPanel Visibility="{Binding ShowStageHeader, Converter={StaticResource BoolToVis}}" Margin="0,10,0,6">
                                        <Border Height="1" Background="#DFE1E6" Margin="0,0,0,8"
                                                Visibility="{Binding ShowStageDivider, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding StageName}" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding MaterialRows}"
                                                  ItemTemplate="{StaticResource ReceiptRowTemplate}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <Border Height="1" Background="#EBECF0" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Итого материалы"/>
                        <TextBlock Grid.Column="1" Text="{Binding ProjectSummaryFilteredAdjustedMaterialsTotal, StringFormat={}{0:N2} ₽}" FontWeight="Bold"/>
                    </Grid>
                    <TextBlock Text="{Binding ProjectSummaryFilteredMaterialsSubtotal, StringFormat='Без корректировки: {0:N2} ₽'}"
                               FontSize="10" Foreground="#94A3B8" Margin="0,4,0,0"
                               Visibility="{Binding ProjectSummaryFilteredHasMaterialAdjustment, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <Border Grid.Row="3" Background="#F8F9FA" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Итого по выборке" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding ProjectSummaryFilteredGrandTotal, StringFormat={}{0:N2} ₽}" FontSize="22" FontWeight="Bold"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
