<UserControl x:Class="MPMS.Views.Components.StageWorkTypesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MPMS.ViewModels"
             xmlns:models="clr-namespace:MPMS.Models">
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#DFE1E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="StageMiniInputBox" TargetType="TextBox">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D0D4DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="CaretBrush" Value="#111111"/>
            <Setter Property="SelectionBrush" Value="{StaticResource NeutralSelectionBrush}"/>
            <Setter Property="SelectionTextBrush" Value="#111111"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#111111"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#111111"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StageMoneyLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#8993A4"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style x:Key="StageMoneyValue" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style x:Key="StageTotalValue" TargetType="TextBlock" BasedOn="{StaticResource StageMoneyValue}">
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid Visibility="{Binding IsStageCatalogEditable, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Каталог видов работ" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" x:Name="SearchBorder"
                                Background="#F4F5F7" CornerRadius="6"
                                Padding="10,0" Height="36"
                                BorderThickness="1.5" BorderBrush="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE721;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="#6B778C"/>
                                <Grid Grid.Column="1">
                                    <TextBlock Text="Поиск по названию, описанию, артикулу..."
                                               Foreground="#6B778C" FontSize="12"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ServiceSearchText}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox Text="{Binding ServiceSearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0"
                                             VerticalAlignment="Center" FontSize="13"
                                             Foreground="#000000"
                                             GotFocus="Search_GotFocus"
                                             LostFocus="Search_LostFocus"/>
                                </Grid>
                                <Button Grid.Column="2"
                                        Visibility="{Binding ServiceSearchText, Converter={StaticResource StringToVis}}"
                                        Style="{StaticResource IconButton}"
                                        Click="ClearSearch_Click">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="11" Foreground="#6B778C"/>
                                </Button>
                            </Grid>
                        </Border>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding ServiceCategoryOptions}" SelectedItem="{Binding ServiceCategoryFilter}" Style="{StaticResource FormCombo}"/>
                    </Grid>
                    <Border Grid.Row="2" Background="White" BorderBrush="#DFE1E6" BorderThickness="1" CornerRadius="8">
                        <ScrollViewer><ItemsControl ItemsSource="{Binding ServiceCatalogFiltered}"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type models:LocalWorkTypeTemplate}"><Border Padding="10,8" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock FontSize="11" Foreground="#6B778C"><Run Text="{Binding CategoryName}"/><Run Text=" · "/><Run Text="{Binding BasePrice, StringFormat={}{0:N2} ₽}"/></TextBlock></StackPanel><Button Grid.Column="1" Content="Добавить" Style="{StaticResource BlackBtn}" Padding="12,4" Tag="{Binding}" Click="AddWorkTypeTemplate_Click"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Виды работ в этапе" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding SelectedServices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:StageWorkTypeLineVm}">
                                    <Border Background="#FAFBFC" BorderBrush="#DFE1E6" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="96"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="−" Width="30" Height="30" Tag="{Binding}" Click="DecWorkTypeQty_Click" Style="{StaticResource OutlineBtn}" Padding="0"/>
                                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StageMiniInputBox}" Margin="6,0"/>
                                                <Button Content="+" Width="30" Height="30" Tag="{Binding}" Click="IncWorkTypeQty_Click" Style="{StaticResource OutlineBtn}" Padding="0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" ToolTipService.ShowDuration="60000"><TextBlock.ToolTip><ToolTip Style="{StaticResource ProgramToolTip}" Content="{Binding Name}"/></TextBlock.ToolTip></TextBlock></StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="Цена" Style="{StaticResource StageMoneyLabel}"/><TextBlock Text="{Binding PricePerUnit, StringFormat={}{0:N2} ₽}" Style="{StaticResource StageMoneyValue}"/></StackPanel>
                                            <StackPanel Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="Итого" Style="{StaticResource StageMoneyLabel}"/><TextBlock Text="{Binding LineTotal, StringFormat={}{0:N2} ₽}" Style="{StaticResource StageTotalValue}"/></StackPanel>
                                            <Button Grid.Column="4" Content="Удалить" Style="{StaticResource OutlineBtn}" Margin="12,0,0,0" Padding="10,4" VerticalAlignment="Center" Command="{Binding DataContext.RemoveServiceLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Style="{StaticResource Card}"
                Visibility="{Binding IsStageCatalogReadOnly, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="Виды работ в этапе" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Border Grid.Row="1" x:Name="ReadOnlySearchBorder"
                        Background="#F4F5F7" CornerRadius="6"
                        Padding="10,0" Height="36" Margin="0,0,0,10"
                        BorderThickness="1.5" BorderBrush="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="#6B778C"/>
                        <Grid Grid.Column="1">
                            <TextBlock Text="Поиск по названию..."
                                       Foreground="#6B778C" FontSize="12"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ServiceSearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox Text="{Binding ServiceSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     VerticalAlignment="Center" FontSize="13"
                                     Foreground="#000000"
                                     GotFocus="ReadOnlySearch_GotFocus"
                                     LostFocus="ReadOnlySearch_LostFocus"/>
                        </Grid>
                        <Button Grid.Column="2"
                                Visibility="{Binding ServiceSearchText, Converter={StaticResource StringToVis}}"
                                Style="{StaticResource IconButton}"
                                Click="ReadOnlyClearSearch_Click">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="11" Foreground="#6B778C"/>
                        </Button>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="2">
                    <ItemsControl ItemsSource="{Binding SelectedServicesFiltered}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StageWorkTypeLineVm}">
                                <Border Background="#FAFBFC" BorderBrush="#DFE1E6" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="96"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#F4F5F7" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Quantity, StringFormat={}{0:N2}}" FontWeight="SemiBold"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" ToolTipService.ShowDuration="60000">
                                                <TextBlock.ToolTip>
                                                    <ToolTip Style="{StaticResource ProgramToolTip}" Content="{Binding Name}"/>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="Цена" Style="{StaticResource StageMoneyLabel}"/>
                                            <TextBlock Text="{Binding PricePerUnit, StringFormat={}{0:N2} ₽}" Style="{StaticResource StageMoneyValue}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Итого" Style="{StaticResource StageMoneyLabel}"/>
                                            <TextBlock Text="{Binding LineTotal, StringFormat={}{0:N2} ₽}" Style="{StaticResource StageTotalValue}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
