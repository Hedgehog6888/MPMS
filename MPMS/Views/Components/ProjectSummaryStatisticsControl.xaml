<UserControl x:Class="MPMS.Views.Components.ProjectSummaryStatisticsControl" x:Name="RootControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MPMS.ViewModels"
             xmlns:ctrl="clr-namespace:MPMS.Controls"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             xmlns:infra="clr-namespace:MPMS.Infrastructure">
    <UserControl.Resources>
        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#DFE1E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <infra:BreakpointToDoubleConverter x:Key="BreakpointToDouble"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.5*"/>
            <ColumnDefinition Width="0.5*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource SummaryCard}" Margin="0,0,0,12" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Итого по проекту" FontSize="10" Foreground="#64748B" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding ProjectSummaryGrandTotal, StringFormat='{}{0:N0} ₽'}"
                                   FontSize="18" FontWeight="Bold" Foreground="#111111"/>
                        <TextBlock Text="{Binding ProjectSummarySubtotal, StringFormat='Без корректировки: {0:N0} ₽'}"
                                   FontSize="9" Foreground="#94A3B8" Margin="0,3,0,0"
                                   Visibility="{Binding ProjectSummaryHasAdjustment, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Background="#EBECF0" Margin="16,0"/>

                    <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <Border Width="6" Height="6" CornerRadius="3" Background="#3B82F6" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Виды работ" FontSize="10" Foreground="#64748B"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ProjectSummaryAdjustedServicesTotal, StringFormat='{}{0:N0} ₽'}"
                                   FontSize="16" FontWeight="Bold" Foreground="#111111"/>
                        <TextBlock Text="{Binding ProjectSummaryServicesSubtotal, StringFormat='Без корректировки: {0:N0} ₽'}"
                                   FontSize="9" Foreground="#94A3B8" Margin="0,3,0,0"
                                   Visibility="{Binding ProjectSummaryHasServiceAdjustment, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <Border Grid.Column="3" Width="1" Background="#EBECF0" Margin="16,0"/>

                    <StackPanel Grid.Column="4">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <Border Width="6" Height="6" CornerRadius="3" Background="#10B981" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Материалы" FontSize="10" Foreground="#64748B"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ProjectSummaryAdjustedMaterialsTotal, StringFormat='{}{0:N0} ₽'}"
                                   FontSize="16" FontWeight="Bold" Foreground="#111111"/>
                        <TextBlock Text="{Binding ProjectSummaryMaterialsSubtotal, StringFormat='Без корректировки: {0:N0} ₽'}"
                                   FontSize="9" Foreground="#94A3B8" Margin="0,3,0,0"
                                   Visibility="{Binding ProjectSummaryHasMaterialAdjustment, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource SummaryCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="По задачам и этапам" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="1" Text="Суммы с учётом наценок и скидок каждого этапа"
                               FontSize="10" Foreground="#64748B" Margin="0,0,0,10"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ProjectSummaryTaskGroups}" Grid.IsSharedSizeScope="True">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ProjectSummaryTaskGroupVm}">
                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,10"
                                            BorderBrush="#EBEEF2" BorderThickness="1">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding TaskName}" FontSize="13" FontWeight="SemiBold" Foreground="#111111"/>
                                                    <TextBlock FontSize="10" Foreground="#64748B" Margin="0,2,0,0">
                                                        <Run Text="{Binding StagesWithPricingCount, Mode=OneWay}"/>
                                                        <Run Text=" из "/>
                                                        <Run Text="{Binding StagesCount, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding AdjustedGrandTotal, StringFormat='{}{0:N0} ₽'}"
                                                           FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Stages}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ProjectSummaryStageRowVm}">
                                                        <Border Background="White" CornerRadius="6" Padding="12,10" Margin="0,0,0,6"
                                                                BorderBrush="#EBEEF2" BorderThickness="1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="2*" MinWidth="120"/>
                                                                    <ColumnDefinition Width="1.2*" MinWidth="100"/>
                                                                    <ColumnDefinition Width="1.2*" MinWidth="100"/>
                                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Total"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                                    <TextBlock Text="{Binding StageName}" FontWeight="SemiBold" FontSize="12"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <Border CornerRadius="4" Padding="6,2" Margin="0,4,0,0"
                                                                            Background="{Binding Status, Converter={StaticResource StageStatusToBrush}}"
                                                                            HorizontalAlignment="Left">
                                                                        <TextBlock Text="{Binding Status, Converter={StaticResource StageStatusToString}}"
                                                                                   FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                                    <TextBlock FontSize="10" Foreground="#64748B" Text="Виды работ"/>
                                                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#111111" Margin="0,2,0,0"
                                                                               Text="{Binding AdjustedServicesTotal, StringFormat='{}{0:N0} ₽'}">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="FontSize" Value="13"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasServiceAdjustment}" Value="True">
                                                                                        <Setter Property="FontSize" Value="11"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock Text="{Binding ServiceAdjustmentLabel}" FontSize="9" Foreground="#94A3B8" Margin="0,1,0,0"
                                                                               Visibility="{Binding HasServiceAdjustment, Converter={StaticResource BoolToVis}}"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                                                    <TextBlock FontSize="10" Foreground="#64748B" Text="Материалы"/>
                                                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#111111" Margin="0,2,0,0"
                                                                               Text="{Binding AdjustedMaterialsTotal, StringFormat='{}{0:N0} ₽'}">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="FontSize" Value="13"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasMaterialAdjustment}" Value="True">
                                                                                        <Setter Property="FontSize" Value="11"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock Text="{Binding MaterialAdjustmentLabel}" FontSize="9" Foreground="#94A3B8" Margin="0,1,0,0"
                                                                               Visibility="{Binding HasMaterialAdjustment, Converter={StaticResource BoolToVis}}"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="3" Margin="0,0,8,0" HorizontalAlignment="Right">
                                                                    <TextBlock FontSize="10" Foreground="#64748B" Text="Сумма" Margin="0,0,0,2" TextAlignment="Right"/>
                                                                    <TextBlock FontSize="16" FontWeight="Bold" Foreground="#111111"
                                                                               Text="{Binding AdjustedGrandTotal, StringFormat='{}{0:N0} ₽'}" TextAlignment="Right"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Column="1" Margin="8,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Donut Chart: Budget by Stage Status -->
            <Border Grid.Row="0" Style="{StaticResource SummaryCard}" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Распределение бюджета по статусам этапов" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Grid x:Name="TopStatusChartLayout" Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="120" MaxWidth="320"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Donut Chart -->
                        <Viewbox Grid.Column="0" Margin="0,0,16,0" Stretch="Uniform" StretchDirection="DownOnly"
                                 MinWidth="120" MinHeight="120">
                            <Grid Width="240" Height="240">
                                <ctrl:DonutChart Segments="{Binding BudgetByStageStatusSegments}"
                                                 InnerRadiusRatio="0.6"/>
                                <!-- Center text with total budget -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Всего" FontSize="12" Foreground="#64748B" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding ProjectSummaryGrandTotal, StringFormat='{}{0:N0} ₽'}"
                                               FontSize="18" FontWeight="Bold" Foreground="#111111" TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Viewbox>

                        <!-- Legend -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="Завершено" FontSize="11" Foreground="#111111"/>
                                    <TextBlock FontSize="10" Foreground="#64748B">
                                        <Run Text="{Binding BudgetByStageStatusSegments[0].Value, StringFormat='{}{0:N0} ₽'}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#3B82F6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="В работе" FontSize="11" Foreground="#111111"/>
                                    <TextBlock FontSize="10" Foreground="#64748B">
                                        <Run Text="{Binding BudgetByStageStatusSegments[1].Value, StringFormat='{}{0:N0} ₽'}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="5" Background="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <StackPanel>
                                    <TextBlock Text="Запланировано" FontSize="11" Foreground="#111111"/>
                                    <TextBlock FontSize="10" Foreground="#64748B">
                                        <Run Text="{Binding BudgetByStageStatusSegments[2].Value, StringFormat='{}{0:N0} ₽'}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Pie Chart: Work Type Distribution -->
            <Border Grid.Row="1" Style="{StaticResource SummaryCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Распределение по категориям видов работ" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="180" MaxWidth="380"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Pie Chart -->
                        <Viewbox Grid.Column="0" Margin="0,0,16,0" Stretch="Uniform" StretchDirection="DownOnly"
                                 MinWidth="120" MinHeight="120">
                            <Grid Width="240" Height="240">
                                <ctrl:DonutChart Segments="{Binding WorkTypeDistributionSegments}"
                                                 InnerRadiusRatio="0"/>
                            </Grid>
                        </Viewbox>

                        <!-- Legend -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding WorkTypeDistributionSegments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border Width="10" Height="10" CornerRadius="5"
                                                    Background="{Binding ColorHex}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#111111"/>
                                                <TextBlock FontSize="10" Foreground="#64748B">
                                                    <Run Text="{Binding Value, StringFormat='{}{0:N0} ₽'}"/>
                                                    <Run Text=" • "/>
                                                    <Run Text="{Binding Percentage, StringFormat='{}{0:N1}%'}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

