<UserControl x:Class="MPMS.Views.Components.ProjectSummaryStatisticsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MPMS.ViewModels">
    <UserControl.Resources>
        <Style x:Key="SummaryCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#DFE1E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,16">
            <Border Style="{StaticResource SummaryCard}" Margin="0,0,0,16" Padding="18,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Итого по проекту" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ProjectSummaryGrandTotal, StringFormat='{}{0:N0} ₽'}"
                                   FontSize="24" FontWeight="Bold" Foreground="#111111"/>
                        <TextBlock FontSize="10" Foreground="#94A3B8" Margin="0,4,0,0">
                            <Run Text="{Binding ProjectSummaryStagesWithPricingCount, Mode=OneWay}"/>
                            <Run Text=" этапов с составом"/>
                        </TextBlock>
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Background="#EBECF0" Margin="20,0"/>

                    <StackPanel Grid.Column="2">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#3B82F6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Виды работ" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ProjectSummaryAdjustedServicesTotal, StringFormat='{}{0:N0} ₽'}"
                                   FontSize="20" FontWeight="Bold" Foreground="#111111"/>
                        <TextBlock Text="{Binding ProjectSummaryServicesSubtotal, StringFormat='Без корректировки: {0:N0} ₽'}"
                                   FontSize="10" Foreground="#94A3B8" Margin="0,4,0,0"
                                   Visibility="{Binding ProjectSummaryHasServiceAdjustment, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <Border Grid.Column="3" Width="1" Background="#EBECF0" Margin="20,0"/>

                    <StackPanel Grid.Column="4">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Материалы" FontSize="11" Foreground="#64748B"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ProjectSummaryAdjustedMaterialsTotal, StringFormat='{}{0:N0} ₽'}"
                                   FontSize="20" FontWeight="Bold" Foreground="#111111"/>
                        <TextBlock Text="{Binding ProjectSummaryMaterialsSubtotal, StringFormat='Без корректировки: {0:N0} ₽'}"
                                   FontSize="10" Foreground="#94A3B8" Margin="0,4,0,0"
                                   Visibility="{Binding ProjectSummaryHasMaterialAdjustment, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource SummaryCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="По задачам и этапам" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Grid.Row="1" Text="Суммы с учётом наценок и скидок каждого этапа"
                               FontSize="11" Foreground="#64748B" Margin="0,0,0,12"/>
                    <ScrollViewer Grid.Row="2" MaxHeight="640" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ProjectSummaryTaskGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ProjectSummaryTaskGroupVm}">
                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,10"
                                            BorderBrush="#EBEEF2" BorderThickness="1">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding TaskName}" FontSize="13" FontWeight="SemiBold" Foreground="#111111"/>
                                                    <TextBlock FontSize="10" Foreground="#64748B" Margin="0,2,0,0">
                                                        <Run Text="{Binding StagesWithPricingCount, Mode=OneWay}"/>
                                                        <Run Text=" из "/>
                                                        <Run Text="{Binding StagesCount, Mode=OneWay}"/>
                                                        <Run Text=" этапов с составом"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding AdjustedGrandTotal, StringFormat='{}{0:N0} ₽'}"
                                                           FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Stages}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ProjectSummaryStageRowVm}">
                                                        <Border Background="White" CornerRadius="6" Padding="10,8" Margin="0,0,0,6"
                                                                BorderBrush="#EBEEF2" BorderThickness="1">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding StageName}" FontWeight="SemiBold" FontSize="12"
                                                                               VerticalAlignment="Center"/>
                                                                    <Border Grid.Column="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                                                            Background="{Binding Status, Converter={StaticResource StageStatusToBrush}}"
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Status, Converter={StaticResource StageStatusToString}}"
                                                                                   FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                                                    </Border>
                                                                    <TextBlock Grid.Column="2"
                                                                               Text="{Binding AdjustedGrandTotal, StringFormat='{}{0:N0} ₽'}"
                                                                               FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                                                </Grid>
                                                                <Grid Grid.Row="1" Margin="0,6,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                                        <TextBlock FontSize="10" Foreground="#64748B"
                                                                                   Text="{Binding AdjustedServicesTotal, StringFormat='Работы: {0:N0} ₽'}"/>
                                                                        <TextBlock Text="{Binding ServiceAdjustmentLabel}" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"
                                                                                   Visibility="{Binding HasServiceAdjustment, Converter={StaticResource BoolToVis}}"/>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1">
                                                                        <TextBlock FontSize="10" Foreground="#64748B"
                                                                                   Text="{Binding AdjustedMaterialsTotal, StringFormat='Материалы: {0:N0} ₽'}"/>
                                                                        <TextBlock Text="{Binding MaterialAdjustmentLabel}" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"
                                                                                   Visibility="{Binding HasMaterialAdjustment, Converter={StaticResource BoolToVis}}"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
