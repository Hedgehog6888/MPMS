<UserControl x:Class="MPMS.Views.Components.MainSidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:MPMS.ViewModels"
             xmlns:controls="clr-namespace:MPMS.Controls"
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    
    <UserControl.Resources>
        <ControlTemplate x:Key="SidebarSlimProgressBar" TargetType="ProgressBar">
            <Grid x:Name="ProgressRoot" SnapsToDevicePixels="True">
                <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                <Border x:Name="PART_Track" Background="Transparent" CornerRadius="4"/>
                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                        CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Stretch"/>
            </Grid>
        </ControlTemplate>

        <!-- Стиль кнопки навигации (светлая тема, белая боковая панель) -->
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Background"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"     Value="#000000"/>
            <Setter Property="FontSize"       Value="14"/>
            <Setter Property="FontWeight"     Value="SemiBold"/>
            <Setter Property="Padding"        Value="0"/>
            <Setter Property="Height"         Value="46"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="GroupName"      Value="Navigation"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg"
                                Background="Transparent"
                                CornerRadius="6"
                                Margin="8,2"
                                Padding="0">
                            <ContentPresenter VerticalAlignment="Center"
                                              Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F4F5F7"/>
                                <Setter Property="Foreground" Value="#000000"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F4F5F7"/>
                                <Setter Property="Foreground" Value="#000000"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="White"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,16,0,0">
            <!-- Главная -->
            <RadioButton IsChecked="{Binding CurrentPage, Converter={StaticResource EqualityToBool}, ConverterParameter=Home, Mode=OneWay}"
                         Style="{StaticResource NavButton}"
                         Command="{Binding NavigateCommand}"
                         CommandParameter="Home">
                <StackPanel Orientation="Horizontal">
                    <Image Width="20" Height="20"
                           Margin="12,0,8,0"
                           VerticalAlignment="Center"
                           Source="{svgc:SvgImage Source=/icons/pathHouse.svg, AppName=MPMS}">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Opacity" Value="0.7"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                        <Setter Property="Margin" Value="22,0,0,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <TextBlock Text="Главная"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </RadioButton>

            <!-- Проекты (скрыт для Работника) -->
            <RadioButton IsChecked="{Binding CurrentPage, Converter={StaticResource EqualityToBool}, ConverterParameter=Projects, Mode=OneWay}"
                         Style="{StaticResource NavButton}"
                         Command="{Binding NavigateCommand}"
                         CommandParameter="Projects"
                         Visibility="{Binding IsProjectsVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <Image Width="20" Height="20"
                           Margin="12,0,8,0"
                           VerticalAlignment="Center"
                           Source="{svgc:SvgImage Source=/icons/project.svg, AppName=MPMS}">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Opacity" Value="0.7"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                        <Setter Property="Margin" Value="22,0,0,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <TextBlock Text="Проекты"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </RadioButton>

            <!-- Задачи -->
            <RadioButton IsChecked="{Binding CurrentPage, Converter={StaticResource EqualityToBool}, ConverterParameter=Tasks, Mode=OneWay}"
                         Style="{StaticResource NavButton}"
                         Command="{Binding NavigateCommand}"
                         CommandParameter="Tasks">
                <StackPanel Orientation="Horizontal">
                    <Image Width="20" Height="20"
                           Margin="12,0,8,0"
                           VerticalAlignment="Center"
                           Source="{svgc:SvgImage Source=/icons/tasks.svg, AppName=MPMS}">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Opacity" Value="0.7"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                        <Setter Property="Margin" Value="22,0,0,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <TextBlock Text="Задачи"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </RadioButton>

            <!-- Этапы -->
            <RadioButton IsChecked="{Binding CurrentPage, Converter={StaticResource EqualityToBool}, ConverterParameter=Stages, Mode=OneWay}"
                         Style="{StaticResource NavButton}"
                         Command="{Binding NavigateCommand}"
                         CommandParameter="Stages">
                <StackPanel Orientation="Horizontal">
                    <Image Width="20" Height="20"
                           Margin="12,0,8,0"
                           VerticalAlignment="Center"
                           Source="{svgc:SvgImage Source=/icons/stages.svg, AppName=MPMS}">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Opacity" Value="0.7"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                        <Setter Property="Margin" Value="22,0,0,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <TextBlock Text="Этапы"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </RadioButton>


            <!-- Таймлайн -->
            <RadioButton IsChecked="{Binding CurrentPage, Converter={StaticResource EqualityToBool}, ConverterParameter=Timeline, Mode=OneWay}"
                         Style="{StaticResource NavButton}"
                         Command="{Binding NavigateCommand}"
                         CommandParameter="Timeline">
                <StackPanel Orientation="Horizontal">
                    <Image Width="20" Height="20"
                           Margin="12,0,8,0"
                           VerticalAlignment="Center"
                           Source="{svgc:SvgImage Source=/icons/timeline.svg, AppName=MPMS}">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Opacity" Value="0.7"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                        <Setter Property="Margin" Value="22,0,0,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <TextBlock Text="Таймлайн"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </RadioButton>

            <!-- Календарь -->
            <RadioButton IsChecked="{Binding CurrentPage, Converter={StaticResource EqualityToBool}, ConverterParameter=Calendar, Mode=OneWay}"
                         Style="{StaticResource NavButton}"
                         Command="{Binding NavigateCommand}"
                         CommandParameter="Calendar">
                <StackPanel Orientation="Horizontal">
                    <Image Width="20" Height="20"
                           Margin="12,0,8,0"
                           VerticalAlignment="Center"
                           Source="{svgc:SvgImage Source=/icons/calendar.svg, AppName=MPMS}">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Opacity" Value="0.7"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                        <Setter Property="Margin" Value="22,0,0,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <TextBlock Text="Календарь"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </RadioButton>

            <!-- Склад -->
            <RadioButton IsChecked="{Binding CurrentPage, Converter={StaticResource EqualityToBool}, ConverterParameter=Warehouse, Mode=OneWay}"
                         Style="{StaticResource NavButton}"
                         Command="{Binding NavigateCommand}"
                         CommandParameter="Warehouse">
                <StackPanel Orientation="Horizontal">
                    <Image Width="20" Height="20"
                           Margin="12,0,8,0"
                           VerticalAlignment="Center"
                           Source="{svgc:SvgImage Source=/icons/material.svg, AppName=MPMS}">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Opacity" Value="0.7"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                        <Setter Property="Margin" Value="22,0,0,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <TextBlock Text="Склад"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </RadioButton>

            <!-- Файлы -->
            <RadioButton IsChecked="{Binding CurrentPage, Converter={StaticResource EqualityToBool}, ConverterParameter=Files, Mode=OneWay}"
                         Style="{StaticResource NavButton}"
                         Command="{Binding NavigateCommand}"
                         CommandParameter="Files">
                <StackPanel Orientation="Horizontal">
                    <Image Width="20" Height="20"
                           Margin="12,0,8,0"
                           VerticalAlignment="Center"
                           Source="{svgc:SvgImage Source=/icons/files.svg, AppName=MPMS}">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Opacity" Value="0.7"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                        <Setter Property="Margin" Value="22,0,0,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <TextBlock Text="Файлы"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </RadioButton>

            <!-- Справочники (для Admin и Manager) -->
            <RadioButton IsChecked="{Binding CurrentPage, Converter={StaticResource EqualityToBool}, ConverterParameter=Catalogs, Mode=OneWay}"
                         Style="{StaticResource NavButton}"
                         Command="{Binding NavigateCommand}"
                         CommandParameter="Catalogs"
                         Visibility="{Binding IsCatalogsVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <Image Width="20" Height="20"
                           Margin="12,0,8,0"
                           VerticalAlignment="Center"
                           Source="{svgc:SvgImage Source=/icons/catalog.svg, AppName=MPMS}">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Opacity" Value="0.7"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                        <Setter Property="Margin" Value="22,0,0,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <TextBlock Text="Справочники"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </RadioButton>

            <!-- Администрирование (только для Administrator) -->
            <RadioButton IsChecked="{Binding CurrentPage, Converter={StaticResource EqualityToBool}, ConverterParameter=Admin, Mode=OneWay}"
                         Style="{StaticResource NavButton}"
                         Command="{Binding NavigateCommand}"
                         CommandParameter="Admin"
                         Visibility="{Binding IsAdminPanelVisible, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <Image Width="20" Height="20"
                           Margin="12,0,8,0"
                           VerticalAlignment="Center"
                           Source="{svgc:SvgImage Source=/icons/admin_gear.svg, AppName=MPMS}">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="Opacity" Value="0.7"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
                                        <Setter Property="Margin" Value="22,0,0,0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <TextBlock Text="Администрирование"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <!-- ── Нижняя панель (ширина как у кнопок навигации: Margin 8,2) ── -->
        <Border Grid.Row="1"
                DataContext="{Binding SidebarFooter}"
                Margin="8,2,8,12"
                Background="White"
                CornerRadius="6"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Padding="0,6"
                SnapsToDevicePixels="True">

            <StackPanel>
            <!-- Статистика -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatsMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <!-- Развёрнутый sidebar: три категории -->
                <Grid Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding StatsImages}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                                   Text="Изображения"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding StatsDocuments}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                                   Text="Документы"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding StatsReports}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                                   Text="Отчёты"/>
                    </StackPanel>
                </Grid>
                <!-- Узкий sidebar: общее количество -->
                <StackPanel Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisInv}}">
                    <TextBlock Text="{Binding StatsTotalFiles}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Файлы" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Загрузка -->
            <StackPanel HorizontalAlignment="Stretch">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUploadingMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <!-- Развёрнутый: текст + линейный прогресс -->
                <StackPanel Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding UploadProgressTitle}" FontSize="12" FontWeight="SemiBold"
                               Foreground="#000000"
                               Margin="8,0,8,4" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding UploadCurrentFileNameDisplay}" FontSize="10"
                               Foreground="#000000"
                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="8,0,8,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSingleFileUpload}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ProgressBar Value="{Binding UploadProgressPercent}" Maximum="100" Height="8"
                                 Margin="10,0,10,0"
                                 HorizontalAlignment="Stretch"
                                 Background="#E9ECEF" Foreground="{StaticResource PrimaryBrush}"
                                 Template="{StaticResource SidebarSlimProgressBar}"/>
                </StackPanel>
                <!-- Узкий: круговой прогресс -->
                <controls:CircularProgressRing
                    HorizontalAlignment="Center"
                    RingSize="42"
                    StrokeThickness="4"
                    Value="{Binding UploadProgressPercent}"
                    ProgressBrush="{StaticResource PrimaryBrush}"
                    Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisInv}}">
                    <controls:CircularProgressRing.CenterContent>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UploadCompleted}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#000000" HorizontalAlignment="Center" LineHeight="12"/>
                            <TextBlock Text="из" FontSize="7" Foreground="#000000"
                                       HorizontalAlignment="Center" Margin="0,-1,0,-1"/>
                            <TextBlock Text="{Binding UploadTotal}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#000000" HorizontalAlignment="Center" LineHeight="12"/>
                        </StackPanel>
                    </controls:CircularProgressRing.CenterContent>
                </controls:CircularProgressRing>
            </StackPanel>

            <!-- Итог загрузки -->
            <StackPanel HorizontalAlignment="Stretch">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUploadSummaryMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <!-- Развёрнутый -->
                <StackPanel Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding UploadSummaryTitle}" FontSize="12" FontWeight="SemiBold"
                               Foreground="#000000" HorizontalAlignment="Center" Margin="8,0,8,4"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding UploadCurrentFileNameDisplay}" FontSize="10"
                               Foreground="#000000"
                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="8,0,8,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSingleFileUpload}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ProgressBar Value="100" Maximum="100" Height="8"
                                 Margin="10,0,10,0"
                                 HorizontalAlignment="Stretch"
                                 Background="#E9ECEF" Foreground="{StaticResource SuccessBrush}"
                                 Template="{StaticResource SidebarSlimProgressBar}"/>
                </StackPanel>
                <!-- Узкий -->
                <controls:CircularProgressRing
                    HorizontalAlignment="Center"
                    RingSize="42"
                    StrokeThickness="4"
                    Value="100"
                    ProgressBrush="{StaticResource SuccessBrush}"
                    Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisInv}}">
                    <controls:CircularProgressRing.CenterContent>
                        <TextBlock Text="{Binding UploadCompleted}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </controls:CircularProgressRing.CenterContent>
                </controls:CircularProgressRing>
            </StackPanel>

            <!-- Удаление -->
            <StackPanel HorizontalAlignment="Stretch">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDeletingMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <!-- Развёрнутый: текст + линейный прогресс (красный) -->
                <StackPanel Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding DeleteProgressTitle}" FontSize="12" FontWeight="SemiBold"
                               Foreground="#000000"
                               Margin="8,0,8,4" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding DeleteCurrentFileNameDisplay}" FontSize="10"
                               Foreground="#000000"
                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="8,0,8,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSingleFileDelete}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ProgressBar Value="{Binding DeleteProgressPercent}" Maximum="100" Height="8"
                                 Margin="10,0,10,0"
                                 HorizontalAlignment="Stretch"
                                 Background="#E9ECEF" Foreground="#DC2626"
                                 Template="{StaticResource SidebarSlimProgressBar}"/>
                </StackPanel>
                <!-- Узкий: круговой прогресс (красный) -->
                <controls:CircularProgressRing
                    HorizontalAlignment="Center"
                    RingSize="42"
                    StrokeThickness="4"
                    Value="{Binding DeleteProgressPercent}"
                    ProgressBrush="#DC2626"
                    Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisInv}}">
                    <controls:CircularProgressRing.CenterContent>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DeleteCompleted}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#000000" HorizontalAlignment="Center" LineHeight="12"/>
                            <TextBlock Text="из" FontSize="7" Foreground="#000000"
                                       HorizontalAlignment="Center" Margin="0,-1,0,-1"/>
                            <TextBlock Text="{Binding DeleteTotal}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#000000" HorizontalAlignment="Center" LineHeight="12"/>
                        </StackPanel>
                    </controls:CircularProgressRing.CenterContent>
                </controls:CircularProgressRing>
            </StackPanel>

            <!-- Итог удаления -->
            <StackPanel HorizontalAlignment="Stretch">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDeletionSummaryMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <!-- Развёрнутый -->
                <StackPanel Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding DeleteSummaryTitle}" FontSize="12" FontWeight="SemiBold"
                               Foreground="#000000" HorizontalAlignment="Center" Margin="8,0,8,4"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding DeleteCurrentFileNameDisplay}" FontSize="10"
                               Foreground="#000000"
                               TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="8,0,8,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSingleFileDelete}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ProgressBar Value="100" Maximum="100" Height="8"
                                 Margin="10,0,10,0"
                                 HorizontalAlignment="Stretch"
                                 Background="#E9ECEF" Foreground="#DC2626"
                                 Template="{StaticResource SidebarSlimProgressBar}"/>
                </StackPanel>
                <!-- Узкий -->
                <controls:CircularProgressRing
                    HorizontalAlignment="Center"
                    RingSize="42"
                    StrokeThickness="4"
                    Value="100"
                    ProgressBrush="#DC2626"
                    Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisInv}}">
                    <controls:CircularProgressRing.CenterContent>
                        <TextBlock Text="{Binding DeleteCompleted}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </controls:CircularProgressRing.CenterContent>
                </controls:CircularProgressRing>
            </StackPanel>

            <!-- Генерация отчёта -->
            <StackPanel HorizontalAlignment="Stretch">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGeneratingReportMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <!-- Развёрнутый: текст + линейный прогресс -->
                <StackPanel Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ReportGenerationTitle}" FontSize="12" FontWeight="SemiBold"
                               Foreground="#000000"
                               Margin="8,0,8,4" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <ProgressBar Value="{Binding ReportGenerationProgressPercent}" Maximum="100" Height="8"
                                 Margin="10,0,10,0"
                                 HorizontalAlignment="Stretch"
                                 Background="#E9ECEF" Foreground="{StaticResource PrimaryBrush}"
                                 Template="{StaticResource SidebarSlimProgressBar}"/>
                </StackPanel>
                <!-- Узкий: круговой прогресс -->
                <controls:CircularProgressRing
                    HorizontalAlignment="Center"
                    RingSize="42"
                    StrokeThickness="4"
                    Value="{Binding ReportGenerationProgressPercent}"
                    ProgressBrush="{StaticResource PrimaryBrush}"
                    Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisInv}}">
                    <controls:CircularProgressRing.CenterContent>
                        <Image Width="16" Height="16"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Source="{svgc:SvgImage Source=/icons/file.svg, AppName=MPMS}"/>
                    </controls:CircularProgressRing.CenterContent>
                </controls:CircularProgressRing>
            </StackPanel>

            <!-- Итог генерации отчёта -->
            <StackPanel HorizontalAlignment="Stretch">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsReportSummaryMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <!-- Развёрнутый -->
                <StackPanel Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ReportGenerationTitle}" FontSize="12" FontWeight="SemiBold"
                               Foreground="#000000" HorizontalAlignment="Center" Margin="8,0,8,4"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <ProgressBar Value="100" Maximum="100" Height="8"
                                 Margin="10,0,10,0"
                                 HorizontalAlignment="Stretch"
                                 Background="#E9ECEF" Foreground="{StaticResource SuccessBrush}"
                                 Template="{StaticResource SidebarSlimProgressBar}"/>
                </StackPanel>
                <!-- Узкий -->
                <controls:CircularProgressRing
                    HorizontalAlignment="Center"
                    RingSize="42"
                    StrokeThickness="4"
                    Value="100"
                    ProgressBrush="{StaticResource SuccessBrush}"
                    Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisInv}}">
                    <controls:CircularProgressRing.CenterContent>
                        <Image Width="18" Height="18"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Source="{svgc:SvgImage Source=/icons/check_black.svg, AppName=MPMS}"/>
                    </controls:CircularProgressRing.CenterContent>
                </controls:CircularProgressRing>
            </StackPanel>
            </StackPanel>
        </Border>

        </Grid>
    </Border>
</UserControl>
