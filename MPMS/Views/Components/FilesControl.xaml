<UserControl x:Class="MPMS.Views.Components.FilesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:svgc="http://sharpvectors.codeplex.com/svgc/"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:viewmodels="clr-namespace:MPMS.ViewModels"
             xmlns:controls="clr-namespace:MPMS.Controls"
             xmlns:infrastructure="clr-namespace:MPMS.Infrastructure"
             xmlns:local="clr-namespace:MPMS.Views.Components"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewmodels:FilesControlViewModel, IsDesignTimeCreatable=False}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <infrastructure:FileSizeConverter x:Key="FileSizeConverter" />
        <infrastructure:BoolToVisibilityConverter x:Key="BoolToVis" />
        <infrastructure:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True" />
        <infrastructure:FileTypeToIsDocumentConverter x:Key="FileTypeToIsDocument" />
        <infrastructure:NullToVisibilityConverter x:Key="NullToVis" />
        <infrastructure:FileNameToReportVisibilityConverter x:Key="FileNameToReportVisibility" />

        <!-- Стиль премиум всплывающей подсказки -->
        <Style x:Key="PremiumTooltip" TargetType="ToolTip">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DFE1E6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TooltipHeaderSection" TargetType="Border">
            <Setter Property="CornerRadius" Value="10,10,0,0"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>

        <Style x:Key="FileTooltipHeaderSection" TargetType="Border" BasedOn="{StaticResource TooltipHeaderSection}">
            <Setter Property="Background" Value="{Binding FileName, Converter={StaticResource FileExtensionToBackgroundBrush}}"/>
        </Style>

        <Style x:Key="TooltipHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="FileTooltipHeader" TargetType="TextBlock" BasedOn="{StaticResource TooltipHeader}">
            <Setter Property="Foreground" Value="{Binding FileName, Converter={StaticResource FileExtensionToForegroundBrush}}"/>
        </Style>

        <Style x:Key="TooltipContentSection" TargetType="Border">
            <Setter Property="Padding" Value="16,12"/>
        </Style>

        <Style x:Key="TooltipInfoRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>

        <Style x:Key="TooltipLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6B778C"/>
            <Setter Property="Width" Value="80"/>
        </Style>

        <Style x:Key="TooltipValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#172B4D"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="FileSelectionCheckStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Path x:Name="CheckMark"
                                      Data="M6 14L11 19L20 8"
                                      Stroke="White"
                                      StrokeThickness="2.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform"
                                      Width="14"
                                      Height="14"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#111111"/>
                                <Setter TargetName="Bg" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#111111"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#111111"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
                
        <!-- Стиль круглой кнопки удаления, появляющейся при наведении -->
        <Style x:Key="CircularDeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Opacity="0.95">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.12" Direction="270"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EBECF0"/>
                                <Setter TargetName="Bg" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль круглой кнопки скачивания, появляющейся при наведении -->
        <Style x:Key="CircularDownloadButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Opacity="0.95">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.12" Direction="270"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EBECF0"/>
                                <Setter TargetName="Bg" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль круглой кнопки просмотра, появляющейся при наведении -->
        <Style x:Key="CircularViewButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Opacity="0.95">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.12" Direction="270"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#EBECF0"/>
                                <Setter TargetName="Bg" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True"/>
                        <Condition Binding="{Binding FileName, Converter={StaticResource FileTypeToIsDocument}}" Value="Visible"/>
                        <Condition Binding="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль элементов списка в FilesControl, имитирующий стиль WarehouseRow -->
        <Style x:Key="FileListItemStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderBrush" Value="#DFE1E6"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8F9FA"/>
                    <Setter Property="BorderBrush" Value="#111111"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Шаблон для карточек изображений -->
        <DataTemplate x:Key="ImageCardTemplate">
            <Border Width="160" Height="180" Background="White" CornerRadius="8" Margin="0,0,6,6"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Cursor="Hand">
                <Border.ToolTip>
                    <ToolTip Style="{StaticResource PremiumTooltip}" MaxWidth="300">
                        <StackPanel>
                            <Border Style="{StaticResource FileTooltipHeaderSection}">
                                <TextBlock Text="{Binding FileName}" Style="{StaticResource FileTooltipHeader}"/>
                            </Border>
                            <Border Style="{StaticResource TooltipContentSection}">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource TooltipInfoRow}" Visibility="{Binding FileName, Converter={StaticResource FileNameToReportVisibility}}">
                                        <Border Padding="4,1" CornerRadius="3" Background="#7C3AED">
                                            <TextBlock Text="Отчёт" FontSize="9" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource TooltipInfoRow}">
                                        <TextBlock Text="Размер:" Style="{StaticResource TooltipLabel}"/>
                                        <TextBlock Text="{Binding FileSize, Converter={StaticResource FileSizeConverter}}" Style="{StaticResource TooltipValue}"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource TooltipInfoRow}">
                                        <TextBlock Text="Тип:" Style="{StaticResource TooltipLabel}"/>
                                        <TextBlock Text="{Binding FileType, StringFormat='{}\{0\}'}" Style="{StaticResource TooltipValue}"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource TooltipInfoRow}" Visibility="{Binding ProjectName, Converter={StaticResource NullToVis}}">
                                        <TextBlock Text="Проект:" Style="{StaticResource TooltipLabel}"/>
                                        <TextBlock Text="{Binding ProjectName}" Style="{StaticResource TooltipValue}"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource TooltipInfoRow}" Visibility="{Binding StageName, Converter={StaticResource NullToVis}}">
                                        <TextBlock Text="Этап:" Style="{StaticResource TooltipLabel}"/>
                                        <TextBlock Text="{Binding StageName}" Style="{StaticResource TooltipValue}"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource TooltipInfoRow}">
                                        <TextBlock Text="Загружен:" Style="{StaticResource TooltipLabel}"/>
                                        <TextBlock Text="{Binding UploadedByName}" Style="{StaticResource TooltipValue}"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource TooltipInfoRow}">
                                        <TextBlock Text="Изменен:" Style="{StaticResource TooltipLabel}"/>
                                        <TextBlock Text="{Binding LastModifiedLocally, Converter={StaticResource UtcToLocalDateTime}, StringFormat=dd.MM.yyyy HH\:mm}" Style="{StaticResource TooltipValue}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ToolTip>
                </Border.ToolTip>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenPhotoViewerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="120"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Область предпросмотра файла -->
                    <Border Grid.Row="0" CornerRadius="8,8,0,0" SnapsToDevicePixels="True"
                            Background="{Binding FileName, Converter={StaticResource FileExtensionToBackgroundBrush}}">
                        <Grid UseLayoutRounding="True">
                            <Viewbox Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6">
                                <Viewbox.Style>
                                    <Style TargetType="Viewbox">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FileName, Converter={StaticResource FileTypeToIsImage}}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Thumbnail, Converter={StaticResource NullToVisInv}}" Value="Visible">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Viewbox.Style>
                                <Canvas Width="24" Height="24">
                                    <Path Stroke="{Binding FileName, Converter={StaticResource FileExtensionToForegroundBrush}}" 
                                          StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/>
                                    <Path Stroke="{Binding FileName, Converter={StaticResource FileExtensionToForegroundBrush}}" 
                                          StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M14 2v4a2 2 0 0 0 2 2h4"/>
                                </Canvas>
                            </Viewbox>

                            <Border CornerRadius="8,8,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding FileName, Converter={StaticResource FileTypeToIsImage}}" Value="True"/>
                                                    <Condition Binding="{Binding Thumbnail, Converter={StaticResource NullToVis}}" Value="Visible"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Thumbnail}"
                                                Stretch="UniformToFill"
                                                RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border.Background>
                            </Border>
                            
                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12" Padding="6,2" CornerRadius="4"
                                    Background="{Binding FileName, Converter={StaticResource FileExtensionToForegroundBrush}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FileName, Converter={StaticResource FileTypeToIsImage}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding FileName, Converter={StaticResource FileExtensionToShortLabel}}" 
                                           FontSize="10" FontWeight="Bold" Foreground="White" TextAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <!-- Наложение действий (видимо при наведении) -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Margin="6">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Style="{StaticResource FileSelectionCheckStyle}"
                                      Margin="0"/>

                        <Button ToolTip="Просмотр"
                                Command="{Binding DataContext.OpenDocumentViewerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Style="{StaticResource CircularViewButtonStyle}"
                                Margin="0,0,6,0">
                            <Image Source="{svgc:SvgImage Source=/icons/view.svg, AppName=MPMS}" Width="14" Height="14" Opacity="0.8"/>
                        </Button>

                        <Button ToolTip="Скачать"
                                Command="{Binding DataContext.DownloadFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Margin="0,0,6,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CircularDownloadButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Image Source="{svgc:SvgImage Source=/icons/download.svg, AppName=MPMS}" Width="14" Height="14" Opacity="0.8"/>
                        </Button>

                        <Button ToolTip="Удалить"
                                Command="{Binding DataContext.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CircularDeleteButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DataContext.IsWorkerRole, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DataContext.IsForemanRole, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Image Source="{svgc:SvgImage Source=/icons/trash.svg, AppName=MPMS}" Width="14" Height="14" Opacity="0.8"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="8,6">
                        <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding FileSize, Converter={StaticResource FileSizeConverter}}" 
                                   FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding ProjectName, StringFormat=П: \{0\}}" FontSize="10" Foreground="#0052CC" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding ProjectName, Converter={StaticResource NullToVis}}"/>
                        <TextBlock Text="{Binding StageName, StringFormat=Э: \{0\}}" FontSize="10" Foreground="#00875A" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding StageName, Converter={StaticResource NullToVis}}"/>
                        <TextBlock Text="{Binding LastModifiedLocally, Converter={StaticResource UtcToLocalDateTime}, StringFormat=Изменен: dd.MM.yyyy HH\:mm}" 
                                   FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Шаблон для списка документов -->
        <DataTemplate x:Key="DocumentListTemplate">
            <Border Style="{StaticResource FileListItemStyle}">
                <Border.ToolTip>
                    <ToolTip Style="{StaticResource PremiumTooltip}" MaxWidth="300">
                        <StackPanel>
                            <Border Style="{StaticResource FileTooltipHeaderSection}">
                                <TextBlock Text="{Binding FileName}" Style="{StaticResource FileTooltipHeader}"/>
                            </Border>
                            <Border Style="{StaticResource TooltipContentSection}">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource TooltipInfoRow}" Visibility="{Binding FileName, Converter={StaticResource FileNameToReportVisibility}}">
                                        <Border Padding="4,1" CornerRadius="3" Background="#7C3AED">
                                            <TextBlock Text="Отчёт" FontSize="9" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource TooltipInfoRow}">
                                        <TextBlock Text="Размер:" Style="{StaticResource TooltipLabel}"/>
                                        <TextBlock Text="{Binding FileSize, Converter={StaticResource FileSizeConverter}}" Style="{StaticResource TooltipValue}"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource TooltipInfoRow}">
                                        <TextBlock Text="Тип:" Style="{StaticResource TooltipLabel}"/>
                                        <TextBlock Text="{Binding FileType, StringFormat='{}\{0\}'}" Style="{StaticResource TooltipValue}"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource TooltipInfoRow}" Visibility="{Binding ProjectName, Converter={StaticResource NullToVis}}">
                                        <TextBlock Text="Проект:" Style="{StaticResource TooltipLabel}"/>
                                        <TextBlock Text="{Binding ProjectName}" Style="{StaticResource TooltipValue}"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource TooltipInfoRow}" Visibility="{Binding StageName, Converter={StaticResource NullToVis}}">
                                        <TextBlock Text="Этап:" Style="{StaticResource TooltipLabel}"/>
                                        <TextBlock Text="{Binding StageName}" Style="{StaticResource TooltipValue}"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource TooltipInfoRow}">
                                        <TextBlock Text="Загружен:" Style="{StaticResource TooltipLabel}"/>
                                        <TextBlock Text="{Binding UploadedByName}" Style="{StaticResource TooltipValue}"/>
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource TooltipInfoRow}">
                                        <TextBlock Text="Изменен:" Style="{StaticResource TooltipLabel}"/>
                                        <TextBlock Text="{Binding LastModifiedLocally, Converter={StaticResource UtcToLocalDateTime}, StringFormat=dd.MM.yyyy HH\:mm}" Style="{StaticResource TooltipValue}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ToolTip>
                </Border.ToolTip>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenFromListCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Margin="0,0,16,0"
                            Background="{Binding FileName, Converter={StaticResource FileExtensionToBackgroundBrush}}">
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="{Binding FileName, Converter={StaticResource FileExtensionToForegroundBrush}}" 
                                      StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/>
                                <Path Stroke="{Binding FileName, Converter={StaticResource FileExtensionToForegroundBrush}}" 
                                      StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M14 2v4a2 2 0 0 0 2 2h4"/>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Padding="5,2" CornerRadius="4" Background="#7C3AED"
                                    Visibility="{Binding FileName, Converter={StaticResource FileNameToReportVisibility}}">
                                <TextBlock Text="Отчёт" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                            <TextBlock Text="{Binding FileName}" FontSize="15" FontWeight="SemiBold" 
                                       Foreground="#000000" TextTrimming="CharacterEllipsis" Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding UploadedByName}" FontSize="13" Foreground="#6B778C"/>
                            <TextBlock Text=" • " FontSize="13" Foreground="#6B778C"/>
                            <TextBlock Text="{Binding LastModifiedLocally, Converter={StaticResource UtcToLocalDateTime}, StringFormat=dd.MM.yyyy HH\:mm}" 
                                       FontSize="13" Foreground="#6B778C"/>
                            <TextBlock Text=" • " FontSize="13" Foreground="#6B778C" Visibility="{Binding ProjectName, Converter={StaticResource NullToVis}}"/>
                            <TextBlock Text="{Binding ProjectName, StringFormat=Проект: \{0\}}" FontSize="13" Foreground="#0052CC" Visibility="{Binding ProjectName, Converter={StaticResource NullToVis}}"/>
                            <TextBlock Text=" • " FontSize="13" Foreground="#6B778C" Visibility="{Binding StageName, Converter={StaticResource NullToVis}}"/>
                            <TextBlock Text="{Binding StageName, StringFormat=Этап: \{0\}}" FontSize="13" Foreground="#00875A" Visibility="{Binding StageName, Converter={StaticResource NullToVis}}"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <TextBlock Grid.Column="2" Text="{Binding FileSize, Converter={StaticResource FileSizeConverter}}" FontSize="13" Foreground="#6B778C"
                               VerticalAlignment="Center" Margin="0,0,24,0"/>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsSelectionMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button ToolTip="Просмотр"
                                Command="{Binding DataContext.OpenDocumentViewerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Margin="0,0,8,0"
                                Width="28">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FileName, Converter={StaticResource FileTypeToIsDocument}}" Value="Visible">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Setter Property="IsEnabled" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Image Source="{svgc:SvgImage Source=/icons/view.svg, AppName=MPMS}"
                                   Width="14" Height="14"
                                   VerticalAlignment="Center" Opacity="0.9"/>
                        </Button>

                        <Button ToolTip="Скачать"
                                Command="{Binding DataContext.DownloadFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                Style="{StaticResource IconButton}"
                                Margin="0,0,8,0">
                            <Image Source="{svgc:SvgImage Source=/icons/download.svg, AppName=MPMS}"
                                   Width="14" Height="14"
                                   VerticalAlignment="Center" Opacity="0.9"/>
                        </Button>

                        <Button ToolTip="Удалить"
                                Command="{Binding DataContext.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DangerIconButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsWorkerRole, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DataContext.IsForemanRole, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Image Source="{svgc:SvgImage Source=/icons/trash.svg, AppName=MPMS}"
                                   Width="14" Height="14"
                                   VerticalAlignment="Center" Opacity="0.9"/>
                        </Button>
                    </StackPanel>

                    <ToggleButton Grid.Column="3"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  Style="{StaticResource FileSelectionCheckStyle}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="FilesViewModeRadioStyle" TargetType="RadioButton" BasedOn="{StaticResource ViewToggleButton}">
            <Setter Property="GroupName" Value="FilesViewMode"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType=local:FilesControl}}" Value="{x:Static local:FilesControlLayoutMode.ScrollOnly}">
                    <Setter Property="GroupName" Value="FilesViewModeInactive"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ═══ Виртуализированный список файлов ═══ -->
        <!-- Контейнер элемента без выделения/чрома -->
        <Style x:Key="FilesListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.ViewMode, RelativeSource={RelativeSource AncestorType=local:FilesControl}}" Value="Grid">
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Виртуализированный ListBox: список (VirtualizingStackPanel) или плитка (VirtualizingWrapPanel) -->
        <Style x:Key="FilesListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,0,16,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Visible"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Page"/>
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource FilesListBoxItemStyle}"/>
            <!-- По умолчанию — вид "Список" -->
            <Setter Property="ItemTemplate" Value="{StaticResource DocumentListTemplate}"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ViewMode}" Value="Grid">
                    <Setter Property="ItemTemplate" Value="{StaticResource ImageCardTemplate}"/>
                    <Setter Property="ItemsPanel">
                        <Setter.Value>
                            <ItemsPanelTemplate>
                                <vwp:VirtualizingWrapPanel Orientation="Horizontal"
                                                           SpacingMode="None"
                                                           StretchItems="False"/>
                            </ItemsPanelTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ═══ Скелетоны загрузки ═══ -->
        <!-- Пульсирующий серый блок-заглушка -->
        <Style x:Key="SkeletonBlock" TargetType="Border">
            <Setter Property="Background" Value="#E9EDF2"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0.5" To="1" Duration="0:0:0.85"
                                             AutoReverse="True" RepeatBehavior="Forever"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- Источник для повторения заглушек -->
        <x:Array x:Key="SkeletonItems" Type="{x:Type sys:Int32}">
            <sys:Int32>0</sys:Int32>
            <sys:Int32>1</sys:Int32>
            <sys:Int32>2</sys:Int32>
            <sys:Int32>3</sys:Int32>
            <sys:Int32>4</sys:Int32>
            <sys:Int32>5</sys:Int32>
            <sys:Int32>6</sys:Int32>
            <sys:Int32>7</sys:Int32>
            <sys:Int32>8</sys:Int32>
            <sys:Int32>9</sys:Int32>
            <sys:Int32>10</sys:Int32>
            <sys:Int32>11</sys:Int32>
        </x:Array>

        <!-- Заглушка карточки (вид "Плитка") -->
        <DataTemplate x:Key="SkeletonCardTemplate">
            <Border Width="160" Height="180" Background="White" CornerRadius="8" Margin="0,0,6,6"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="120"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" CornerRadius="8,8,0,0" Style="{StaticResource SkeletonBlock}"/>
                    <StackPanel Grid.Row="1" Margin="8,10">
                        <Border Height="11" Width="120" CornerRadius="5" HorizontalAlignment="Left"
                                Style="{StaticResource SkeletonBlock}"/>
                        <Border Height="9" Width="64" CornerRadius="4" HorizontalAlignment="Left"
                                Margin="0,8,0,0" Style="{StaticResource SkeletonBlock}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Заглушка строки (вид "Список") -->
        <DataTemplate x:Key="SkeletonRowTemplate">
            <Border Background="White" CornerRadius="8" Margin="0,0,0,6" Padding="16,12"
                    BorderBrush="#DFE1E6" BorderThickness="1.5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Margin="0,0,16,0"
                            Style="{StaticResource SkeletonBlock}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Border Height="13" Width="220" CornerRadius="6" HorizontalAlignment="Left"
                                Style="{StaticResource SkeletonBlock}"/>
                        <Border Height="11" Width="150" CornerRadius="5" HorizontalAlignment="Left"
                                Margin="0,8,0,0" Style="{StaticResource SkeletonBlock}"/>
                    </StackPanel>
                    <Border Grid.Column="2" Width="60" Height="11" CornerRadius="5"
                            VerticalAlignment="Center" Margin="0,0,24,0"
                            Style="{StaticResource SkeletonBlock}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Скелетон вида "Плитка" -->
        <DataTemplate x:Key="GridSkeletonTemplate">
            <ItemsControl ItemsSource="{StaticResource SkeletonItems}" ItemTemplate="{StaticResource SkeletonCardTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <!-- Скелетон вида "Список" -->
        <DataTemplate x:Key="ListSkeletonTemplate">
            <ItemsControl ItemsSource="{StaticResource SkeletonItems}" ItemTemplate="{StaticResource SkeletonRowTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Вкладки и переключатель представления ── -->
        <Grid Grid.Row="0" Background="Transparent">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Margin" Value="0,0,0,16"/>
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType=local:FilesControl}}" Value="{x:Static local:FilesControlLayoutMode.ScrollOnly}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType=local:FilesControl}}" Value="{x:Static local:FilesControlLayoutMode.TabsOnly}">
                            <Setter Property="Margin" Value="0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- TabBar: Изображения / Документы -->
            <controls:TabBarControl Grid.Column="0"
                                    SelectedTab="{Binding CurrentTab, Mode=TwoWay}"
                                    GroupName="FilesTabs">
                <controls:TabBarControl.Tabs>
                    <controls:TabItemModel Text="Изображения" Tag="Images"/>
                    <controls:TabItemModel Text="Документы"   Tag="Documents"/>
                </controls:TabBarControl.Tabs>
            </controls:TabBarControl>

            <Button Grid.Column="1"
                    Content="{Binding ToggleDisplayedSelectionText}"
                    Command="{Binding ToggleDisplayedSelectionCommand}"
                    Height="36"
                    Padding="14,0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource OutlineBtn}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelectionMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- Переключатель режима представления (Список / Плитка) -->
            <Border Grid.Column="2" Background="White"
                    BorderBrush="#DFE1E6" BorderThickness="1"
                    CornerRadius="8" Padding="4,4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Tag="List" Style="{StaticResource FilesViewModeRadioStyle}"
                                 IsChecked="{Binding ViewMode, Mode=TwoWay, Converter={StaticResource StringMatchToBoolConverter}, ConverterParameter=List}"
                                 ToolTip="Список">
                        <Grid Width="20" Height="20">
                            <Image Width="18" Height="18" Source="{svgc:SvgImage Source=/icons/list.svg, AppName=MPMS}">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <Image Width="18" Height="18" Source="{svgc:SvgImage Source=/icons/list_white.svg, AppName=MPMS}">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </Grid>
                    </RadioButton>
                    <RadioButton Tag="Grid" Style="{StaticResource FilesViewModeRadioStyle}"
                                 IsChecked="{Binding ViewMode, Mode=TwoWay, Converter={StaticResource StringMatchToBoolConverter}, ConverterParameter=Grid}"
                                 ToolTip="Плитка">
                        <Grid Width="20" Height="20">
                            <Image Width="18" Height="18" Source="{svgc:SvgImage Source=/icons/kanban.svg, AppName=MPMS}">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <Image Width="18" Height="18" Source="{svgc:SvgImage Source=/icons/kanban_white.svg, AppName=MPMS}">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                        </Grid>
                    </RadioButton>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── Область содержимого ── -->
        <Grid Grid.Row="1" ClipToBounds="True">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType=local:FilesControl}}" Value="{x:Static local:FilesControlLayoutMode.TabsOnly}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Панель поиска (над списком) ── -->
            <controls:SearchFilterBarControl
                Grid.Row="0"
                x:Name="FilesSearchBar"
                IsFloating="True"
                HorizontalAlignment="Stretch"
                Margin="0,0,24,12"
                SearchText="{Binding SearchText, Mode=TwoWay}"
                Placeholder="Поиск по названию файла...">
                <controls:SearchFilterBarControl.Filters>
                    <StackPanel Orientation="Horizontal">
                        <!-- Фильтр проектов -->
                        <ComboBox ItemsSource="{Binding ProjectFilterOptions}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding ProjectFilter}"
                                  Visibility="{Binding IsProjectFilterVisible, Converter={StaticResource BoolToVis}}"
                                  Style="{StaticResource FormCombo}"
                                  Width="180" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <!-- Фильтр расширений -->
                        <ComboBox ItemsSource="{Binding ExtensionFilterOptions}"
                                   SelectedItem="{Binding ExtensionFilter}"
                                   Style="{StaticResource FormCombo}"
                                   Width="160" VerticalAlignment="Center"/>
                    </StackPanel>
                </controls:SearchFilterBarControl.Filters>
            </controls:SearchFilterBarControl>

            <!-- ── Область списков ── -->
            <Grid Grid.Row="1">
            <!-- Изображения (виртуализированный список) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentTab}" Value="Documents">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <ListBox x:Name="ImagesList"
                         ItemsSource="{Binding DisplayedFiles}"
                         Style="{StaticResource FilesListBoxStyle}"/>

                <!-- Пустое состояние (изображения) -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding CurrentTab}" Value="Images"/>
                                        <Condition Binding="{Binding DisplayedFiles.Count}" Value="0"/>
                                        <Condition Binding="{Binding IsLoading}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Image Source="{svgc:SvgImage Source=/icons/empty_images.svg, AppName=MPMS}"
                           Width="48" Height="48" Opacity="0.1" Margin="0,0,0,16"/>
                    <TextBlock Text="Изображения не найдены"
                               FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Загрузите первое изображение"
                               FontSize="12" Foreground="#64748B" TextAlignment="Center"
                               Margin="0,8,0,0" LineHeight="18">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.Project.IsClosed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <!-- Документы (виртуализированный список) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentTab}" Value="Documents">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <ListBox x:Name="DocumentsList"
                         ItemsSource="{Binding DisplayedFiles}"
                         Style="{StaticResource FilesListBoxStyle}"/>

                <!-- Пустое состояние (документы) -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding CurrentTab}" Value="Documents"/>
                                        <Condition Binding="{Binding DisplayedFiles.Count}" Value="0"/>
                                        <Condition Binding="{Binding IsLoading}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Image Source="{svgc:SvgImage Source=/icons/empty_documents.svg, AppName=MPMS}"
                           Width="48" Height="48" Opacity="0.1" Margin="0,0,0,16"/>
                    <TextBlock Text="Документы не найдены"
                               FontSize="15" FontWeight="SemiBold" Foreground="#0F172A"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Загрузите первый документ"
                               FontSize="12" Foreground="#64748B" TextAlignment="Center"
                               Margin="0,8,0,0" LineHeight="18">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.Project.IsClosed, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <!-- ── Скелетон первой загрузки ── -->
            <ContentControl x:Name="LoadingSkeleton"
                            IsHitTestVisible="False"
                            Panel.ZIndex="2"
                            VerticalAlignment="Top"
                            Margin="0,0,16,0"
                            Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="ContentTemplate" Value="{StaticResource GridSkeletonTemplate}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewMode}" Value="List">
                                <Setter Property="ContentTemplate" Value="{StaticResource ListSkeletonTemplate}"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsLoading}" Value="True"/>
                                    <Condition Binding="{Binding IsFirstLoad}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            </Grid>
        </Grid>

    </Grid>
